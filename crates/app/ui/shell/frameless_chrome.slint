import { State, Actions } from "../state.slint";

// Frameless window chrome active ONLY in Windowed Immersive mode
// (`State.immersive-player-open && !State.immersive-fullscreen`).
// Renders a 1px outer border (when unmaximized), a hover-revealed translucent
// overlay title bar at the top edge, and perimeter resize hit zones.
export component FramelessWindowChrome inherits Rectangle {
    background: transparent;

    property <bool> bar-active: trigger-ta.has-hover
        || drag-ta.has-hover
        || min-ta.has-hover
        || max-ta.has-hover
        || close-ta.has-hover;

    // Subtle 1px border so the frameless window remains cleanly defined on dark desktops.
    if !State.window-maximized : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        border-width: 1px;
        border-color: #ffffff26;
    }

    // Visual overlay title bar (non-hit-tested layer so fade/slide animations
    // never block clicks on the underlying NOW PLAYING fullscreen / Close buttons).
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 36px;
        clip: true;

        Rectangle {
            x: 0px;
            y: root.bar-active ? 0px : -36px;
            width: 100%;
            height: 36px;
            opacity: root.bar-active ? 1.0 : 0.0;
            background: #101210eb;

            animate y { duration: 150ms; easing: ease-out; }
            animate opacity { duration: 150ms; easing: ease-out; }

            // Bottom hairline divider for clear separation when hovered
            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: #ffffff24;
            }

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: 14px;
                padding-right: 0px;
                spacing: 0px;

                // Track / window title in the draggable area
                HorizontalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    spacing: 10px;
                    padding-right: 12px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/MusicPlayer-dark.png");
                            width: 16px;
                            height: 16px;
                            image-fit: ImageFit.contain;
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        text: State.current-title == "" ? "Music Player" : "\{State.current-title} — \{State.current-artist} · Music Player";
                        color: #f3f4f0e0;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Window controls: Minimize, Maximize/Restore, Close App
                HorizontalLayout {
                    spacing: 0px;

                    // Minimize
                    Rectangle {
                        width: 44px;
                        height: 35px;
                        background: min-ta.has-hover ? #ffffff1e : transparent;
                        animate background { duration: 120ms; }
                        Rectangle {
                            width: 10px;
                            height: 1px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            background: #f3f4f0;
                        }
                    }

                    // Maximize / Restore
                    Rectangle {
                        width: 44px;
                        height: 35px;
                        background: max-ta.has-hover ? #ffffff1e : transparent;
                        animate background { duration: 120ms; }

                        if !State.window-maximized : Rectangle {
                            width: 10px;
                            height: 10px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-width: 1px;
                            border-color: #f3f4f0;
                            border-radius: 1px;
                            background: transparent;
                        }

                        if State.window-maximized : Rectangle {
                            width: 11px;
                            height: 11px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            background: transparent;
                            Rectangle {
                                x: 3px;
                                y: 0px;
                                width: 8px;
                                height: 8px;
                                border-width: 1px;
                                border-color: #f3f4f0cc;
                                border-radius: 1px;
                                background: transparent;
                            }
                            Rectangle {
                                x: 0px;
                                y: 3px;
                                width: 8px;
                                height: 8px;
                                border-width: 1px;
                                border-color: #f3f4f0;
                                border-radius: 1px;
                                background: #101210;
                            }
                        }
                    }

                    // Close App (distinct red hover from the in-UI Close immersive pill)
                    Rectangle {
                        width: 46px;
                        height: 35px;
                        background: close-ta.has-hover ? #c42b1c : transparent;
                        animate background { duration: 120ms; }
                        Image {
                            source: @image-url("../../assets/icons/close.svg");
                            width: 12px;
                            height: 12px;
                            colorize: #ffffff;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }
    }

    // Top-edge hover trigger zone (9px inactive -> 36px active).
    // Height snaps immediately so pointer exit restores click access to underlying controls.
    hit-zone := Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.bar-active ? 36px : 9px;
        clip: true;

        trigger-ta := TouchArea {
            width: 100%;
            height: 100%;
        }

        HorizontalLayout {
            x: 0px;
            y: root.bar-active ? 0px : -40px;
            width: 100%;
            height: 36px;
            spacing: 0px;

            drag-ta := TouchArea {
                horizontal-stretch: 1;
                height: 36px;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        Actions.drag-window();
                    }
                }
            }

            min-ta := TouchArea {
                width: 44px;
                height: 36px;
                mouse-cursor: pointer;
                clicked => { Actions.minimize-window(); }
            }

            max-ta := TouchArea {
                width: 44px;
                height: 36px;
                mouse-cursor: pointer;
                clicked => { Actions.toggle-maximize-window(); }
            }

            close-ta := TouchArea {
                width: 46px;
                height: 36px;
                mouse-cursor: pointer;
                clicked => { Actions.close-window(); }
            }
        }
    }

    // Perimeter resize hit zones (active only when unmaximized in Windowed Immersive mode).
    if !State.window-maximized : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        // 4 edges (5px thick)
        TouchArea {
            x: 10px;
            y: 0px;
            width: max(0px, parent.width - 20px);
            height: 5px;
            mouse-cursor: ns-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    Actions.drag-resize-window("n");
                }
            }
        }
        TouchArea {
            x: 10px;
            y: parent.height - 5px;
            width: max(0px, parent.width - 20px);
            height: 5px;
            mouse-cursor: ns-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    Actions.drag-resize-window("s");
                }
            }
        }
        TouchArea {
            x: 0px;
            y: 10px;
            width: 5px;
            height: max(0px, parent.height - 20px);
            mouse-cursor: ew-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    Actions.drag-resize-window("w");
                }
            }
        }
        TouchArea {
            x: parent.width - 5px;
            y: 10px;
            width: 5px;
            height: max(0px, parent.height - 20px);
            mouse-cursor: ew-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    Actions.drag-resize-window("e");
                }
            }
        }

        // 4 corners (10x10px, layered above edges)
        TouchArea {
            x: 0px;
            y: 0px;
            width: 10px;
            height: 10px;
            mouse-cursor: nwse-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    Actions.drag-resize-window("nw");
                }
            }
        }
        TouchArea {
            x: parent.width - 10px;
            y: 0px;
            width: 10px;
            height: 10px;
            mouse-cursor: nesw-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    Actions.drag-resize-window("ne");
                }
            }
        }
        TouchArea {
            x: 0px;
            y: parent.height - 10px;
            width: 10px;
            height: 10px;
            mouse-cursor: nesw-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    Actions.drag-resize-window("sw");
                }
            }
        }
        TouchArea {
            x: parent.width - 10px;
            y: parent.height - 10px;
            width: 10px;
            height: 10px;
            mouse-cursor: nwse-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    Actions.drag-resize-window("se");
                }
            }
        }
    }
}
