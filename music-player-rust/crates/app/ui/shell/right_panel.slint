import { State, Actions } from "../state.slint";
import { QueueItem } from "../models.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { Palette, IcBtn, TextBtn, ActionBtn } from "../widgets.slint";

// ---- Right panel bits -----------------------------------------------------------
component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 34px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            color: Palette.muted-2;
            font-size: 9px;
        }
        Text {
            text: root.value;
            color: Palette.text-subtle;
            font-size: 11px;
            overflow: elide;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.border-soft;
    }
}

component QueueRow inherits Rectangle {
    in property <QueueItem> item;
    in property <int> index: 0;
    callback play();
    callback remove();

    height: 52px;
    border-radius: 6px;
    background: row-area.has-hover ? Palette.hover : (root.item.is-current ? Palette.raised : transparent);
    animate background { duration: 100ms; }

    row-area := TouchArea {
        clicked => { root.play(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                Actions.open-context-menu(root.item.id, round((root.absolute-position.x + row-area.mouse-x) / 1px), round((root.absolute-position.y + row-area.mouse-y) / 1px));
            }
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 9px;

        Rectangle {
            width: 38px;
            height: 38px;
            border-radius: 4px;
            clip: true;
            background: root.item.badge-bg;
            y: (parent.height - self.height) / 2;
            if root.item.has-cover : Image {
                source: root.item.cover;
                width: parent.width;
                height: parent.height;
                image-fit: ImageFit.cover;
            }
            if !root.item.has-cover : Text {
                text: root.item.initials;
                color: #ffffffd0;
                font-size: 13px;
                font-weight: 800;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                text: root.item.unavailable ? "\{root.item.title} (unavailable)" : root.item.title;
                color: root.item.is-current ? State.accent : (root.item.unavailable ? #ff5b74 : Palette.text-strong);
                font-size: 11px;
                font-weight: 650;
                overflow: elide;
            }
            if root.item.artist != "" : Text {
                text: root.item.artist;
                color: Palette.muted;
                font-size: 10px;
                overflow: elide;
            }
        }

        Rectangle {
            width: 30px;
            if row-area.has-hover : IcBtn {
                icon: @image-url("../../assets/icons/close.svg");
                icon-size: 12px;
                tint: Palette.muted-2;
                hover-tint: #ff5b74;
                width: 26px;
                height: 26px;
                clicked => { root.remove(); }
            }
        }
    }
}

component PanelTab inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();
    width: root.label == "Queue" ? 48px : 72px;
    height: 30px;
    Text {
        text: root.label;
        color: root.active ? Palette.text : Palette.muted;
        font-size: 10px;
        x: 2px;
        width: parent.width - 4px;
        vertical-alignment: center;
        horizontal-alignment: left;
    }
    Rectangle {
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: root.active ? State.accent : transparent;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// ---- Right panel ---------------------------------------------------------------
export component RightPanel inherits Rectangle {
    width: State.right-panel-open ? State.right-panel-width * 1px : 0px;
    background: Palette.surface;
    clip: true;

    // 1px left border matching original CSS
    Rectangle {
        x: 0px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: Palette.border;
    }

    if State.right-panel-open : VerticalLayout {
        padding-top: 16px;
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 8px;
        spacing: 0px;

        HorizontalLayout {
            height: 38px;
            Text {
                text: "Now playing";
                color: Palette.text;
                font-size: 13px;
                font-weight: 750;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IcBtn {
                icon: @image-url("../../assets/icons/close.svg");
                icon-size: 12px;
                clicked => { Actions.toggle-right-panel(); }
            }
        }

        if State.has-track : Rectangle {
            height: 18px;
        }
        if State.has-track : Rectangle {
            width: State.right-panel-width * 1px - 24px;
            height: self.width;
            border-radius: 7px;
            clip: true;
            background: Palette.panel-2;
            if State.current-has-cover : Image {
                source: State.current-cover;
                width: parent.width;
                height: parent.height;
                image-fit: ImageFit.cover;
            }
            if !State.current-has-cover : Text {
                text: State.current-initials;
                color: #ffffffcc;
                font-size: 42px;
                font-weight: 900;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        if State.has-track : Rectangle {
            height: 14px;
        }
        if State.has-track : HorizontalLayout {
            height: 48px;
            padding-left: 2px;
            padding-right: 2px;
            spacing: 8px;
            VerticalLayout {
                spacing: 4px;
                alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                Text {
                    text: State.current-title;
                    color: Palette.text;
                    font-size: 15px;
                    font-weight: 750;
                    letter-spacing: -0.25px;
                    overflow: elide;
                }
                Text {
                    text: State.current-album == "" ? State.current-artist : "\{State.current-artist} • \{State.current-album}";
                    color: Palette.muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }
            IcBtn {
                icon: State.current-favorite ? @image-url("../../assets/icons/heart-filled.svg") : @image-url("../../assets/icons/heart.svg");
                icon-size: 15px;
                tint: State.current-favorite ? State.accent : Palette.muted-2;
                clicked => { Actions.toggle-favorite(State.current-id); }
            }
        }
        if !State.has-track : VerticalLayout {
            padding-top: 60px;
            padding-bottom: 60px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 6px;
            alignment: center;
            Text {
                text: "Nothing playing";
                color: Palette.text;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "Choose a track to see details here.";
                color: Palette.muted;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
        Rectangle { height: 1px; background: Palette.border; }

        HorizontalLayout {
            height: 30px;
            Rectangle { width: 2px; background: transparent; }
            PanelTab {
                label: "Queue";
                active: State.right-panel-tab == "queue";
                clicked => { Actions.set-right-tab("queue"); }
            }
            PanelTab {
                label: "Track info";
                active: State.right-panel-tab == "info";
                clicked => { Actions.set-right-tab("info"); }
            }
        }
        Rectangle { height: 1px; background: Palette.border; }

        if State.right-panel-tab == "queue" : VerticalLayout {
            HorizontalLayout {
                height: 34px;
                Text {
                    text: "Next in queue (\{State.queue-count})";
                    color: #d8ddd8;
                    font-size: 11px;
                    font-weight: 800;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if State.queue-count > 0 : Rectangle {
                    width: 38px;
                    height: 22px;
                    border-radius: 4px;
                    background: clear-area.has-hover ? Palette.border-soft : transparent;
                    animate background { duration: 100ms; }
                    Text {
                        text: "Clear";
                        color: clear-area.has-hover ? Palette.text : Palette.muted;
                        font-size: 10px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    clear-area := TouchArea {
                        clicked => { Actions.clear-queue(); }
                    }
                }
            }
            if State.queue-count > 0 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    for row[index] in State.panel-queue-items : QueueRow {
                        item: row;
                        index: index;
                        play => { Actions.play-queue-entry(row.queue-index); }
                        remove => { Actions.queue-remove(row.queue-index); }
                    }
                    if State.queue-panel-more-count > 0 : Rectangle {
                        height: 32px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: more-text.preferred-width + 12px;
                                height: 20px;
                                border-radius: 4px;
                                background: more-area.has-hover ? #ffffff14 : transparent;
                                animate background { duration: 120ms; }
                                more-text := Text {
                                    text: "\{State.queue-panel-more-count} more in Queue";
                                    color: more-area.has-hover ? #ffffff : Palette.muted;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                                more-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { Actions.set-view("Queue", "", "", ""); }
                                }
                            }
                        }
                    }
                }
            }
            if State.queue-count <= 0 : Rectangle {
                vertical-stretch: 1;
                Text {
                    text: "No upcoming tracks.";
                    color: Palette.muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                    y: 24px;
                }
            }
        }

        if State.right-panel-tab == "info" : ScrollView {
            VerticalLayout {
                if State.has-track : VerticalLayout {
                    padding-top: 10px;
                    spacing: 0px;
                    Text {
                        text: "Track information";
                        color: Palette.text-subtle;
                        font-size: 11px;
                        font-weight: 800;
                    }
                    InfoRow { label: "Album"; value: State.info-album; }
                    InfoRow { label: "Album artist"; value: State.info-album-artist; }
                    InfoRow { label: "Year · Genre"; value: State.info-year-genre; }
                    InfoRow { label: "Audio format"; value: State.info-format; }
                    InfoRow { label: "Status"; value: State.info-status; }
                    InfoRow { label: "Audio quality"; value: State.info-quality; }
                    InfoRow { label: "Location"; value: State.info-location; }
                    VerticalLayout {
                        padding-top: 14px;
                        spacing: 8px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if State.info-album != "" : ActionBtn {
                                label: "Go to album";
                                clicked => { Actions.set-view("Album", "", State.info-album, ""); }
                            }
                            if State.info-album == "" && State.info-location != "" : ActionBtn {
                                label: "Go to folder";
                                clicked => { Actions.set-view("Folder", "", State.info-location, ""); }
                            }
                            ActionBtn {
                                label: "Track details";
                                clicked => { Actions.open-details(State.current-id); }
                            }
                        }
                        ActionBtn {
                            label: "Show in File Explorer";
                            clicked => { Actions.open-file-location(State.current-id); }
                        }
                    }
                }
            }
        }
    }
}
