import { State, Actions } from "../state.slint";
import { Palette, IcBtn, TextBtn, PlayerSlider } from "../widgets.slint";

export component ImmersivePlayerOverlay inherits Rectangle {
    property <bool> show-lyrics: State.immersive-lyrics-open && State.has-lyrics && State.lyrics-lines.length > 0;
    background: #10110f;
    animate background { duration: 400ms; easing: ease-in-out; }
    clip: true;

    if State.current-has-cover : Image {
        source: State.current-cover;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width * 1.15;
        height: parent.height * 1.15;
        image-fit: ImageFit.cover;
        opacity: 0.22;
    }
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, #10110f40 0%, #10110fe0 100%);
    }
    Rectangle {
        width: 100%;
        height: 100%;
        background: State.accent.with-alpha(0.04);
        animate background { duration: 400ms; easing: ease-in-out; }
    }

    overlay-hover := TouchArea {
        mouse-cursor: default;
    }

    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-top: 14px;
        padding-bottom: 22px;
        spacing: 12px;

        top-area := Rectangle {
            height: 48px;
            top-hover := TouchArea { }
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: "NOW PLAYING";
                    color: #ffffffb0;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 1.5px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 12px;
                    opacity: (overlay-hover.has-hover || top-hover.has-hover || fs-ta.has-hover || close-ta.has-hover) ? 1.0 : 0.0;
                    animate opacity { duration: 180ms; }

                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: fs-ta.has-hover ? #ffffff2a : #00000052;
                        animate background { duration: 150ms; }
                        fs-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Actions.toggle-immersive-fullscreen(); }
                        }
                        Image {
                            source: State.immersive-fullscreen ? @image-url("../../assets/icons/compress.svg") : @image-url("../../assets/icons/expand.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #ffffff;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    Rectangle {
                        width: close-row.preferred-width + 24px;
                        height: 36px;
                        border-radius: 18px;
                        background: close-ta.has-hover ? #ffffff2a : #00000052;
                        animate background { duration: 150ms; }
                        close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Actions.close-immersive-player(); }
                        }
                        close-row := HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 14px;
                            spacing: 8px;
                            alignment: center;
                            Image {
                                source: @image-url("../../assets/icons/close.svg");
                                width: 14px;
                                height: 14px;
                                colorize: #ffffff;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: "Close";
                                color: #ffffff;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding-left: 20px;
            padding-right: 20px;
            spacing: root.show-lyrics ? 40px : 0px;

            art-column := VerticalLayout {
                alignment: center;
                spacing: 16px;
                horizontal-stretch: 0;
                width: root.show-lyrics
                    ? clamp(State.window-height * 0.38 * 1px, 240px, 420px)
                    : clamp(State.window-height * 0.48 * 1px, 280px, 540px);

                Rectangle {
                    width: parent.width;
                    height: self.width;
                    border-radius: 16px;
                    clip: true;
                    background: State.current-badge-bg;
                    border-width: 1px;
                    border-color: #ffffff1c;
                    if State.current-has-cover : Image {
                        source: State.current-cover;
                        width: parent.width;
                        height: parent.height;
                        image-fit: ImageFit.cover;
                    }
                    if !State.current-has-cover : Text {
                        text: State.current-initials;
                        color: #ffffffcc;
                        font-size: 64px;
                        font-weight: 900;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                HorizontalLayout {
                    width: parent.width;
                    spacing: 12px;
                    alignment: center;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        spacing: 4px;
                        Text {
                            text: State.has-track ? State.current-title : "Nothing playing";
                            color: #ffffff;
                            font-size: 24px;
                            font-weight: 800;
                            letter-spacing: -0.5px;
                            overflow: elide;
                        }
                        Text {
                            text: State.has-track ? State.current-artist : "Choose a song from your library";
                            color: #ffffffb3;
                            font-size: 14px;
                            overflow: elide;
                        }
                    }

                    if State.has-track : IcBtn {
                        icon: State.current-favorite ? @image-url("../../assets/icons/heart-filled.svg") : @image-url("../../assets/icons/heart.svg");
                        tint: State.current-favorite ? State.accent : #ffffffb3;
                        icon-size: 20px;
                        width: 40px;
                        height: 40px;
                        clicked => {
                            State.current-favorite = !State.current-favorite;
                            Actions.toggle-favorite(State.current-id);
                        }
                    }
                }
            }

            if root.show-lyrics : VerticalLayout {
                horizontal-stretch: 1;
                min-width: 240px;
                height: 100%;
                spacing: 8px;
                HorizontalLayout {
                    height: 38px;
                    alignment: center;
                    Text {
                        text: State.lyrics-source == "sidecar" ? "Lyrics · Sidecar" : (State.lyrics-source == "embedded" ? "Lyrics · Embedded" : "Lyrics");
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 750;
                        letter-spacing: 0.1px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if State.lyrics-scroll-paused : TextBtn {
                        label: "Resume";
                        clicked => { Actions.lyrics-scroll-changed(false); }
                    }
                    IcBtn {
                        icon: @image-url("../../assets/icons/close.svg");
                        icon-size: 14px;
                        width: 32px;
                        height: 32px;
                        tint: #d0d2ce;
                        clicked => { Actions.toggle-immersive-lyrics(); }
                    }
                }
                lyrics-scroll-area := Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    Flickable {
                        content-y: State.lyrics-active-line < 0 ? 0px : min(0px, - State.lyrics-active-line * 44px + 120px);
                        animate content-y { duration: 250ms; easing: ease-out; }
                        VerticalLayout {
                            width: 100%;
                            padding-top: 140px;
                            padding-bottom: 220px;
                            spacing: 4px;
                            for line[index] in State.lyrics-lines : Rectangle {
                                border-radius: 8px;
                                background: line-ta.has-hover && State.lyrics-timed ? #ffffff18 : transparent;
                                animate background { duration: 120ms; }

                                line-ta := TouchArea {
                                    mouse-cursor: State.lyrics-timed ? pointer : default;
                                    clicked => { if (State.lyrics-timed && State.seek-from-lyrics) { Actions.seek-to-lyric(index); } }
                                }

                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    alignment: center;
                                    Text {
                                        width: 100%;
                                        text: line.text;
                                        color: line.is-active ? #ffffff : (line-ta.has-hover ? #ffffff : (line.is-past ? #a4a8a18c : #e3e4df8c));
                                        font-size: line.is-active ? 22px : 16px;
                                        font-weight: line.is-active ? 800 : 550;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                        animate color { duration: 120ms; }
                                    }
                                }
                            }
                            if State.lyrics-lines.length == 0 : Text {
                                text: "No lyrics loaded. Use the Lyrics view to search or edit this track.";
                                color: #d0d2ce;
                                font-size: 13px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 12px;
            alignment: center;
            width: 100%;

            VerticalLayout {
                width: 100%;
                spacing: 6px;
                HorizontalLayout {
                    Text { text: State.current-time; color: #ffffffb0; font-size: 12px; font-weight: 550; horizontal-stretch: 1; }
                    Text { text: State.total-time; color: #ffffffb0; font-size: 12px; font-weight: 550; horizontal-alignment: right; }
                }
                PlayerSlider {
                    commit-on-release: true;
                    minimum: 0.0;
                    maximum: 1.0;
                    value: State.progress;
                    fill-color: State.accent;
                    track-color: #ffffff30;
                    thumb-color: #ffffff;
                    preview(val) => { Actions.preview-seek-fraction(val); }
                    finished(val) => { Actions.seek-fraction(val); }
                    scrolled(event) => {
                        if (!State.has-track) { return reject; }
                        let delta = event.delta-y > 0px ? 5 : (event.delta-y < 0px ? -5 : 0);
                        if (delta != 0) {
                            Actions.seek-wheel(delta);
                            return accept;
                        }
                        reject
                    }
                }
            }

            HorizontalLayout {
                height: 70px;
                spacing: 36px;
                alignment: center;
                IcBtn {
                    icon: @image-url("../../assets/icons/skip-back.svg");
                    icon-size: 24px;
                    width: 48px;
                    height: 48px;
                    tint: #f3f4f0;
                    clicked => { Actions.previous(); }
                }
                Rectangle {
                    width: 70px;
                    height: 70px;
                    border-radius: 35px;
                    background: play-ta.has-hover ? #f0f0f0 : #ffffff;
                    animate background { duration: 120ms; }
                    Image {
                        source: State.is-playing ? @image-url("../../assets/icons/pause.svg") : @image-url("../../assets/icons/play.svg");
                        width: 28px;
                        height: 28px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: #161714;
                    }
                    play-ta := TouchArea { clicked => { Actions.toggle-play(); } }
                }
                IcBtn {
                    icon: @image-url("../../assets/icons/skip-forward.svg");
                    icon-size: 24px;
                    width: 48px;
                    height: 48px;
                    tint: #f3f4f0;
                    clicked => { Actions.next(); }
                }
            }

            HorizontalLayout {
                height: 44px;
                spacing: 30px;
                alignment: center;
                IcBtn {
                    icon: @image-url("../../assets/icons/equalizer.svg");
                    icon-size: 20px;
                    width: 44px;
                    height: 44px;
                    tint: #d0d2ce;
                    clicked => { Actions.toggle-immersive("Audio"); }
                }
                IcBtn {
                    icon: @image-url("../../assets/icons/lyrics.svg");
                    icon-size: 20px;
                    width: 44px;
                    height: 44px;
                    active: root.show-lyrics;
                    tint: root.show-lyrics ? #ffffff : #d0d2ce;
                    clicked => { Actions.toggle-immersive-lyrics(); }
                }
                IcBtn {
                    icon: @image-url("../../assets/icons/queue.svg");
                    icon-size: 20px;
                    width: 44px;
                    height: 44px;
                    tint: #d0d2ce;
                    clicked => { Actions.toggle-immersive("Queue"); }
                }
            }
        }
    }
}
