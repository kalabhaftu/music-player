// Shared view widgets: icons, track rows and tables, card grids, heroes.

import { State, Actions } from "state.slint";
import { TrackItem, GroupItem, QueueItem, PlaylistCardItem, HomeCardItem, LyricLineItem, TagFieldItem, ContextMenuItem, EqBandItem, DuplicateItem, DetailRowItem, BackupItem, LyricResultItem, GroupRowItem, PlaylistRowItem, FolderRootItem } from "models.slint";
import { ListView, ScrollView } from "std-widgets.slint";

// Gradient classes c1..c10 from the original components.css.
export global Palette {
    in property <float> background-opacity: State.transparent-window ? 1.0 - State.window-transparency * 0.01 : 1.0;
    in property <color> canvas: (State.artwork-palette ? State.art-background : (State.light-theme ? #f0f2ef : #070807)).with-alpha(background-opacity);
    in property <color> surface: (State.artwork-palette ? State.art-sidebar : (State.light-theme ? #e7eae6 : #090a09)).with-alpha(background-opacity);
    in property <color> main: (State.artwork-palette ? State.art-main : (State.light-theme ? #f0f2ef : #090a09)).with-alpha(background-opacity);
    in property <color> panel: (State.artwork-palette ? State.art-panel : (State.light-theme ? #e7eae6 : #0e100f)).with-alpha(background-opacity);
    in property <color> panel-2: (State.artwork-palette ? State.art-panel : (State.light-theme ? #dfe3de : #131614)).with-alpha(background-opacity);
    in property <color> panel-3: (State.artwork-palette ? State.art-raised : (State.light-theme ? #d4d9d3 : #181b19)).with-alpha(background-opacity);
    in property <color> raised: (State.artwork-palette ? State.art-raised : (State.light-theme ? #e3e6e2 : #171917)).with-alpha(background-opacity);
    in property <color> hover: (State.artwork-palette ? State.art-hover : (State.light-theme ? #d9ded8 : #212421)).with-alpha(background-opacity);
    in property <color> control: (State.artwork-palette ? State.art-control : (State.light-theme ? #dfe3de : #242724)).with-alpha(background-opacity);
    in property <color> text: State.artwork-palette ? #f7f6f2 : (State.light-theme ? #191d19 : #f7f8f6);
    in property <color> text-strong: State.artwork-palette ? #f7f6f2 : (State.light-theme ? #191d19 : #f2f4f1);
    in property <color> text-subtle: State.artwork-palette ? #e0dfd8 : (State.light-theme ? #343b34 : #cdd2cc);
    in property <color> muted: State.artwork-palette ? #d1d0c9 : (State.light-theme ? #545c54 : #a0a79f);
    in property <color> muted-2: State.artwork-palette ? #aaa9a2 : (State.light-theme ? #747c74 : #717970);
    in property <color> row-hover: State.artwork-palette ? State.art-hover : (State.light-theme ? #e5e8e4 : #131613);
    in property <color> icon-muted: State.light-theme && !State.artwork-palette ? #727a72 : #939a93;
    in property <color> disabled: State.light-theme && !State.artwork-palette ? #aab2aa : #3a403a;
    in property <color> border: State.light-theme && !State.artwork-palette ? #1219121f : #ffffff14;
    in property <color> border-soft: State.light-theme && !State.artwork-palette ? #12191214 : #ffffff0d;
    in property <color> border-hover: State.light-theme && !State.artwork-palette ? #1219122b : #ffffff22;
    in property <color> overlay: State.light-theme && !State.artwork-palette ? #0000000d : #ffffff12;
    in property <color> overlay-strong: State.light-theme && !State.artwork-palette ? #00000018 : #ffffff1c;
    in property <color> accent-ink: State.accent-ink;
    in property <color> selection: State.selection-color-mode == "Custom" ? State.selection-color-value : State.accent;
    in property <color> selection-ink: State.selection-color-mode == "Custom" ? State.selection-color-ink : State.accent-ink;

    public pure function ga(index: int) -> color {
        if (index <= 1) { return #1b1d26; }
        if (index == 2) { return #162124; }
        if (index == 3) { return #251b1d; }
        if (index == 4) { return #172019; }
        if (index == 5) { return #231f18; }
        if (index == 6) { return #1b1b20; }
        if (index == 7) { return #1d1d21; }
        if (index == 8) { return #251726; }
        if (index == 9) { return #112324; }
        return #272116;
    }
    public pure function gb(index: int) -> color {
        if (index <= 1) { return #3b4358; }
        if (index == 2) { return #30494e; }
        if (index == 3) { return #4e373c; }
        if (index == 4) { return #364a3b; }
        if (index == 5) { return #4b4432; }
        if (index == 6) { return #3d3d48; }
        if (index == 7) { return #484954; }
        if (index == 8) { return #5f3263; }
        if (index == 9) { return #29595d; }
        return #665536;
    }
    // Row thumbnail badge uses the middle stop.
    public pure function badge(index: int) -> color {
        if (index <= 1) { return #2a2f3f; }
        if (index == 2) { return #213337; }
        if (index == 3) { return #38272b; }
        if (index == 4) { return #243328; }
        if (index == 5) { return #353025; }
        if (index == 6) { return #2a2a32; }
        if (index == 7) { return #2e2f36; }
        if (index == 8) { return #3e2140; }
        if (index == 9) { return #1b393b; }
        return #403623;
    }

    public pure function card-gap(browse-width: int) -> length {
        return clamp(browse-width * 0.05px, 10px, 20px);
    }
}

export component IcBtn inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Palette.muted;
    in property <color> hover-tint: Palette.text;
    // Most icon buttons are transparent controls.  The Web UI's top-bar
    // `.icon-btn` instances alone rest on `--bg`, so callers can opt into
    // that exact surface without changing buttons elsewhere.
    in property <color> rest-background: transparent;
    in property <length> icon-size: 16px;
    in property <bool> active: false;
    out property <bool> hovered: area.has-hover;
    callback clicked();
    callback scrolled(PointerScrollEvent) -> EventResult;

    width: 32px;
    height: 32px;
    border-radius: self.width / 2;
    background: area.pressed ? Palette.overlay-strong : (area.has-hover ? Palette.overlay : root.rest-background);
    animate background { duration: 100ms; }

    area := TouchArea {
        clicked => { root.clicked(); }
        scroll-event(event) => { root.scrolled(event) }
    }

    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: root.active ? State.accent : (area.has-hover ? root.hover-tint : root.tint);
        animate colorize { duration: 100ms; }
    }
}

export component PlayerSlider inherits Rectangle {
    out property <bool> hovered: area.has-hover;
    in-out property <float> value: 0.0;
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;
    in property <color> fill-color: #e2e6e1;
    in property <color> track-color: #2e332f;
    in property <color> thumb-color: #ffffff;
    in property <bool> scrollable: false;
    in property <bool> commit-on-release: false;
    in property <float> scroll-step: 0.0;
    callback changed(float);
    callback preview(float);
    callback finished(float);
    callback scrolled(PointerScrollEvent) -> EventResult;

    height: 16px;
    min-width: 40px;

    area := TouchArea {
        scroll-event(event) => {
            if (root.scrolled(event) == accept) {
                return accept;
            }
            if (root.scrollable) {
                let step = root.scroll-step > 0.0 ? root.scroll-step : max(0.01, (root.maximum - root.minimum) * 0.04);
                let delta = event.delta-y < 0px ? step : (event.delta-y > 0px ? -step : 0.0);
                if (delta != 0.0) {
                    root.value = clamp(root.value + delta, root.minimum, root.maximum);
                    root.changed(root.value);
                    return accept;
                }
            }
            reject
        }
        clicked => {
            root.value = clamp(root.minimum + ((self.mouse-x / 1px) / max(1.0, self.width / 1px)) * (root.maximum - root.minimum), root.minimum, root.maximum);
            if (!root.commit-on-release) { root.changed(root.value); }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down || (event.kind == PointerEventKind.move && area.pressed)) {
                root.value = clamp(root.minimum + ((self.mouse-x / 1px) / max(1.0, self.width / 1px)) * (root.maximum - root.minimum), root.minimum, root.maximum);
                if (root.commit-on-release) { root.preview(root.value); }
                else { root.changed(root.value); }
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.commit-on-release) {
                root.value = clamp(root.minimum + ((self.mouse-x / 1px) / max(1.0, self.width / 1px)) * (root.maximum - root.minimum), root.minimum, root.maximum);
                root.preview(root.value);
                root.finished(root.value);
            }
        }
    }

    // Track background (unfilled)
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: parent.width;
        border-radius: 99px;
        background: root.track-color;

        // Filled progress portion
        Rectangle {
            x: 0px;
            y: 0px;
            height: 4px;
            width: parent.width * clamp((root.value - root.minimum) / max(0.0001, root.maximum - root.minimum), 0.0, 1.0);
            border-radius: 99px;
            background: area.has-hover || area.pressed ? State.accent : root.fill-color;
            animate background { duration: 100ms; }
        }
    }

    // Thumb dot
    Rectangle {
        x: clamp(parent.width * clamp((root.value - root.minimum) / max(0.0001, root.maximum - root.minimum), 0.0, 1.0) - self.width / 2, 0px, parent.width - self.width);
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: area.pressed ? State.accent : root.thumb-color;
        opacity: area.has-hover || area.pressed ? 1.0 : 0.0;
        animate opacity { duration: 120ms; }
    }
}

export component TextBtn inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    min-width: 34px;
    height: 34px;
    border-radius: 6px;
    border-width: root.primary || root.danger ? 1px : 0px;
    border-color: root.danger ? #ff5b7455 : State.accent;
    background: !root.enabled ? Palette.panel-2 : (area.pressed ? Palette.border-soft : (root.primary ? State.accent : (area.has-hover ? Palette.overlay : Palette.panel-2)));
    opacity: root.enabled ? 1.0 : 0.35;
    animate background { duration: 100ms; }

    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        color: !root.enabled ? Palette.muted : (root.primary ? Palette.accent-ink : (root.danger ? #ff5b74 : (area.has-hover ? Palette.text : Palette.text-subtle)));
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export component ActionBtn inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    horizontal-stretch: 0;
    height: 34px;
    border-radius: 999px;
    background: !root.enabled
        ? #1c1e1c
        : (root.primary
            ? (area.has-hover ? #ffffff : #f4f6f3)
            : (root.danger ? (area.has-hover ? #ff5b7444 : #ff5b7422) : (area.has-hover ? #303430 : #242724)));
    opacity: root.enabled ? 1.0 : 0.38;
    animate background { duration: 100ms; }

    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if root.icon.width > 0 : VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: !root.enabled ? Palette.muted : (root.primary ? #0a0b0a : (root.danger ? #ff5b74 : #ffffff));
            }
        }
        Text {
            text: root.label;
            color: !root.enabled ? Palette.muted : (root.primary ? #0a0b0a : (root.danger ? #ff5b74 : #ffffff));
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

export component CustomToggle inherits Rectangle {
    in property <bool> checked: false;
    callback toggled(bool);

    width: 35px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? State.accent.with-alpha(0.3) : Palette.control;
    animate background { duration: 140ms; }

    thumb := Rectangle {
        x: root.checked ? 17px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? State.accent : #858d84;
        animate x { duration: 140ms; }
        animate background { duration: 140ms; }
    }

    TouchArea {
        clicked => {
            root.toggled(!root.checked);
        }
    }
}

export component HeaderCell inherits TouchArea {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> descending: false;
    in property <bool> right-align: false;
    callback sort();

    Text {
        text: root.active ? (root.descending ? "\{root.label} \u{25BE}" : "\{root.label} \u{25B4}") : root.label;
        color: root.active ? State.accent : Palette.muted-2;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.8px;
        vertical-alignment: center;
        horizontal-alignment: root.right-align ? right : left;
    }
    clicked => { root.sort(); }
}

// One table row. Triggers: click plays, right-click or the overflow button
// opens the global context menu, heart toggles the favorite.
export component TrackRow inherits Rectangle {
    in property <TrackItem> track;
    in property <int> index: 1;
    in property <bool> show-added: true;
    in property <bool> show-year: true;
    in property <bool> show-album: true;
    in property <bool> show-plays: false;
    in property <bool> show-remove: false;

    callback play();
    callback favorite();
    callback context(int, int);
    callback remove();

    height: 58px;
    background: area.pressed ? Palette.hover : ((area.has-hover || actions-hover.has-hover) ? Palette.row-hover : (root.track.is-playing ? Palette.panel-2 : transparent));
    animate background { duration: 120ms; }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.border;
    }

    area := TouchArea {
        clicked => { root.play(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                root.context(round((root.absolute-position.x + area.mouse-x) / 1px), round((root.absolute-position.y + area.mouse-y) / 1px));
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        Rectangle {
            width: 44px;
            if area.has-hover : Image {
                source: @image-url("../assets/icons/play.svg");
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
                x: (parent.width - self.width) / 2;
                colorize: Palette.text;
            }
            if !area.has-hover && root.track.is-playing : Image {
                source: @image-url("../assets/icons/music.svg");
                width: 15px;
                height: 15px;
                y: (parent.height - self.height) / 2;
                x: (parent.width - self.width) / 2;
                colorize: State.accent;
            }
            if !area.has-hover && !root.track.is-playing : Text {
                text: "\{root.index}";
                color: root.track.unavailable ? #ff5b74 : Palette.muted-2;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        if State.show-list-artwork : Rectangle {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            clip: true;
            y: (parent.height - self.height) / 2;
            background: root.track.badge-bg;
            if root.track.has-cover : Image {
                source: root.track.cover;
                width: parent.width;
                height: parent.height;
                image-fit: ImageFit.cover;
            }
            if !root.track.has-cover : Text {
                text: root.track.initials;
                color: Palette.text;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 3;

            Text {
                text: root.track.unavailable ? "\{root.track.title} (unavailable)" : root.track.title;
                color: root.track.is-playing ? State.accent : (root.track.unavailable ? #ff5b74 : Palette.text-strong);
                font-size: 12px;
                font-weight: 650;
                overflow: elide;
                animate color { duration: 150ms; }
            }
            if State.show-list-artist : Text {
                text: root.track.artist;
                color: Palette.muted;
                font-size: 10px;
                overflow: elide;
            }
        }

        if root.show-album && State.show-list-album : Rectangle {
            width: 25%;
            album-area := TouchArea {
                clicked => { Actions.set-view("Album", "", root.track.album, ""); }
            }
            Text {
                width: 100%;
                text: root.track.album;
                color: album-area.has-hover ? Palette.text : Palette.text-subtle;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
                animate color { duration: 100ms; }
            }
        }

        if State.show-list-added && root.show-added : Text {
            text: root.track.added;
            color: Palette.text-subtle;
            font-size: 11px;
            overflow: elide;
            width: 100px;
            vertical-alignment: center;
        }

        if State.show-list-year && root.show-year : Text {
            text: root.track.year;
            color: Palette.text-subtle;
            font-size: 11px;
            width: 70px;
            vertical-alignment: center;
        }

        if root.show-plays : Text {
            text: "\{root.track.play-count}";
            color: Palette.text-subtle;
            font-size: 11px;
            width: 60px;
            vertical-alignment: center;
        }

        if State.show-list-duration : Text {
            text: root.track.duration;
            color: Palette.muted;
            font-size: 11px;
            width: 64px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Rectangle {
            width: 76px;
            actions-hover := TouchArea { }
            HorizontalLayout {
                opacity: (area.has-hover || actions-hover.has-hover || root.track.is-favorite) ? 1.0 : 0.0;
                spacing: 2px;
                alignment: center;

                if State.show-list-favorite : IcBtn {
                    icon: root.track.is-favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                    tint: root.track.is-favorite ? State.accent : Palette.muted-2;
                    hover-tint: root.track.is-favorite ? State.accent : Palette.text;
                    icon-size: 14px;
                    clicked => { root.favorite(); }
                }
                if root.show-remove : IcBtn {
                    icon: @image-url("../assets/icons/close.svg");
                    tint: Palette.muted-2;
                    hover-tint: #ff5b74;
                    icon-size: 13px;
                    clicked => { root.remove(); }
                }
                IcBtn {
                    icon: @image-url("../assets/icons/more.svg");
                    tint: Palette.muted-2;
                    hover-tint: Palette.text;
                    icon-size: 14px;
                    clicked => { root.context(round((root.absolute-position.x + root.width - 24px) / 1px), round((root.absolute-position.y + root.height - 8px) / 1px)); }
                }
            }
        }
        }
    }

// Sortable table header.
export component TrackHeader inherits Rectangle {
    in property <string> first-column: "TITLE";
    in property <string> first-sort: "Title";
    in property <bool> show-added: true;
    in property <bool> show-year: true;
    in property <bool> show-album: true;
    in property <bool> show-plays: false;
    in property <string> active-sort: "Title";
    in property <bool> descending: false;

    callback sort(string);

    height: 37px;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: parent.width;
        background: Palette.border;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        HeaderCell {
            label: "#";
            width: 44px;
        }
        if State.show-list-artwork : Rectangle { width: 38px; }

        HeaderCell {
            label: root.first-column;
            active: root.active-sort == root.first-sort;
            descending: root.descending;
            horizontal-stretch: 3;
            sort => { root.sort(root.first-sort); }
        }

        if root.show-album && State.show-list-album : HeaderCell {
            label: "ALBUM";
            width: 25%;
            active: root.active-sort == "Album";
            descending: root.descending;
            sort => { root.sort("Album"); }
        }

        if State.show-list-added && root.show-added : HeaderCell {
            label: "ADDED";
            width: 100px;
            active: root.active-sort == "Added";
            descending: root.descending;
            sort => { root.sort("Added"); }
        }

        if State.show-list-year && root.show-year : HeaderCell {
            label: "YEAR";
            width: 70px;
            active: root.active-sort == "Year";
            descending: root.descending;
            sort => { root.sort("Year"); }
        }

        if root.show-plays : HeaderCell {
            label: "PLAYS";
            width: 60px;
            active: root.active-sort == "PlayCount";
            descending: root.descending;
            sort => { root.sort("PlayCount"); }
        }

        if State.show-list-duration : HeaderCell {
            label: "TIME";
            width: 64px;
            right-align: true;
            sort => { root.sort("Duration"); }
        }

        Rectangle { width: 76px; }
    }
}

// The standard table view: header + rows + "Load more" affordance.
export component TrackTable inherits Rectangle {
    in property <bool> show-added: true;
    in property <bool> show-year: true;
    in property <bool> show-album: true;
    in property <bool> show-plays: false;
    in property <string> first-column: "Title";
    in property <string> first-sort: "Title";
    in property <bool> show-remove: false;
    in property <string> empty-text: "No tracks to show.";
    in property <bool> scrollable: true;

    callback sort(string);

    VerticalLayout {
        TrackHeader {
            first-column: root.first-column;
            first-sort: root.first-sort;
            show-added: root.show-added;
            show-year: root.show-year;
            show-album: root.show-album;
            show-plays: root.show-plays;
            active-sort: State.view-sort;
            descending: State.view-descending;
            sort(column) => { root.sort(column); }
        }

        if root.scrollable : Rectangle {
            vertical-stretch: 1;

            ListView {
                for row[index] in State.tracks : TrackRow {
                    track: row;
                    index: index + 1;
                    show-added: root.show-added;
                    show-year: root.show-year;
                    show-album: root.show-album;
                    show-plays: root.show-plays;
                    show-remove: root.show-remove;
                    play => { Actions.play-track(row.id); }
                    favorite => { Actions.toggle-favorite(row.id); }
                    context(x, y) => { Actions.open-context-menu(row.id, x, y); }
                    remove => { Actions.remove-from-playlist(row.position); }
                }
            }
        }

        if !root.scrollable : VerticalLayout {
            for row[index] in State.tracks : TrackRow {
                track: row;
                index: index + 1;
                show-added: root.show-added;
                show-year: root.show-year;
                show-album: root.show-album;
                show-plays: root.show-plays;
                show-remove: root.show-remove;
                play => { Actions.play-track(row.id); }
                favorite => { Actions.toggle-favorite(row.id); }
                context(x, y) => { Actions.open-context-menu(row.id, x, y); }
                remove => { Actions.remove-from-playlist(row.position); }
            }
        }

        if State.tracks.length == 0 && !State.page-loading : Rectangle {
            height: 120px;
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.empty-text;
                    color: Palette.muted-2;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }

        if State.can-load-more : Rectangle {
            height: 44px;
            TextBtn {
                label: "Load more";
                height: 30px;
                width: 120px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                clicked => { Actions.load-more(); }
            }
        }
    }
}

// Gradient card tile used by the albums/artists/genres/folders grids.
export component CardTile inherits Rectangle {
    in property <GroupItem> item;
    in property <bool> round: false;

    callback play();
    callback open();

    vertical-stretch: 0;
    border-radius: 8px;
    background: area.has-hover ? Palette.hover : Palette.raised;
    animate background { duration: 140ms; }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        card := Rectangle {
            width: 100%;
            height: self.width;
            vertical-stretch: 0;
            border-radius: root.round ? self.width / 2 : 6px;
            clip: true;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 14px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000040;
            background: @linear-gradient(150deg, Palette.ga(root.item.gradient) 0%, Palette.badge(root.item.gradient) 58%, Palette.gb(root.item.gradient) 100%);

            if root.item.has-cover : Image {
                source: root.item.cover;
                width: 100%;
                height: 100%;
                image-fit: ImageFit.cover;
            }

            if !root.item.has-cover : Text {
                text: root.item.initials;
                color: #ffffffe0;
                font-size: clamp(State.window-width * 0.02px, 16px, 26px);
                font-weight: 900;
                letter-spacing: -1px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(180deg, transparent 45%, #00000047 100%);
            }

            Rectangle {
                width: 38px;
                height: 38px;
                x: parent.width - self.width - 10px;
                y: parent.height - self.height - 10px;
                border-radius: 19px;
                drop-shadow-offset-x: 0px;
                drop-shadow-offset-y: 8px;
                drop-shadow-blur: 20px;
                drop-shadow-color: #00000061;
                background: fab-area.has-hover ? State.accent.brighter(0.12) : State.accent;
                opacity: area.has-hover || fab-area.has-hover ? 1.0 : 0.0;
                animate opacity { duration: 150ms; }
                animate background { duration: 150ms; }

                Image {
                    source: @image-url("../assets/icons/play.svg");
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2 + 1px;
                    y: (parent.height - self.height) / 2;
                    colorize: Palette.accent-ink;
                }

                fab-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.play(); }
                }
            }
        }

        VerticalLayout {
            spacing: 4px;
            min-width: 0px;
            Text {
                min-width: 0px;
                text: root.item.name;
                color: Palette.text;
                font-size: 13px;
                font-weight: 750;
                overflow: elide;
            }
            if root.item.subtitle != "" : Text {
                min-width: 0px;
                text: root.item.subtitle;
                color: Palette.muted;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}

export component HomeCardTile inherits Rectangle {
    in property <HomeCardItem> item;
    in property <bool> round: false;
    callback open();
    callback play();

    vertical-stretch: 0;
    border-radius: 8px;
    background: area.has-hover ? Palette.hover : Palette.raised;
    animate background { duration: 140ms; }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        card := Rectangle {
            width: 100%;
            height: self.width;
            vertical-stretch: 0;
            border-radius: (root.round || root.item.kind == "artist") ? self.width / 2 : 6px;
            clip: true;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 14px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000040;
            background: @linear-gradient(150deg, Palette.ga(root.item.gradient) 0%, Palette.badge(root.item.gradient) 58%, Palette.gb(root.item.gradient) 100%);
            if root.item.has-cover : Image {
                source: root.item.cover;
                width: 100%;
                height: 100%;
                image-fit: ImageFit.cover;
            }
            if !root.item.has-cover : Text {
                text: root.item.initials;
                color: #ffffffe0;
                font-size: clamp(State.window-width * 0.02px, 16px, 26px);
                font-weight: 900;
                letter-spacing: -1px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(180deg, transparent 45%, #00000047 100%);
            }
            Rectangle {
                width: 38px;
                height: 38px;
                x: parent.width - self.width - 10px;
                y: parent.height - self.height - 10px;
                border-radius: 19px;
                drop-shadow-offset-x: 0px;
                drop-shadow-offset-y: 8px;
                drop-shadow-blur: 20px;
                drop-shadow-color: #00000061;
                background: fab-area.has-hover ? State.accent.brighter(0.12) : State.accent;
                opacity: area.has-hover || fab-area.has-hover ? 1.0 : 0.0;
                animate opacity { duration: 150ms; }
                animate background { duration: 150ms; }
                Image {
                    source: @image-url("../assets/icons/play.svg");
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2 + 1px;
                    y: (parent.height - self.height) / 2;
                    colorize: Palette.accent-ink;
                }
                fab-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.play(); }
                }
            }
        }

        VerticalLayout {
            spacing: 4px;
            min-width: 0px;
            Text { min-width: 0px; text: root.item.title; color: Palette.text; font-size: 13px; font-weight: 750; overflow: elide; }
            if root.item.subtitle != "" : Text { min-width: 0px; text: root.item.subtitle; color: Palette.muted; font-size: 11px; overflow: elide; }
        }
    }
}

// Responsive catalog grid. CSS in the release uses auto-fill with a 130px
// minimum card size; leave a little room for the card gap when deriving columns.
export component GroupGrid inherits Rectangle {
    in property <bool> round: false;
    in property <string> kind: "";
    in property <string> empty-text: "Nothing here yet.";
    in property <[GroupItem]> items: State.groups;
    in property <bool> show-load-more: true;
    in property <bool> scrollable: true;

    VerticalLayout {
        if root.items.length == 0 : Rectangle {
            width: 100%;
            height: 100%;
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.empty-text;
                    color: Palette.muted-2;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
        if root.items.length > 0 && root.scrollable : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 16px;
                GridLayout {
                    width: 100%;
                    spacing: Palette.card-gap(State.browse-width);
                    for item[index] in root.items : CardTile {
                        item: item;
                        round: root.round || root.kind == "artist" || State.view == "Artists";
                        col: Math.mod(index, State.card-columns);
                        row: index / State.card-columns;
                        play => {
                            Actions.play-group(
                                root.kind != "" ? root.kind : (State.view == "Albums" ? "album" : (State.view == "Artists" ? "artist" : (State.view == "Genres" ? "genre" : "folder"))),
                                item.name
                            );
                        }
                        open => {
                            Actions.open-group(
                                root.kind != "" ? root.kind : (State.view == "Albums" ? "album" : (State.view == "Artists" ? "artist" : (State.view == "Genres" ? "genre" : "folder"))),
                                item.name
                            );
                        }
                    }
                }
                if root.show-load-more && State.groups-total > root.items.length : Rectangle {
                    height: 44px;
                    ActionBtn {
                        label: "Load more";
                        clicked => { Actions.load-more-groups(); }
                    }
                }
            }
        }
        if root.items.length > 0 && !root.scrollable : GridLayout {
            width: 100%;
            spacing: Palette.card-gap(State.browse-width);
            for item[index] in root.items : CardTile {
                item: item;
                round: root.round || root.kind == "artist" || State.view == "Artists";
                col: Math.mod(index, State.card-columns);
                row: index / State.card-columns;
                play => {
                    Actions.play-group(
                        root.kind != "" ? root.kind : (State.view == "Albums" ? "album" : (State.view == "Artists" ? "artist" : (State.view == "Genres" ? "genre" : "folder"))),
                        item.name
                    );
                }
                open => {
                    Actions.open-group(
                        root.kind != "" ? root.kind : (State.view == "Albums" ? "album" : (State.view == "Artists" ? "artist" : (State.view == "Genres" ? "genre" : "folder"))),
                        item.name
                    );
                }
            }
        }
    }
}

// Detail page hero: cover block + eyebrow + title + subtitle.
export component HeroDetail inherits Rectangle {
    in property <string> eyebrow: "";
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <image> cover;
    in property <bool> has-cover: false;
    in property <bool> round: false;
    in property <string> initials: "";
    in property <int> gradient: 1;
    in property <bool> now-playing: false;
    in property <bool> favorite: false;

    callback play();
    callback shuffle();
    callback toggle-favorite();
    callback show-location();
    callback details();

    height: 230px;
    border-radius: 8px;
    background: State.light-theme ? Palette.panel : #0e100e;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: State.light-theme
            ? @linear-gradient(110deg, State.accent.with-alpha(0.08) 0%, Palette.text.with-alpha(0.02) 45%, transparent 100%)
            : @linear-gradient(110deg, State.accent.with-alpha(0.11) 0%, #ffffff05 45%, transparent 100%);
    }

    HorizontalLayout {
        padding: 20px;
        spacing: 24px;

        Rectangle {
            width: 190px;
            height: 190px;
            border-radius: root.round ? self.width / 2 : 8px;
            clip: true;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 18px;
            drop-shadow-blur: 38px;
            drop-shadow-color: #0000006b;
            background: @linear-gradient(150deg, Palette.ga(root.gradient) 0%, Palette.badge(root.gradient) 58%, Palette.gb(root.gradient) 100%);
            if root.has-cover : Image {
                source: root.cover;
                width: parent.width;
                height: parent.height;
                image-fit: ImageFit.cover;
            }
            if !root.has-cover : Text {
                text: root.initials != "" ? root.initials : root.title;
                color: #ffffffe0;
                font-size: clamp(State.window-width * 0.02px, 16px, 26px);
                font-weight: 900;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            alignment: end;
            spacing: 0px;
            horizontal-stretch: 1;
            min-width: 0px;

            if root.eyebrow != "" : Text {
                text: root.eyebrow == "album" || root.eyebrow == "Album" ? "ALBUM"
                    : (root.eyebrow == "artist" || root.eyebrow == "Artist" ? "ARTIST"
                    : (root.eyebrow == "playlist" || root.eyebrow == "Playlist" ? "PLAYLIST"
                    : (root.eyebrow == "folder" || root.eyebrow == "Folder" ? "FOLDER"
                    : (root.eyebrow == "genre" || root.eyebrow == "Genre" ? "GENRE"
                    : root.eyebrow))));
                color: Palette.muted;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 0.8px;
            }

            Rectangle { height: 8px; }

            Text {
                text: root.title;
                color: Palette.text;
                font-size: 42px;
                font-weight: 700;
                letter-spacing: -1.8px;
                wrap: word-wrap;
            }

            Rectangle { height: 10px; }

            if root.subtitle != "" : Text {
                text: root.subtitle;
                color: Palette.muted;
                font-size: 12px;
                overflow: elide;
            }

            Rectangle { height: 18px; }

            if root.now-playing : HorizontalLayout {
                spacing: 7px;
                ActionBtn {
                    label: root.favorite ? "♥ Favorited" : "♡ Favorite";
                    clicked => { root.toggle-favorite(); }
                }
                ActionBtn {
                    label: "Show in folder";
                    clicked => { root.show-location(); }
                }
                ActionBtn {
                    label: "Track details";
                    clicked => { root.details(); }
                }
            }

            if !root.now-playing : HorizontalLayout {
                spacing: 7px;
                ActionBtn {
                    label: "Play";
                    primary: true;
                    clicked => { root.play(); }
                }
                ActionBtn {
                    label: "Shuffle";
                    clicked => { root.shuffle(); }
                }
            }
        }
    }
}

export component EmptyState inherits Rectangle {
    in property <string> text: "Nothing here yet.";
    in property <string> subtitle: "";
    in property <string> action-label: "";
    callback action();

    VerticalLayout {
        alignment: center;
        spacing: 6px;
        padding-top: 70px;
        padding-bottom: 70px;
        padding-left: 20px;
        padding-right: 20px;
        Text {
            text: root.text;
            color: Palette.text;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        if root.subtitle != "" : Text {
            text: root.subtitle;
            color: Palette.muted;
            font-size: 11px;
            horizontal-alignment: center;
        }
        if root.action-label != "" : Rectangle { height: 8px; }
        if root.action-label != "" : HorizontalLayout {
            alignment: center;
            ActionBtn {
                label: root.action-label;
                primary: true;
                clicked => { root.action(); }
            }
        }
    }
}

export component SectionTitle inherits Rectangle {
    in property <string> text;
    in property <color> text-color: Palette.text;
    in property <length> font-size: 19px;
    in property <int> font-weight: 700;
    in property <length> letter-spacing: -0.65px;
    height: font-size >= 19px ? 26px : (font-size >= 15px ? 18px : 15px);
    Text {
        text: root.text;
        color: root.text-color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        letter-spacing: root.letter-spacing;
        vertical-alignment: center;
    }
}

export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 28px;
    min-width: 40px;
    border-radius: 99px;
    background: root.active ? Palette.overlay-strong : (area.has-hover ? Palette.overlay : Palette.panel-2);
    animate background { duration: 100ms; }

    area := TouchArea { clicked => { root.clicked(); } }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        alignment: center;
        Text {
            text: root.label;
            color: (root.active || area.has-hover) ? Palette.text : Palette.muted;
            font-size: 10px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
