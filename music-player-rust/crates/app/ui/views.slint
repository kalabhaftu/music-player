// All 25 views from the original library.js view registry, routed by
// State.view. Shared widgets come from widgets.slint.

import { State, Actions } from "state.slint";
import { TrackItem, GroupItem, QueueItem, PlaylistCardItem, HomeCardItem, HomeCardRow, HomeTrackRow, LyricLineItem, TagFieldItem, ContextMenuItem, EqBandItem, DuplicateItem, DetailRowItem, BackupItem, LyricResultItem, GroupRowItem, PlaylistRowItem, FolderRootItem, ExtensionItem, NavSettingItem } from "models.slint";
import { ListView, Slider, ComboBox, LineEdit, Switch, ScrollView } from "std-widgets.slint";
import {
    Palette, IcBtn, TextBtn, ActionBtn, CustomToggle, TrackRow, TrackHeader, TrackTable, CardTile, HomeCardTile,
    GroupGrid, HeroDetail, EmptyState, SectionTitle, Chip, PlayerSlider,
} from "widgets.slint";

component HomeSectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> view;
    in property <string> action-label: "See all";
    height: 26px;
    HorizontalLayout {
        Text {
            text: root.title;
            color: Palette.text-strong;
            font-size: 19px;
            font-weight: 750;
            letter-spacing: -0.65px;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Rectangle {
            width: 56px;
            height: 26px;
            Text {
                text: root.action-label;
                color: see-all-area.has-hover ? Palette.text : Palette.muted;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
                animate color { duration: 100ms; }
            }
            see-all-area := TouchArea { clicked => { Actions.set-view(root.view, "", "", ""); } }
        }
    }
}

component HomeQuickTrackTile inherits Rectangle {
    in property <TrackItem> item;
    callback play();

    height: 58px;
    border-radius: 6px;
    background: area.has-hover ? Palette.hover : Palette.raised;
    animate background { duration: 120ms; }
    area := TouchArea { clicked => { root.play(); } }

    HorizontalLayout {
        padding: 6px;
        spacing: 10px;

        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 5px;
            clip: true;
            background: root.item.badge-bg;
            if root.item.has-cover : Image {
                source: root.item.cover;
                width: parent.width;
                height: parent.height;
                image-fit: ImageFit.cover;
            }
            if !root.item.has-cover : Text {
                text: root.item.initials;
                color: #ffffffd0;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 3px;
            Text {
                min-width: 0px;
                text: root.item.title;
                color: Palette.text-strong;
                font-size: 12px;
                font-weight: 650;
                overflow: elide;
            }
            if root.item.artist != "" : Text {
                min-width: 0px;
                text: root.item.artist;
                color: Palette.muted;
                font-size: 10px;
                overflow: elide;
            }
        }

        IcBtn {
            icon: @image-url("../assets/icons/play.svg");
            icon-size: 16px;
            tint: Palette.icon-muted;
            width: 30px;
            height: 30px;
            clicked => { root.play(); }
        }
    }
}

component HomeQuickGrid inherits Rectangle {
    in property <[TrackItem]> items;

    GridLayout {
        width: 100%;
        spacing: 10px;
        for item[index] in root.items : HomeQuickTrackTile {
            item: item;
            col: Math.mod(index, 2);
            row: index / 2;
            play => { Actions.play-track(item.id); }
        }
    }
}

component HomeQuickRowView inherits Rectangle {
    in property <HomeTrackRow> track-row;
    height: 58px;
    HorizontalLayout {
        spacing: 10px;
        if root.track-row.filled >= 1 : HomeQuickTrackTile {
            horizontal-stretch: 1;
            min-width: 0px;
            item: root.track-row.a;
            play => { Actions.play-track(root.track-row.a.id); }
        }
        if root.track-row.filled >= 2 : HomeQuickTrackTile {
            horizontal-stretch: 1;
            min-width: 0px;
            item: root.track-row.b;
            play => { Actions.play-track(root.track-row.b.id); }
        }
        if root.track-row.filled == 1 : Rectangle { horizontal-stretch: 1; min-width: 0px; }
    }
}

component HomeLibraryTile inherits HomeCardTile {
    open => {
        if (root.item.kind == "track") { Actions.play-track(root.item.id); }
        else if (root.item.kind == "playlist") { Actions.set-view("Playlist", "", "", root.item.id); }
        else { Actions.set-view("Album", "", root.item.title, ""); }
    }
    play => {
        if (root.item.kind == "track") { Actions.play-track(root.item.id); }
        else if (root.item.kind == "playlist") { Actions.play-playlist(root.item.id); }
        else { Actions.play-group("album", root.item.title); }
    }
}

component HomeCardGrid inherits Rectangle {
    in property <[HomeCardItem]> items;

    GridLayout {
        width: 100%;
        spacing: 14px;
        for item[index] in root.items : HomeLibraryTile {
            item: item;
            col: Math.mod(index, State.card-columns);
            row: index / State.card-columns;
        }
    }
}

component HomeCardRowView inherits Rectangle {
    in property <HomeCardRow> card-row;
    HorizontalLayout {
        spacing: 14px;
        if root.card-row.filled >= 1 : HomeLibraryTile {
            horizontal-stretch: 1;
            min-width: 0px;
            item: root.card-row.a;
        }
        if root.card-row.filled >= 2 : HomeLibraryTile {
            horizontal-stretch: 1;
            min-width: 0px;
            item: root.card-row.b;
        }
        if root.card-row.filled >= 3 : HomeLibraryTile {
            horizontal-stretch: 1;
            min-width: 0px;
            item: root.card-row.c;
        }
        if root.card-row.filled >= 4 : HomeLibraryTile {
            horizontal-stretch: 1;
            min-width: 0px;
            item: root.card-row.d;
        }
        if root.card-row.filled >= 5 : HomeLibraryTile {
            horizontal-stretch: 1;
            min-width: 0px;
            item: root.card-row.e;
        }
        if root.card-row.filled < 5 : Rectangle { horizontal-stretch: 1; min-width: 0px; }
        if root.card-row.filled < 4 : Rectangle { horizontal-stretch: 1; min-width: 0px; }
        if root.card-row.filled < 3 : Rectangle { horizontal-stretch: 1; min-width: 0px; }
        if root.card-row.filled < 2 : Rectangle { horizontal-stretch: 1; min-width: 0px; }
    }
}

component HomeEmptyState inherits Rectangle {
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: State.has-roots ? (State.scan-active ? "Scanning your music folders" : "No indexed tracks yet") : "No music folders added";
            color: Palette.text;
            font-size: 16px;
            font-weight: 750;
            horizontal-alignment: center;
        }
        Text {
            text: State.has-roots
                ? (State.scan-active ? "Tracks will appear here as the scan indexes your files." : "Scan your selected folders to add tracks to the library.")
                : "Add a folder to scan your local collection.";
            color: Palette.muted;
            font-size: 11px;
            horizontal-alignment: center;
        }
        if !State.scan-active : HorizontalLayout {
            alignment: center;
            ActionBtn {
                label: State.has-roots ? "Scan folders" : "Add music folder";
                primary: true;
                clicked => {
                    if (State.has-roots) { Actions.scan-library(); }
                    else { Actions.open-modal("folders"); }
                }
            }
        }
    }
}

// ---- Home ------------------------------------------------------------------
component HomeView inherits Rectangle {
    if State.library-empty : HomeEmptyState {
    }
    if !State.library-empty : ScrollView {
        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 32px;
            spacing: 24px;

            VerticalLayout {
                spacing: 5px;
                Text { text: State.home-greeting; color: Palette.text; font-size: 30px; font-weight: 800; letter-spacing: -0.65px; }
                Text { text: State.home-subtitle; color: Palette.muted; font-size: 12px; }
            }

            if State.home-quick-tracks.length > 0 : VerticalLayout {
                spacing: 13px;
                HomeSectionHeader { title: "Quick access"; view: "Songs"; }
                HomeQuickGrid { items: State.home-quick-tracks; }
            }

            if State.home-recent-albums.length > 0 : VerticalLayout {
                spacing: 13px;
                HomeSectionHeader { title: "Recently played"; view: "Recently Played"; }
                HomeCardGrid { items: State.home-recent-albums; }
            }

            if State.home-library-cards.length > 0 : VerticalLayout {
                spacing: 13px;
                HomeSectionHeader { title: State.home-library-title; view: State.home-library-view; action-label: "View all"; }
                HomeCardGrid { items: State.home-library-cards; }
            }
        }
    }
}

// ---- Songs-like table views ------------------------------------------------
component SongsView inherits Rectangle {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 32px;
        spacing: 12px;

        HorizontalLayout {
            VerticalLayout {
                spacing: 5px;
                Text { text: State.view-title; color: Palette.text; font-size: 30px; font-weight: 800; letter-spacing: -0.65px; }
                Text { text: State.view-subtitle; color: Palette.muted; font-size: 12px; }
            }
            Rectangle { horizontal-stretch: 1; }
            ActionBtn { label: "Play all"; primary: true; clicked => { Actions.play-view(State.view); } }
            ActionBtn {
                label: "Shuffle";
                clicked => {
                    if (!State.shuffle) { Actions.toggle-shuffle(); }
                    Actions.play-view(State.view);
                }
            }
        }

        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Text { text: "Sort"; color: Palette.muted; font-size: 11px; vertical-alignment: center; }
            ComboBox {
                width: 150px;
                model: State.view == "Videos"
                    ? ["Title", "Artist", "Album", "Genre", "Year", "Added", "Duration", "PlayCount", "LastPlayed", "Path", "Rating", "Type"]
                    : ["Title", "Artist", "Album", "Genre", "Year", "Added", "Duration", "PlayCount", "LastPlayed", "Path", "Rating"];
                current-value: State.view-sort;
                selected(value) => { Actions.sort-view(value); }
            }
            ActionBtn {
                label: State.view-descending ? "Descending" : "Ascending";
                clicked => { Actions.sort-view(State.view-sort); }
            }
        }

        TrackTable {
            vertical-stretch: 1;
            sort(column) => { Actions.sort-view(column); }
            empty-text: State.view == "Videos" ? "No videos indexed. Enable video file types in scan exclusions." : "No tracks to show.";
        }
    }
}

// ---- Grid views (Albums / Artists / Genres) --------------------------------
component GridView inherits Rectangle {
    in property <string> title: "";
    in property <bool> round: false;
    in property <string> empty-text: "Nothing here yet.";

    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 32px;
        spacing: 12px;

        VerticalLayout {
            spacing: 5px;
            Text { text: root.title; color: Palette.text; font-size: 30px; font-weight: 800; letter-spacing: -0.65px; }
            Text { text: root.title == "Albums" ? "\{State.groups-total} albums" : (root.title == "Artists" ? "\{State.groups-total} artists" : "\{State.groups-total} genres"); color: Palette.muted; font-size: 12px; }
        }

        GroupGrid {
            vertical-stretch: 1;
            round: root.round;
            kind: root.title == "Albums" ? "album" : (root.title == "Artists" ? "artist" : (root.title == "Genres" ? "genre" : "folder"));
            empty-text: root.empty-text;
        }
    }
}

component ArtistsView inherits GridView {
    title: "Artists";
    round: true;
    empty-text: "No artists indexed yet.";
}

// ---- Folders ---------------------------------------------------------------
component FolderTile inherits Rectangle {
    in property <GroupItem> item;

    vertical-stretch: 0;
    border-radius: 8px;
    background: area.has-hover ? Palette.hover : Palette.raised;
    animate background { duration: 140ms; }

    area := TouchArea {
        clicked => { Actions.set-view("Folder", "", item.name, ""); }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        folder-card := Rectangle {
            width: 100%;
            height: self.width;
            vertical-stretch: 0;
            border-radius: 6px;
            clip: true;
            background: @linear-gradient(145deg, Palette.ga(root.item.gradient) 0%, Palette.gb(root.item.gradient) 100%);

            Image {
                source: @image-url("../assets/icons/folder.svg");
                width: 32px;
                height: 32px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: #ffffffd0;
            }
        }
        VerticalLayout {
            spacing: 3px;
            min-width: 0px;
            Text {
                min-width: 0px;
                text: root.item.name;
                color: Palette.text-strong;
                font-size: 13px;
                font-weight: 750;
                overflow: elide;
            }
            if root.item.subtitle != "" : Text {
                min-width: 0px;
                text: root.item.subtitle;
                color: Palette.muted;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}

component FoldersView inherits Rectangle {
    ScrollView {
        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 32px;
            spacing: 20px;

            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    spacing: 5px;
                    horizontal-stretch: 1;
                    Text {
                        text: "Folders";
                        color: Palette.text;
                        font-size: 30px;
                        font-weight: 800;
                        letter-spacing: -0.65px;
                    }
                }
                ActionBtn {
                    label: "＋ Add folder";
                    primary: true;
                    clicked => { Actions.open-modal("folders"); }
                }
                ActionBtn { label: "Scan"; clicked => { Actions.scan-library(); } }
                ActionBtn {
                    label: "Rebuild";
                    clicked => { Actions.rebuild-library-index(); }
                }
                ActionBtn { label: "Roots"; clicked => { Actions.open-modal("folders"); } }
                ActionBtn {
                    label: "Exclusions";
                    clicked => { Actions.open-modal("exclusions"); }
                }
            }

            if State.library-warning != "" : Text {
                text: State.library-warning;
                color: #ffb04a;
                font-size: 11px;
            }

            // Scan status row: dot + label + counters.
            if State.scan-active || State.scan-paused : Rectangle {
                height: 64px;
                border-radius: 8px;
                background: Palette.raised;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 4px;
                        background: State.scan-active ? State.accent : #ffb04a;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text {
                            text: State.scan-cancelling ? "Cancelling scan…"
                                : State.scan-paused ? "Scan paused" : "Scanning library";
                            color: Palette.text-strong;
                            font-size: 12px;
                            font-weight: 650;
                        }
                        Text {
                            text: State.scan-scanned > 0
                                ? "\{State.scan-scanned} files scanned · \{State.library-tracks} tracks · \{State.scan-path}"
                                : (State.scan-path != ""
                                    ? "\{State.scan-path} · \{State.library-tracks} tracks"
                                    : "Scanning library files…");
                            color: Palette.muted;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }
                    if State.scan-active : ActionBtn {
                        label: State.scan-paused ? "Resume" : "Pause";
                        clicked => { Actions.pause-scan(); }
                    }
                    if State.scan-active : ActionBtn {
                        label: "Cancel";
                        danger: true;
                        clicked => { Actions.cancel-scan(); }
                    }
                }
            }

            SectionTitle { text: "Indexed folders · \{State.groups-total}"; }
            if State.groups.length == 0 : EmptyState {
                text: "Indexed folders will appear here.";
            }
            if State.groups.length > 0 : ScrollView {
                vertical-stretch: 1;
                GridLayout {
                    width: 100%;
                    spacing: 14px;
                    for item[index] in State.groups : FolderTile {
                        item: item;
                        col: Math.mod(index, State.card-columns);
                        row: index / State.card-columns;
                    }
                }
            }
            if State.groups-total > State.groups.length : ActionBtn {
                label: "Load more folders";
                clicked => { Actions.load-more-groups(); }
            }

            SectionTitle { text: "Library roots"; }
            if State.folder-roots.length == 0 : EmptyState { text: "No music folders added yet."; }
            for rootEntry in State.folder-roots : Rectangle {
                height: 64px;
                border-radius: 8px;
                background: Palette.raised;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Palette.border;
                        background: Palette.hover;
                        Image {
                            source: @image-url("../assets/icons/folder.svg");
                            width: 18px;
                            height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: State.accent;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text { text: rootEntry.path; color: Palette.text-strong; font-size: 12px; font-weight: 650; overflow: elide; }
                        Text {
                            text: rootEntry.is-available ? "\{rootEntry.path} · Available" : "Reconnect this drive, then rescan the library.";
                            color: rootEntry.is-available ? Palette.muted : #ff5b74;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }
                    ActionBtn { label: "Rescan"; clicked => { Actions.rescan-root(rootEntry.path); } }
                    ActionBtn { label: "Remove"; danger: true; clicked => { Actions.remove-root(rootEntry.path); } }
                }
            }
        }
    }
}


// ---- Playlists ---------------------------------------------------------------

component SmartPlaylistTile inherits Rectangle {
    in property <PlaylistCardItem> card;

    vertical-stretch: 0;
    border-radius: 8px;
    background: area.has-hover ? Palette.hover : Palette.raised;
    animate background { duration: 140ms; }

    area := TouchArea {
        clicked => { Actions.set-view(root.card.id, "", "", ""); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                Actions.play-view(root.card.id);
            }
        }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        smart-cover := Rectangle {
            width: 100%;
            height: self.width;
            vertical-stretch: 0;
            border-radius: 6px;
            clip: true;
            background: root.card.id == "Most Played" ? @linear-gradient(135deg, #ff5e36 0%, #f32759 60%, #890b50 100%)
                : root.card.id == "With Lyrics" ? @linear-gradient(135deg, #8b5cf6 0%, #6366f1 60%, #1e1b4b 100%)
                : root.card.id == "Videos" ? @linear-gradient(135deg, #3b82f6 0%, #1d4ed8 60%, #0f172a 100%)
                : @linear-gradient(135deg, #10b981 0%, #06b6d4 60%, #134e4a 100%);

            Image {
                source: root.card.id == "Most Played" ? @image-url("../assets/icons/spark.svg")
                    : root.card.id == "With Lyrics" ? @image-url("../assets/icons/lyrics.svg")
                    : root.card.id == "Videos" ? @image-url("../assets/icons/disc.svg")
                    : @image-url("../assets/icons/refresh.svg");
                width: 36px;
                height: 36px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: #ffffff;
            }

            Rectangle {
                width: 38px;
                height: 38px;
                x: parent.width - self.width - 10px;
                y: parent.height - self.height - 10px;
                border-radius: 19px;
                background: State.accent;
                opacity: area.has-hover ? 1.0 : 0.0;
                animate opacity { duration: 150ms; }

                Image {
                    source: @image-url("../assets/icons/play.svg");
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2 + 1px;
                    y: (parent.height - self.height) / 2;
                    colorize: Palette.accent-ink;
                }

                TouchArea { clicked => { Actions.play-view(root.card.id); } }
            }
        }

        VerticalLayout {
            spacing: 3px;
            min-width: 0px;
            Text {
                text: root.card.name;
                color: Palette.text-strong;
                font-size: 13px;
                font-weight: 750;
                overflow: elide;
            }
            if root.card.description != "" : Text {
                text: root.card.description;
                color: Palette.muted;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}

component PlaylistTile inherits Rectangle {
    in property <PlaylistCardItem> card;

    vertical-stretch: 0;
    border-radius: 8px;
    background: tile-area.has-hover ? Palette.hover : Palette.raised;
    animate background { duration: 140ms; }

    tile-area := TouchArea {
        clicked => {
            if (root.card.is-smart) { Actions.set-view(root.card.id, "", "", ""); }
            else { Actions.set-view("Playlist", "", "", root.card.id); }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                if (root.card.is-smart) { Actions.play-view(root.card.id); }
                else { Actions.play-playlist(root.card.id); }
            }
        }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        tile := Rectangle {
            width: 100%;
            height: self.width;
            vertical-stretch: 0;
            border-radius: 6px;
            clip: true;
            background: root.card.is-smart
                ? (root.card.id == "Most Played" ? @linear-gradient(135deg, #ff5e36 0%, #f32759 60%, #890b50 100%)
                    : root.card.id == "With Lyrics" ? @linear-gradient(135deg, #8b5cf6 0%, #6366f1 60%, #1e1b4b 100%)
                    : root.card.id == "Videos" ? @linear-gradient(135deg, #3b82f6 0%, #1d4ed8 60%, #0f172a 100%)
                    : @linear-gradient(135deg, #10b981 0%, #06b6d4 60%, #134e4a 100%))
                : @linear-gradient(150deg, Palette.ga(root.card.gradient) 0%, Palette.gb(root.card.gradient) 100%);

            if !root.card.is-smart : Text {
                text: root.card.initials;
                color: #ffffffd0;
                font-size: 20px;
                font-weight: 800;
                letter-spacing: -0.5px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            if root.card.is-smart : Image {
                source: root.card.id == "Most Played" ? @image-url("../assets/icons/spark.svg")
                    : root.card.id == "With Lyrics" ? @image-url("../assets/icons/lyrics.svg")
                    : root.card.id == "Videos" ? @image-url("../assets/icons/disc.svg")
                    : @image-url("../assets/icons/refresh.svg");
                width: 36px;
                height: 36px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: #ffffff;
            }

            Rectangle {
                width: 38px;
                height: 38px;
                x: parent.width - self.width - 10px;
                y: parent.height - self.height - 10px;
                border-radius: 19px;
                background: State.accent;
                opacity: tile-area.has-hover ? 1.0 : 0.0;
                animate opacity { duration: 150ms; }

                Image {
                    source: @image-url("../assets/icons/play.svg");
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2 + 1px;
                    y: (parent.height - self.height) / 2;
                    colorize: Palette.accent-ink;
                }

                TouchArea {
                    clicked => {
                        if (root.card.is-smart) { Actions.play-view(root.card.id); }
                        else { Actions.play-playlist(root.card.id); }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 3px;
            min-width: 0px;
            Text {
                text: root.card.name;
                color: Palette.text-strong;
                font-size: 13px;
                font-weight: 750;
                overflow: elide;
            }
            Text {
                text: "\{root.card.track-count} songs";
                color: Palette.muted;
                font-size: 11px;
            }
            if root.card.is-smart : Text {
                text: root.card.description;
                color: Palette.muted-2;
                font-size: 10px;
                overflow: elide;
            }
        }
    }
}

component PlaylistsList inherits Rectangle {
    if State.search-playlists.length == 0 : EmptyState { text: "No matching playlists."; }
    if State.search-playlists.length > 0 : GridLayout {
        width: 100%;
        spacing: 14px;
        for card[index] in State.search-playlists : PlaylistTile {
            card: card;
            col: Math.mod(index, State.card-columns);
            row: index / State.card-columns;
        }
    }
}

component PlaylistsView inherits Rectangle {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 32px;
        spacing: 16px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 5px;
                Text {
                    text: "Playlists";
                    color: Palette.text;
                    font-size: 30px;
                    font-weight: 800;
                    letter-spacing: -0.65px;
                }
                Text {
                    text: "Your playlists are stored on this PC.";
                    color: Palette.muted;
                    font-size: 12px;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            ActionBtn {
                label: "Import M3U / M3U8";
                clicked => { Actions.import-m3u(); }
            }
            ActionBtn {
                label: "＋ New playlist";
                primary: true;
                clicked => { Actions.open-modal("new-playlist"); }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 24px;
                if State.smart-playlists.length > 0 : VerticalLayout {
                    spacing: 13px;
                    SectionTitle { text: "Smart playlists"; }
                    GridLayout {
                        width: 100%;
                        spacing: 14px;
                        for card[index] in State.smart-playlists : SmartPlaylistTile {
                            card: card;
                            col: Math.mod(index, State.card-columns);
                            row: index / State.card-columns;
                        }
                    }
                }
                VerticalLayout {
                    spacing: 13px;
                    SectionTitle { text: "Your playlists"; }
                    if State.playlists.length == 0 : EmptyState {
                        text: "No playlists yet. Create one from any track's menu.";
                    }
                    if State.playlists.length > 0 : GridLayout {
                        width: 100%;
                        spacing: 14px;
                        for card[index] in State.playlists : PlaylistTile {
                            card: card;
                            col: Math.mod(index, State.card-columns);
                            row: index / State.card-columns;
                        }
                    }
                }
            }
        }
    }
}


// ---- Playlist detail ---------------------------------------------------------
component PlaylistView inherits Rectangle {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 32px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 5px;
                horizontal-stretch: 1;
                Text {
                    text: State.playlist-name;
                    color: Palette.text;
                    font-size: 30px;
                    font-weight: 800;
                    letter-spacing: -0.65px;
                    overflow: elide;
                }
                if State.playlist-empty-message != "" : Text {
                    text: State.playlist-empty-message;
                    color: Palette.muted;
                    font-size: 12px;
                }
            }
            ActionBtn {
                label: "Play";
                primary: true;
                clicked => { Actions.play-playlist(State.view-playlist-id); }
            }
            ActionBtn {
                label: "Shuffle";
                clicked => { Actions.play-playlist-shuffle(State.view-playlist-id); }
            }
            ActionBtn {
                label: "Rename…";
                clicked => { Actions.open-modal("rename-playlist"); }
            }
            ActionBtn {
                label: "Export";
                clicked => { Actions.export-m3u(State.view-playlist-id); }
            }
            ActionBtn {
                label: "Delete";
                danger: true;
                clicked => { Actions.open-modal("delete-playlist"); }
            }
        }

        TrackTable {
            vertical-stretch: 1;
            show-added: false;
            show-year: false;
            first-column: "TITLE";
            show-remove: true;
            sort(column) => { Actions.sort-view(column); }
            empty-text: "This playlist is empty…";
        }
    }
}

// ---- Detail pages (Album / Artist / Genre / Folder) --------------------------
component DetailView inherits Rectangle {
    in property <string> eyebrow: "";
    in property <string> empty-text: "No tracks.";

    ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 32px;
            spacing: 24px;

            HeroDetail {
                eyebrow: root.eyebrow;
                title: State.view-group-value == "" ? State.view-title : State.view-group-value;
                subtitle: State.hero-subtitle;
                cover: State.hero-cover;
                has-cover: State.hero-has-cover;
                round: State.view-group-column == "artist";
                play => { Actions.play-group(State.view-group-column, State.view-group-value); }
                shuffle => { Actions.play-group-shuffle(State.view-group-column, State.view-group-value); }
            }

            if State.view-group-column == "artist" && State.artist-albums.length > 0 : VerticalLayout {
                spacing: 13px;
                Text {
                    text: "Albums";
                    color: Palette.text;
                    font-size: 19px;
                    font-weight: 750;
                    letter-spacing: -0.65px;
                }
                Rectangle {
                    height: 190px;
                    ListView {
                        for album in State.artist-albums : CardTile {
                            width: 150px;
                            item: album;
                            play => { Actions.play-group("album", album.name); }
                            open => { Actions.set-view("Album", "", album.name, ""); }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 13px;

                Text {
                    text: State.view-group-column == "artist" ? "Popular tracks" : "Tracks";
                    color: Palette.text;
                    font-size: 19px;
                    font-weight: 750;
                    letter-spacing: -0.65px;
                }

                TrackTable {
                    scrollable: false;
                    show-added: true;
                    show-year: false;
                    show-album: true;
                    first-column: "TITLE";
                    first-sort: State.view-group-column == "album" ? "TrackNumber" : (State.view-group-column == "artist" ? "PlayCount" : "Title");
                    sort(column) => { Actions.sort-view(column); }
                    empty-text: root.empty-text;
                }
            }
        }
    }
}

// ---- Search -----------------------------------------------------------------
component SearchSectionHeader inherits Rectangle {
    in property <string> title;
    in property <int> count: 0;
    in property <bool> show-see-all: true;
    callback see-all();

    height: 26px;
    HorizontalLayout {
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: Palette.text-strong;
                font-size: 19px;
                font-weight: 750;
                letter-spacing: -0.65px;
                vertical-alignment: center;
            }
            if root.count > 0 : Text {
                text: "\{root.count}";
                color: Palette.muted;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        if root.show-see-all : Rectangle {
            width: 56px;
            height: 26px;
            Text {
                text: "See all";
                color: see-all-area.has-hover ? Palette.text : Palette.muted;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
                animate color { duration: 100ms; }
            }
            see-all-area := TouchArea { clicked => { root.see-all(); } }
        }
    }
}

component SearchView inherits Rectangle {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 32px;
        spacing: 16px;

        // View Header: Title and subtitle matching WebUI
        VerticalLayout {
            spacing: 5px;
            Text {
                text: "Search";
                color: Palette.text;
                font-size: 30px;
                font-weight: 800;
                letter-spacing: -0.65px;
            }
            Text {
                text: State.view-search != ""
                    ? "Results in your local library for “\{State.view-search}”"
                    : "Find songs, artists, albums, and playlists.";
                color: Palette.muted;
                font-size: 12px;
            }
        }

        // Filter chips: All, Songs, Albums, Artists, Playlists (height 28px, border-radius 99px)
        if State.view-search != "" : HorizontalLayout {
            spacing: 6px;
            Chip {
                label: "All";
                active: State.search-filter == "all";
                clicked => { Actions.search(State.view-search, "all"); }
            }
            Chip {
                label: "Songs";
                active: State.search-filter == "song";
                clicked => { Actions.search(State.view-search, "song"); }
            }
            Chip {
                label: "Albums";
                active: State.search-filter == "album";
                clicked => { Actions.search(State.view-search, "album"); }
            }
            Chip {
                label: "Artists";
                active: State.search-filter == "artist";
                clicked => { Actions.search(State.view-search, "artist"); }
            }
            Chip {
                label: "Playlists";
                active: State.search-filter == "playlist";
                clicked => { Actions.search(State.view-search, "playlist"); }
            }
        }

        // Recent searches when query is empty
        if State.view-search == "" && State.recent-searches.length > 0 : VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                Text {
                    text: "Recent searches";
                    color: Palette.text-strong;
                    font-size: 19px;
                    font-weight: 750;
                    letter-spacing: -0.65px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                ActionBtn {
                    label: "Clear all";
                    clicked => { Actions.clear-recent-searches(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                for term in State.recent-searches : Rectangle {
                    height: 28px;
                    border-radius: 99px;
                    background: Palette.panel-2;
                    border-width: 1px;
                    border-color: Palette.border-soft;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        spacing: 6px;
                        alignment: center;

                        TouchArea {
                            clicked => { Actions.search(term, "all"); }
                            HorizontalLayout {
                                spacing: 4px;
                                Image {
                                    source: @image-url("../assets/icons/search.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: Palette.muted;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: term;
                                    color: Palette.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            close-area := TouchArea {
                                clicked => { Actions.remove-recent-search(term); }
                            }
                            Text {
                                text: "×";
                                color: close-area.has-hover ? #ff5b74 : Palette.muted;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Empty state when search query is empty
        if State.view-search == "" : EmptyState {
            vertical-stretch: 1;
            text: "Search your library";
            subtitle: "Type in the search field above to find songs, albums, and artists.";
        }

        // All results: sections with section headers and "See all" buttons
        if State.view-search != "" && State.search-filter == "all" : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 24px;

                // Songs table for matched songs
                if State.search-song-count > 0 : VerticalLayout {
                    spacing: 12px;
                    SearchSectionHeader {
                        title: "Songs";
                        count: State.search-song-count;
                        see-all => { Actions.search(State.view-search, "song"); }
                    }
                    TrackTable {
                        scrollable: false;
                        show-added: false;
                        first-column: "Title";
                        sort(column) => { Actions.sort-view(column); }
                        empty-text: "No matching songs.";
                    }
                }

                // Card grid for matched albums
                if State.search-album-count > 0 : VerticalLayout {
                    spacing: 12px;
                    SearchSectionHeader {
                        title: "Albums";
                        count: State.search-album-count;
                        see-all => { Actions.search(State.view-search, "album"); }
                    }
                    GroupGrid {
                        scrollable: false;
                        kind: "album";
                        items: State.search-albums;
                        show-load-more: false;
                        empty-text: "No matching albums.";
                    }
                }

                // Round avatar grid for matched artists
                if State.search-artist-count > 0 : VerticalLayout {
                    spacing: 12px;
                    SearchSectionHeader {
                        title: "Artists";
                        count: State.search-artist-count;
                        see-all => { Actions.search(State.view-search, "artist"); }
                    }
                    GroupGrid {
                        scrollable: false;
                        round: true;
                        kind: "artist";
                        items: State.search-artists;
                        show-load-more: false;
                        empty-text: "No matching artists.";
                    }
                }

                // Playlists grid
                if State.search-playlist-count > 0 : VerticalLayout {
                    spacing: 12px;
                    SearchSectionHeader {
                        title: "Playlists";
                        count: State.search-playlist-count;
                        see-all => { Actions.search(State.view-search, "playlist"); }
                    }
                    PlaylistsList { }
                }

                if State.search-song-count + State.search-album-count + State.search-artist-count + State.search-playlist-count == 0 : EmptyState {
                    text: "No results for “\{State.view-search}”";
                    subtitle: "Try another song, artist, album, or playlist name.";
                }
            }
        }

        // Filtered views
        if State.view-search != "" && State.search-filter == "song" : VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            SearchSectionHeader {
                title: "Songs";
                count: State.search-song-count;
                show-see-all: false;
            }
            TrackTable {
                vertical-stretch: 1;
                show-added: false;
                first-column: "Title";
                sort(column) => { Actions.sort-view(column); }
                empty-text: "No matching songs.";
            }
        }

        if State.view-search != "" && State.search-filter == "album" : VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            SearchSectionHeader {
                title: "Albums";
                count: State.search-album-count;
                show-see-all: false;
            }
            GroupGrid {
                vertical-stretch: 1;
                kind: "album";
                items: State.search-albums;
                empty-text: "No matching albums.";
            }
        }

        if State.view-search != "" && State.search-filter == "artist" : VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            SearchSectionHeader {
                title: "Artists";
                count: State.search-artist-count;
                show-see-all: false;
            }
            GroupGrid {
                vertical-stretch: 1;
                round: true;
                kind: "artist";
                items: State.search-artists;
                empty-text: "No matching artists.";
            }
        }

        if State.view-search != "" && State.search-filter == "playlist" : VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            SearchSectionHeader {
                title: "Playlists";
                count: State.search-playlist-count;
                show-see-all: false;
            }
            PlaylistsList {
                vertical-stretch: 1;
            }
        }
    }
}


// ---- Queue ------------------------------------------------------------------
component QueueRow inherits Rectangle {
    in property <QueueItem> item;
    in property <int> index: 0;

    callback play();
    callback move-up();
    callback move-down();
    callback remove();

    height: 52px;
    border-radius: 6px;
    background: row-area.has-hover ? Palette.panel-2 : (root.item.is-current ? Palette.border-soft : transparent);
    animate background { duration: 100ms; }

    row-area := TouchArea {
        clicked => { root.play(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                Actions.open-context-menu(root.item.id, round((root.absolute-position.x + row-area.mouse-x) / 1px), round((root.absolute-position.y + row-area.mouse-y) / 1px));
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Rectangle {
            width: 38px;
            height: 38px;
            border-radius: 4px;
            clip: true;
            background: root.item.badge-bg;
            y: (parent.height - self.height) / 2;
            if root.item.has-cover : Image {
                source: root.item.cover;
                width: parent.width;
                height: parent.height;
                image-fit: ImageFit.cover;
            }
            if !root.item.has-cover : Text {
                text: root.item.initials;
                color: Palette.text;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.item.unavailable ? "\{root.item.title} (unavailable)" : root.item.title;
                color: root.item.is-current ? State.accent : (root.item.unavailable ? #ff5b74 : Palette.text-strong);
                font-size: 11px;
                overflow: elide;
            }
            Text {
                text: root.item.artist;
                color: Palette.muted;
                font-size: 10px;
                overflow: elide;
            }
        }

        Text {
            text: root.item.duration;
            color: Palette.muted;
            font-size: 10px;
            width: 48px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        VerticalLayout {
            width: 76px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                spacing: 0px;
                if !root.item.is-current : IcBtn {
                    icon: @image-url("../assets/icons/chevron-left.svg");
                    icon-size: 12px;
                    tint: Palette.muted-2;
                    clicked => { root.move-up(); }
                }
                if !root.item.is-current : IcBtn {
                    icon: @image-url("../assets/icons/chevron-right.svg");
                    icon-size: 12px;
                    tint: Palette.muted-2;
                    clicked => { root.move-down(); }
                }
                if !root.item.is-current : IcBtn {
                    icon: @image-url("../assets/icons/close.svg");
                    icon-size: 12px;
                    tint: Palette.muted-2;
                    hover-tint: #ff5b74;
                    clicked => { root.remove(); }
                }
            }
        }
    }
}

export component QueueView inherits Rectangle {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 32px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 5px;
                horizontal-stretch: 1;
                Text {
                    text: "Playback queue";
                    color: Palette.text;
                    font-size: 30px;
                    font-weight: 800;
                    letter-spacing: -0.65px;
                }
                Text {
                    text: "\{State.queue-count} upcoming tracks";
                    color: Palette.muted;
                    font-size: 12px;
                }
            }
            if State.queue-count > 0 : ActionBtn {
                label: "Clear upcoming";
                danger: true;
                clicked => { Actions.clear-queue(); }
            }
        }

        if State.queue-items.length > 0 : ListView {
            for row[index] in State.queue-items : QueueRow {
                item: row;
                index: index;
                play => { Actions.play-queue-entry(row.queue-index); }
                move-up => { Actions.queue-move(row.queue-index, row.queue-index - 1); }
                move-down => { Actions.queue-move(row.queue-index, row.queue-index + 1); }
                remove => { Actions.queue-remove(row.queue-index); }
            }
        }
        if State.queue-items.length == 0 : EmptyState {
            vertical-stretch: 1;
            text: "Queue is empty. Songs you add will appear here.";
        }
        if State.queue-more-count > 0 : ActionBtn {
            label: "Load more queued tracks (\{State.queue-more-count} remaining)";
            clicked => { Actions.load-more-queue(); }
        }
    }
}


// ---- Now Playing --------------------------------------------------------------
component NowPlayingView inherits Rectangle {
    if State.has-track : HorizontalLayout {
        padding: 28px;
        spacing: 28px;

        VerticalLayout {
            width: State.window-width <= 700 ? 110px : 190px;
            alignment: start;
            spacing: 16px;

            Rectangle {
                height: self.width;
                border-radius: 8px;
                clip: true;
                background: Palette.panel-2;
                if State.current-has-cover : Image {
                    source: State.current-cover;
                    width: parent.width;
                    height: parent.height;
                    image-fit: ImageFit.cover;
                }
                if !State.current-has-cover : Text {
                    text: State.current-initials;
                    color: Palette.text;
                    font-size: 34px;
                    font-weight: 900;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 14px;
            horizontal-stretch: 1;

            Text {
                text: "Now Playing";
                color: State.accent;
                font-size: 10px;
                font-weight: 700;
            }
            Text {
                text: State.current-title;
                color: Palette.text;
                font-size: 30px;
                font-weight: 800;
                overflow: elide;
            }
            Text {
                text: State.current-artist;
                color: Palette.muted;
                font-size: 14px;
                overflow: elide;
            }
            Text {
                text: State.current-album;
                color: Palette.muted-2;
                font-size: 12px;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                IcBtn {
                    icon: State.current-favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                    tint: State.current-favorite ? State.accent : Palette.muted;
                    clicked => { Actions.toggle-favorite(State.current-id); }
                }
                ActionBtn {
                    label: "Track details";
                    clicked => { Actions.open-details(State.current-id); }
                }
                ActionBtn {
                    label: "Show in folder";
                    clicked => { Actions.open-file-location(State.current-id); }
                }
                ActionBtn {
                    label: "Lyrics";
                    clicked => { Actions.set-view("Lyrics", "", "", ""); }
                }
            }
        }
    }
    if !State.has-track : EmptyState {
        text: "Nothing is playing.";
    }
}

// ---- Lyrics ------------------------------------------------------------------
component LyricsView inherits Rectangle {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 32px;
        spacing: 12px;

        if State.has-track : HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 5px;
                horizontal-stretch: 1;
                Text {
                    text: "Lyrics";
                    color: Palette.text;
                    font-size: 30px;
                    font-weight: 800;
                    letter-spacing: -0.65px;
                }
                Text {
                    text: "\{State.current-title} · \{State.current-artist}" + (State.lyrics-source != "" ? " · " + (State.lyrics-source == "sidecar" ? "Sidecar file" : (State.lyrics-source == "embedded" ? "Embedded tags" : "LRCLIB")) : "");
                    color: Palette.muted;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            ActionBtn {
                label: "Find lyrics…";
                clicked => { Actions.open-find-lyrics(State.current-id); }
            }
            ActionBtn {
                label: "Edit lyrics…";
                clicked => { Actions.open-edit-lyrics(); }
            }
        }

        if !State.has-track : EmptyState {
            text: "Choose a song to view lyrics.";
        }

        if State.has-track && State.has-lyrics : Rectangle {
            vertical-stretch: 1;
            clip: true;
            Flickable {
                content-y: min(0px, - State.lyrics-active-line * 64px + parent.height * 0.42);
                animate content-y { duration: 250ms; easing: ease-out; }

                VerticalLayout {
                    for line[index] in State.lyrics-lines : TouchArea {
                        height: 64px;
                        clicked => {
                            if (State.lyrics-timed && State.seek-from-lyrics) {
                                Actions.seek-to-lyric(index);
                            }
                        }
                        Text {
                            text: line.text;
                            color: line.is-active ? Palette.text : (line.is-past || line.is-upcoming ? Palette.muted : Palette.muted-2);
                            font-size: line.is-active ? 23px : 20px;
                            font-weight: 650;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            x: max(12px, (parent.width - min(parent.width - 24px, 720px)) / 2);
                            width: min(parent.width - 24px, 720px);
                            wrap: word-wrap;
                            animate color { duration: 200ms; }
                        }
                    }
                }
            }
            if State.lyrics-scroll-paused : Rectangle {
                x: parent.width - 62px;
                y: parent.height - 62px;
                width: 38px;
                height: 38px;
                border-radius: 19px;
                border-width: 1px;
                border-color: State.accent.with-alpha(0.5);
                background: Palette.raised;
                Image {
                    source: @image-url("../assets/icons/sync.svg");
                    width: 18px;
                    height: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: State.accent;
                }
                TouchArea { clicked => { Actions.lyrics-scroll-changed(false); } }
            }
        }
        if State.has-track && !State.has-lyrics : VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 12px;
            Text { text: State.lyrics-searching ? "Finding lyrics…" : "No lyrics found"; color: Palette.text; font-size: 15px; font-weight: 750; horizontal-alignment: center; }
            Text { text: State.lyrics-searching ? "Searching LRCLIB for a match to this track." : "Lyrics saved in the audio file or beside it load automatically. You can also search online."; color: Palette.muted; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
        }
    }
}

// ---- Audio (equalizer) --------------------------------------------------------
export component AudioView inherits Rectangle {
    ScrollView {
        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 32px;
            spacing: 20px;

            VerticalLayout {
                spacing: 5px;
                Text { text: "Equalizer"; color: Palette.text; font-size: 30px; font-weight: 800; letter-spacing: -0.65px; }
                Text { text: "Output, playback transitions, and equalizer."; color: Palette.muted; font-size: 12px; }
            }

            VerticalLayout {
                spacing: 8px;
                SectionTitle { text: "Volume"; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { width: 120px; Text { text: "Output level"; color: Palette.text-strong; font-size: 11px; vertical-alignment: center; } }
                    PlayerSlider {
                        horizontal-stretch: 1;
                        minimum: 0.0;
                        maximum: 100.0;
                        value: State.volume;
                        scroll-step: 4.0;
                        changed(val) => { Actions.volume-changed(round(val)); }
                    }
                    Text { text: "\{State.volume}%"; color: Palette.muted; width: 42px; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; }
                    ActionBtn { label: State.volume == 0 ? "Unmute" : "Mute"; clicked => { Actions.set-volume-muted(); } }
                }
                Text { text: "Volume is shared with Windows media controls."; color: Palette.muted; font-size: 10px; }
            }

            VerticalLayout {
                spacing: 8px;
                SectionTitle { text: "Audio output"; }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Device"; color: Palette.text-strong; font-size: 11px; vertical-alignment: center; width: 120px; }
                    if State.output-devices.length > 0 : ComboBox {
                        horizontal-stretch: 1;
                        model: State.output-devices;
                        current-value: State.output-device;
                        selected(value) => { Actions.set-output-device(value); }
                    }
                    if State.output-devices.length == 0 : Text {
                        text: "No audio output devices are available. Connect a device and refresh.";
                        color: Palette.muted;
                        font-size: 10px;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    ActionBtn {
                        label: "Refresh";
                        clicked => { Actions.refresh-audio-devices(); }
                    }
                }
            }

            VerticalLayout {
                spacing: 8px;
                SectionTitle { text: "Playback transition"; }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Crossfade"; color: Palette.text-strong; font-size: 11px; vertical-alignment: center; width: 120px; }
                    ComboBox {
                        width: 180px;
                        model: ["Off", "2 s", "3 s", "5 s", "8 s", "10 s"];
                        current-value: State.crossfade-label;
                        selected(value) => { Actions.set-crossfade-label(value); }
                    }
                    Text { text: "Blend into the next track."; color: Palette.muted; font-size: 10px; vertical-alignment: center; }
                }
            }

            VerticalLayout {
                spacing: 12px;
                SectionTitle { text: "10-band equalizer"; }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Preset"; color: Palette.text-strong; font-size: 11px; vertical-alignment: center; width: 120px; }
                    ComboBox {
                        width: 220px;
                        model: State.eq-presets;
                        current-value: State.eq-preset;
                        selected(value) => { Actions.set-eq-preset(value); }
                    }
                    ActionBtn { label: "Save preset…"; clicked => { Actions.open-modal("save-preset"); } }
                    ActionBtn { label: "Reset"; clicked => { Actions.set-eq-preset("Off"); } }
                }

                Rectangle {
                    border-radius: 12px;
                    background: Palette.raised;
                    HorizontalLayout {
                        padding: 16px;
                        spacing: 8px;
                        alignment: start;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Preamp"; color: Palette.muted; font-size: 10px; horizontal-alignment: center; }
                            Rectangle {
                                width: 44px;
                                height: 220px;
                                Slider {
                                    y: 10px;
                                    height: parent.height - 20px;
                                    width: parent.width;
                                    orientation: Orientation.vertical;
                                    minimum: -12.0;
                                    maximum: 12.0;
                                    value: State.eq-preamp;
                                    changed value => { Actions.set-eq-preamp(self.value); }
                                }
                                Text { text: "\{round(State.eq-preamp)}dB"; y: parent.height - 16px; width: parent.width; color: Palette.muted-2; font-size: 9px; horizontal-alignment: center; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            for band[index] in State.eq-bands : VerticalLayout {
                                spacing: 4px;
                                Text { text: band.label; color: Palette.muted; font-size: 9px; horizontal-alignment: center; }
                                Rectangle {
                                    width: 36px;
                                    height: 220px;
                                    Slider {
                                        y: 10px;
                                        height: parent.height - 20px;
                                        width: parent.width;
                                        orientation: Orientation.vertical;
                                        minimum: -12.0;
                                        maximum: 12.0;
                                        value: band.value;
                                        changed value => { Actions.set-eq-band(index, self.value); }
                                    }
                                    Text { text: "\{round(band.value)}"; y: parent.height - 16px; width: parent.width; color: Palette.muted-2; font-size: 9px; horizontal-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---- Settings ----------------------------------------------------------------
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    height: 52px;

    VerticalLayout {
        alignment: center;
        spacing: 3px;
        Text {
            text: root.label;
            color: Palette.text-strong;
            font-size: 12px;
            font-weight: 700;
        }
        if root.description != "" : Text {
            text: root.description;
            color: Palette.muted;
            font-size: 10px;
            overflow: elide;
        }
    }
}

component SettingSwitchRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <bool> checked: false;
    callback toggled(bool);

    height: 52px;
    HorizontalLayout {
        spacing: 18px;
        SettingRow {
            label: root.label;
            description: root.description;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            CustomToggle {
                checked: root.checked;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.border;
    }
}

component SettingComboRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <[string]> options;
    in property <string> value;
    callback changed(string);

    height: 52px;
    HorizontalLayout {
        spacing: 18px;
        SettingRow {
            label: root.label;
            description: root.description;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            ComboBox {
                width: 170px;
                model: root.options;
                current-value: root.value;
                selected(value) => { root.changed(value); }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.border;
    }
}

component SettingsNavTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    horizontal-stretch: 1;
    min-width: 48px;
    height: 38px;
    border-radius: 8px;
    background: area.pressed ? #222622 : (root.selected ? #222622 : (area.has-hover ? #222622 : transparent));
    animate background { duration: 110ms; }
    area := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: root.selected ? Palette.text : Palette.muted;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component SettingColorRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <string> value;
    in property <color> swatch;
    in property <bool> enabled: true;
    in property <string> setting;
    height: 56px;

    HorizontalLayout {
        spacing: 12px;
        SettingRow { label: root.label; description: root.description; horizontal-stretch: 1; }
        Rectangle {
            width: 34px;
            height: 30px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Palette.border;
            background: root.swatch;
        }
        LineEdit {
            width: 100px;
            text: root.value;
            enabled: root.enabled;
            accepted(value) => { Actions.set-setting(root.setting, value); }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
}

component SettingSliderRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <int> value;
    in property <int> minimum;
    in property <int> maximum;
    in property <string> suffix: "px";
    in property <string> setting;
    in property <bool> enabled: true;
    height: 58px;
    HorizontalLayout {
        spacing: 14px;
        SettingRow { label: root.label; description: root.description; horizontal-stretch: 1; }
        Slider {
            width: 180px;
            minimum: root.minimum;
            maximum: root.maximum;
            value: root.value;
            enabled: root.enabled;
            changed value => { Actions.set-setting(root.setting, round(self.value)); }
        }
        Text {
            text: "\{root.value}\{root.suffix}";
            color: Palette.muted;
            font-size: 10px;
            width: 44px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
}

component SettingNavOrderRow inherits Rectangle {
    in property <NavSettingItem> item;
    height: 48px;
    HorizontalLayout {
        spacing: 9px;
        Text {
            text: root.item.view;
            color: Palette.text-subtle;
            font-size: 11px;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.item.always-visible && root.item.can-move-up : TextBtn {
            label: "↑";
            clicked => { Actions.move-navigation(root.item.view, -1); }
        }
        if !root.item.always-visible && root.item.can-move-down : TextBtn {
            label: "↓";
            clicked => { Actions.move-navigation(root.item.view, 1); }
        }
        if root.item.always-visible : Text {
            text: "Always shown";
            color: Palette.muted-2;
            font-size: 9px;
            vertical-alignment: center;
        }
        if !root.item.always-visible : CustomToggle {
            checked: !root.item.hidden;
            toggled(v) => { Actions.toggle-navigation(root.item.view); }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
}

component SettingsView inherits Rectangle {
    VerticalLayout {
        padding: 18px;
        spacing: 11px;

        VerticalLayout {
            spacing: 3px;
            Text { text: "Settings"; color: Palette.text; font-size: 22px; font-weight: 800; }
            Text { text: "Choose how Music Player looks and behaves."; color: Palette.muted; font-size: 11px; }
        }

        // Sidebar/Tabs: "General", "Appearance", "Library", "Playback", "Audio", "Shortcuts", "About".
        Rectangle {
            height: 52px;
            border-radius: 8px;
            background: Palette.raised;
            HorizontalLayout {
                padding: 7px;
                spacing: 4px;
                SettingsNavTab { label: "General"; selected: State.settings-section == "General"; clicked => { State.settings-section = "General"; } }
                SettingsNavTab { label: "Appearance"; selected: State.settings-section == "Appearance"; clicked => { State.settings-section = "Appearance"; } }
                SettingsNavTab { label: "Library"; selected: State.settings-section == "Library"; clicked => { State.settings-section = "Library"; } }
                SettingsNavTab { label: "Playback"; selected: State.settings-section == "Playback"; clicked => { State.settings-section = "Playback"; } }
                SettingsNavTab { label: "Audio"; selected: false; clicked => { Actions.set-view("Audio", "", "", ""); } }
                SettingsNavTab { label: "Shortcuts"; selected: State.settings-section == "Shortcuts"; clicked => { State.settings-section = "Shortcuts"; } }
                SettingsNavTab { label: "About"; selected: State.settings-section == "About"; clicked => { State.settings-section = "About"; } }
            }
        }

        // Settings panel container: padding 20px, background #171917 (Palette.raised), border-radius 8px.
        Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            background: Palette.raised;
            clip: true;
            settings-scroll := ScrollView {
                content-y: (State.settings-section == "General" || State.settings-section == "Advanced") ? -general-section.y
                    : State.settings-section == "Appearance" ? -appearance-section.y
                    : State.settings-section == "Library" ? -library-section.y
                    : State.settings-section == "Playback" ? -playback-section.y
                    : State.settings-section == "Shortcuts" ? -shortcuts-section.y
                    : State.settings-section == "About" ? -about-section.y
                    : 0px;
                animate content-y { duration: 200ms; easing: ease-out; }
                VerticalLayout {
                    padding: 20px;
                    spacing: 24px;

                    general-section := VerticalLayout {
                        spacing: 0px;
                        Text { text: "General"; color: Palette.text; font-size: 15px; font-weight: 750; }
                        Text { text: "Application behavior, navigation, and diagnostics."; color: Palette.muted; font-size: 10px; }
                        Rectangle { height: 8px; }
                        SettingSwitchRow {
                            label: "Keep running in notification area";
                            description: "Closing the window keeps Music Player and playback running. Use the tray icon to reopen.";
                            checked: State.minimize-to-tray;
                            toggled(value) => { Actions.set-setting("minimize-to-tray", value ? "true" : "false"); }
                        }
                        SettingSliderRow {
                            label: "Navigation width";
                            description: "Expanded sidebar width in logical pixels.";
                            value: State.navigation-width;
                            minimum: 180;
                            maximum: 360;
                            setting: "navigation-width";
                        }
                        SettingSliderRow {
                            label: "Browse grid spacing";
                            description: "Spacing between album, artist, and playlist tiles.";
                            value: State.browse-width;
                            minimum: 180;
                            maximum: 480;
                            setting: "browse-width";
                        }
                        SettingSliderRow {
                            label: "Now Playing panel width";
                            description: "Width of the resizable queue and track information panel.";
                            value: State.right-panel-width;
                            minimum: 240;
                            maximum: 460;
                            setting: "right-panel-width";
                        }
                        Rectangle { height: 8px; }
                        HorizontalLayout {
                            spacing: 8px;
                            ActionBtn { label: "Choose default music player"; clicked => { Actions.open-default-apps(); } }
                            ActionBtn { label: "Open logs"; clicked => { Actions.open-log-folder(); } }
                            ActionBtn { label: "Export logs"; clicked => { Actions.export-logs(); } }
                        }
                        Rectangle { height: 6px; }
                        SectionTitle { text: "Navigation order and visibility"; }
                        Text { text: "Drag the grip or use the arrows to reorder. Use the switch to hide a destination."; color: Palette.muted; font-size: 10px; wrap: word-wrap; }
                        VerticalLayout {
                            spacing: 0px;
                            for item in State.navigation-settings : SettingNavOrderRow { item: item; }
                        }
                    }

                    appearance-section := VerticalLayout {
                        spacing: 0px;
                        Text { text: "Appearance"; color: Palette.text; font-size: 15px; font-weight: 750; }
                        Text { text: "Match the player to your desktop."; color: Palette.muted; font-size: 10px; }
                        Rectangle { height: 8px; }
                        SettingComboRow {
                            label: "Color theme";
                            description: "System, light, or dark.";
                            options: ["System", "Light", "Dark"];
                            value: State.theme;
                            changed(value) => { Actions.set-setting("theme", value); }
                        }
                        HorizontalLayout {
                            height: 52px;
                            spacing: 18px;
                            SettingRow { label: "Accent style"; description: "Keep the Music Player lime or use color from album artwork."; horizontal-stretch: 1; }
                            HorizontalLayout {
                                spacing: 6px;
                                TextBtn { label: "Lime"; primary: State.accent-mode == "Native"; clicked => { Actions.set-setting("accent-mode", "Native"); } }
                                TextBtn { label: "Album artwork"; primary: State.accent-mode == "Artwork"; clicked => { Actions.set-setting("accent-mode", "Artwork"); } }
                            }
                        }
                        Rectangle { height: 1px; background: Palette.border; }
                        SettingSwitchRow {
                            label: "Use a custom accent";
                            description: "Choose a color for active controls.";
                            checked: State.accent-manual-enabled;
                            toggled(value) => { Actions.set-setting("accent-manual", value ? "true" : "false"); }
                        }
                        SettingColorRow {
                            label: "Custom accent color";
                            description: "Applied to controls when enabled; artwork still colors the interface.";
                            value: State.accent-color;
                            swatch: State.accent-manual;
                            enabled: State.accent-manual-enabled;
                            setting: "accent-color";
                        }
                        SettingComboRow {
                            label: "Text selection color";
                            description: "Follow the active theme accent or choose your own.";
                            options: ["Theme", "Custom"];
                            value: State.selection-color-mode;
                            changed(value) => { Actions.set-setting("selection-color-mode", value); }
                        }
                        SettingColorRow {
                            label: "Custom selection color";
                            description: "Used when text selection is set to Custom.";
                            value: State.selection-color;
                            swatch: State.selection-color-value;
                            enabled: State.selection-color-mode == "Custom";
                            setting: "selection-color";
                        }
                        SettingSwitchRow {
                            label: "Transparent window";
                            description: "Show the desktop behind the player. Off by default.";
                            checked: State.transparent-window;
                            toggled(value) => { Actions.set-setting("transparent-window", value ? "true" : "false"); }
                        }
                        SettingSliderRow {
                            label: "Window transparency";
                            description: "0% is opaque. The player always remains at least 40% solid.";
                            value: State.window-transparency;
                            minimum: 0;
                            maximum: 60;
                            enabled: State.transparent-window;
                            suffix: "%";
                            setting: "window-transparency";
                        }
                        SettingComboRow {
                            label: "Navigation motion";
                            description: "Respect accessibility animation preferences.";
                            options: ["Off", "Subtle", "Expressive"];
                            value: State.motion-style;
                            changed(value) => { Actions.set-setting("motion-style", value); }
                        }
                        HorizontalLayout {
                            height: 52px;
                            spacing: 18px;
                            SettingRow { label: "Accent presets"; description: "Quick choices for the custom accent."; horizontal-stretch: 1; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                for preset in ["Lime", "Sky", "Violet", "Rose", "Amber"] : Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 12px;
                                    border-width: State.accent-preset-name == preset ? 2px : 0px;
                                    border-color: #ffffff;
                                    background: preset == "Sky" ? #59d7ff : (preset == "Violet" ? #a878ff : (preset == "Rose" ? #ff6e91 : (preset == "Amber" ? #ffb04a : #b7ff2d)));
                                    TouchArea { clicked => { Actions.set-accent-preset(preset); } }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Palette.border; }
                        Rectangle { height: 10px; }
                        ActionBtn { label: "Reset UI settings…"; clicked => { Actions.open-modal("reset"); } }
                    }

                    library-section := VerticalLayout {
                        spacing: 0px;
                        Text { text: "Library"; color: Palette.text; font-size: 15px; font-weight: 750; }
                        Text { text: "Local folders and indexed tracks."; color: Palette.muted; font-size: 10px; }
                        Rectangle { height: 8px; }
                        HorizontalLayout {
                            height: 52px;
                            SettingRow { label: "Indexed library"; description: "Total size of tracks currently indexed."; horizontal-stretch: 1; }
                            Text { text: State.indexed-library-size; color: Palette.text; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                        }
                        Rectangle { height: 1px; background: Palette.border; }
                        SettingSwitchRow {
                            label: "Hide exact duplicates";
                            description: "Hide verified identical files in song, album, artist, genre, and folder views. Explicit queue and playlist entries are retained.";
                            checked: State.hide-exact-duplicates;
                            toggled(value) => { Actions.set-setting("hide-exact-duplicates", value ? "true" : "false"); }
                        }
                        SectionTitle { text: "Song columns"; }
                        SettingSwitchRow { label: "Artwork"; description: "Show this column when the window is wide enough."; checked: State.show-list-artwork; toggled(value) => { Actions.set-setting("show-list-artwork", value ? "true" : "false"); } }
                        SettingSwitchRow { label: "Artist"; description: "Show this column when the window is wide enough."; checked: State.show-list-artist; toggled(value) => { Actions.set-setting("show-list-artist", value ? "true" : "false"); } }
                        SettingSwitchRow { label: "Album"; description: "Show this column when the window is wide enough."; checked: State.show-list-album; toggled(value) => { Actions.set-setting("show-list-album", value ? "true" : "false"); } }
                        SettingSwitchRow { label: "Added date"; description: "Show this column when the window is wide enough."; checked: State.show-list-added; toggled(value) => { Actions.set-setting("show-list-added", value ? "true" : "false"); } }
                        SettingSwitchRow { label: "Year"; description: "Show this column when the window is wide enough."; checked: State.show-list-year; toggled(value) => { Actions.set-setting("show-list-year", value ? "true" : "false"); } }
                        SettingSwitchRow { label: "Duration"; description: "Show this column when the window is wide enough."; checked: State.show-list-duration; toggled(value) => { Actions.set-setting("show-list-duration", value ? "true" : "false"); } }
                        SettingSwitchRow { label: "Favorite button"; description: "Show favorite hearts in song rows."; checked: State.show-list-favorite; toggled(value) => { Actions.set-setting("show-list-favorite", value ? "true" : "false"); } }

                        SectionTitle { text: "Monitored Folders"; }
                        Text { text: "Music Player automatically monitors these folders for new, updated, and deleted tracks."; color: Palette.muted; font-size: 10px; }
                        Rectangle { height: 6px; }
                        HorizontalLayout {
                            spacing: 8px;
                            ActionBtn { label: "Add folder…"; primary: true; clicked => { Actions.pick-library-root(); } }
                            ActionBtn { label: "Rescan library"; clicked => { Actions.scan-library(); } }
                        }
                        Rectangle { height: 6px; }
                        if State.folder-roots.length == 0 : Text {
                            text: "No music folders added yet. Add a folder to scan your local collection.";
                            color: Palette.muted;
                            font-size: 11px;
                        }
                        for rootEntry in State.folder-roots : Rectangle {
                            height: 48px;
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/icons/folder.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: State.accent;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: rootEntry.path;
                                        color: Palette.text-strong;
                                        font-size: 11px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: rootEntry.is-available ? "Available" : "Unavailable — reconnect this drive.";
                                        color: rootEntry.is-available ? Palette.muted : #ffb04a;
                                        font-size: 9px;
                                    }
                                }
                                ActionBtn {
                                    label: "Remove";
                                    danger: true;
                                    clicked => { Actions.confirm-remove-root(rootEntry.path); }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                        }

                        SectionTitle { text: "Scan exclusions"; }
                        Text { text: "Audio files are included by default. Video files are off until enabled. Playback depends on codec support."; color: Palette.muted; font-size: 10px; }
                        Rectangle { height: 6px; }
                        for ext in State.exclusion-extensions : Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: center;
                                Text {
                                    text: ext.extension;
                                    color: Palette.text-strong;
                                    font-size: 11px;
                                    font-weight: 700;
                                    width: 70px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: ext.kind + (ext.enabled ? " file · included in scans" : " file · excluded from scans");
                                    color: ext.enabled ? Palette.text-subtle : Palette.muted;
                                    font-size: 10px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                CustomToggle {
                                    checked: ext.enabled;
                                    toggled(v) => { Actions.set-extension-enabled(ext.extension, v); }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                        }
                        Rectangle { height: 6px; }
                        HorizontalLayout {
                            spacing: 10px;
                            LineEdit {
                                width: 120px;
                                height: 30px;
                                placeholder-text: ".mkv";
                                text <=> State.exclusion-new-extension;
                            }
                            ComboBox {
                                width: 110px;
                                model: ["Audio", "Video"];
                                current-value: State.exclusion-new-kind;
                                selected(value) => { State.exclusion-new-kind = value; }
                            }
                            ActionBtn {
                                label: "Add file type";
                                clicked => { Actions.add-extension(); }
                            }
                        }

                        SectionTitle { text: "Library maintenance"; }
                        HorizontalLayout {
                            spacing: 8px;
                            ActionBtn { label: "Find duplicates"; clicked => { Actions.set-view("Duplicates", "", "", ""); } }
                            ActionBtn { label: "Scan library"; clicked => { Actions.scan-library(); } }
                            ActionBtn { label: "Rebuild index"; clicked => { Actions.rebuild-library-index(); } }
                        }
                        Rectangle { height: 4px; }
                        Text {
                            text: "Rebuilding refreshes artwork and removes files confirmed missing from reachable locations. Confirmed deletions are removed from playlists, the queue and saved history. Offline drives are retained and hidden until they reconnect.";
                            color: Palette.muted;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                    }

                    playback-section := VerticalLayout {
                        spacing: 0px;
                        Text { text: "Playback"; color: Palette.text; font-size: 15px; font-weight: 750; }
                        Text { text: "Keep playback state and the queue easy to reach."; color: Palette.muted; font-size: 10px; }
                        Rectangle { height: 8px; }
                        SettingSwitchRow {
                            label: "Autoplay similar music";
                            description: "Automatically queue and play songs from similar genres, artists, and favorites when playback ends.";
                            checked: State.autoplay-similar;
                            toggled(value) => { Actions.set-setting("autoplay-similar", value ? "true" : "false"); }
                        }
                        SettingSwitchRow {
                            label: "Open the Now Playing pane when a song starts";
                            description: "Show the current track and upcoming queue.";
                            checked: State.auto-open-side-panel;
                            toggled(value) => { Actions.set-setting("auto-open-side-panel", value ? "true" : "false"); }
                        }
                        SettingSwitchRow {
                            label: "Automatically find lyrics";
                            description: "If no saved lyrics exist, look for a likely LRCLIB match when playback starts. Sends the track title and artist; manual search remains available.";
                            checked: State.auto-load-lyrics;
                            toggled(value) => { Actions.set-setting("auto-load-lyrics", value ? "true" : "false"); }
                        }
                        SettingSwitchRow {
                            label: "Seek when selecting a lyric line";
                            description: "Jump playback to a timed lyric. Plain, untimed lyrics cannot seek.";
                            checked: State.seek-from-lyrics;
                            toggled(value) => { Actions.set-setting("seek-from-lyrics", value ? "true" : "false"); }
                        }
                        Rectangle { height: 10px; }
                        ActionBtn { label: "Equalizer and audio output"; clicked => { Actions.set-view("Audio", "", "", ""); } }
                    }

                    shortcuts-section := VerticalLayout {
                        spacing: 0px;
                        Text { text: "Shortcuts"; color: Palette.text; font-size: 15px; font-weight: 750; }
                        Text { text: "Keyboard shortcuts for quick playback and navigation control."; color: Palette.muted; font-size: 10px; }
                        Rectangle { height: 8px; }
                        for sc in [
                            { key: "Space", desc: "Play or pause playback" },
                            { key: "Left Arrow", desc: "Seek backward 5 seconds" },
                            { key: "Right Arrow", desc: "Seek forward 5 seconds" },
                            { key: "Up Arrow", desc: "Increase volume 5%" },
                            { key: "Down Arrow", desc: "Decrease volume 5%" },
                            { key: "M", desc: "Toggle mute audio" },
                            { key: "S", desc: "Toggle shuffle mode" },
                            { key: "R", desc: "Cycle repeat mode (Off / All / Track)" },
                            { key: "Escape", desc: "Close dialogs, menus, or full-screen player" }
                        ] : Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                spacing: 16px;
                                alignment: center;
                                Rectangle {
                                    width: 100px;
                                    height: 28px;
                                    border-radius: 6px;
                                    background: Palette.control;
                                    border-width: 1px;
                                    border-color: Palette.border;
                                    Text {
                                        text: sc.key;
                                        color: Palette.text-strong;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: sc.desc;
                                    color: Palette.text-subtle;
                                    font-size: 11px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                        }
                    }

                    about-section := VerticalLayout {
                        spacing: 8px;
                        Text { text: "About Music Player"; color: Palette.text; font-size: 15px; font-weight: 750; }
                        Text { text: "A local music library and player for Windows."; color: Palette.muted; font-size: 10px; }
                        HorizontalLayout {
                            height: 50px;
                            spacing: 12px;
                            Text { text: "Music Player"; color: Palette.text; font-size: 18px; font-weight: 800; vertical-alignment: center; }
                            Text { text: State.about-rows.length > 0 ? State.about-rows[0].value : "Version unavailable"; color: Palette.muted; font-size: 10px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            ActionBtn { label: "View repository"; clicked => { Actions.open-url("https://github.com/kalabhaftu/music-player"); } }
                        }
                        HorizontalLayout {
                            height: 56px;
                            SettingRow { label: "Latest release"; description: State.update-tag == "" ? "Check GitHub for the latest published version." : "GitHub release \{State.update-tag} · updates are never installed automatically."; horizontal-stretch: 1; }
                            ActionBtn { label: "View release history"; clicked => { Actions.open-release(); } }
                        }
                        SettingSwitchRow {
                            label: "Check for updates automatically";
                            description: "Checks GitHub release metadata every six hours; installs are always manual.";
                            checked: State.check-updates;
                            toggled(value) => { Actions.set-setting("check-updates", value ? "true" : "false"); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            ActionBtn { label: "Open logs"; clicked => { Actions.open-log-folder(); } }
                            ActionBtn { label: "MIT license"; clicked => { Actions.open-url("https://github.com/kalabhaftu/music-player/blob/main/LICENSE"); } }
                            ActionBtn { label: "Third-party notices"; clicked => { Actions.open-url("https://github.com/kalabhaftu/music-player/blob/main/ThirdPartyNotices.md"); } }
                        }
                        SectionTitle { text: "Privacy and network use"; }
                        Text {
                            text: "Your music library stays on this device. Manual checks, and automatic checks when enabled, contact GitHub for release information. Searching LRCLIB sends the current track title and artist to LRCLIB to find matching lyrics.";
                            color: Palette.muted;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                        SectionTitle { text: "Application information"; }
                        for row in State.about-rows : HorizontalLayout {
                            spacing: 12px;
                            Text { text: row.label; color: Palette.muted-2; font-size: 10px; width: 130px; vertical-alignment: center; }
                            Text { text: row.value; color: Palette.text-subtle; font-size: 10px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}

// ---- Duplicates --------------------------------------------------------------
component DuplicatesView inherits Rectangle {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 32px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 5px;
                horizontal-stretch: 1;
                Text {
                    text: "Duplicates";
                    color: Palette.text;
                    font-size: 30px;
                    font-weight: 800;
                    letter-spacing: -0.65px;
                }
                Text {
                    text: "Find and manage duplicate tracks across your collection.";
                    color: Palette.muted;
                    font-size: 12px;
                }
            }
            ActionBtn {
                label: "Rescan duplicates";
                primary: true;
                clicked => { Actions.prepare-duplicates(); }
            }
        }

        if State.duplicate-files.length == 0 : VerticalLayout {
            spacing: 12px;

            TrackHeader {
                first-column: "Title";
                show-added: false;
                show-year: false;
                show-album: true;
                sort(s) => { Actions.load-duplicates(s, State.duplicates-descending, 0); }
            }

            Rectangle {
                vertical-stretch: 1;
                ListView {
                    for row[index] in State.duplicates : Rectangle {
                        height: 48px;
                        background: dup-area.has-hover ? Palette.panel-2 : transparent;
                        dup-area := TouchArea {
                            clicked => { Actions.open-duplicate-files(row.first-id); }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            Text {
                                text: row.title;
                                color: Palette.text-strong;
                                font-size: 12px;
                                overflow: elide;
                                horizontal-stretch: 3;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.artist;
                                color: Palette.muted;
                                font-size: 11px;
                                overflow: elide;
                                horizontal-stretch: 3;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "\{row.copies}";
                                color: Palette.text-subtle;
                                font-size: 11px;
                                width: 60px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.locations;
                                color: Palette.muted-2;
                                font-size: 10px;
                                overflow: elide;
                                width: 220px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                alignment: center;
                ActionBtn {
                    label: "Previous";
                    clicked => { Actions.load-duplicates(State.duplicates-sort, State.duplicates-descending, State.duplicates-page - 1); }
                }
                Text {
                    text: "Page \{State.duplicates-page + 1} of \{State.duplicates-pages}";
                    color: Palette.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                ActionBtn {
                    label: "Next";
                    clicked => { Actions.load-duplicates(State.duplicates-sort, State.duplicates-descending, State.duplicates-page + 1); }
                }
            }
        }

        if State.duplicate-files.length > 0 : VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                IcBtn {
                    icon: @image-url("../assets/icons/chevron-left.svg");
                    clicked => { Actions.close-duplicate-files(); }
                }
                Text {
                    text: State.duplicate-group-title;
                    color: Palette.text;
                    font-size: 16px;
                    font-weight: 750;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            TrackTable {
                vertical-stretch: 1;
                show-added: false;
                show-year: false;
                empty-text: "No duplicate files.";
            }
        }
    }
}

// ---- Root content router -----------------------------------------------------
export component ContentArea inherits Rectangle {
    background: transparent;

    if State.view == "Home" : HomeView { width: 100%; height: 100%; }
    if State.view == "Search" : SearchView { width: 100%; height: 100%; }
    if State.view == "Songs" : SongsView { width: 100%; height: 100%; }
    if State.view == "Favorites" : SongsView { width: 100%; height: 100%; }
    if State.view == "Most Played" : SongsView { width: 100%; height: 100%; }
    if State.view == "Recently Played" : SongsView { width: 100%; height: 100%; }
    if State.view == "Recently Added" : SongsView { width: 100%; height: 100%; }
    if State.view == "With Lyrics" : SongsView { width: 100%; height: 100%; }
    if State.view == "Videos" : SongsView { width: 100%; height: 100%; }
    if State.view == "Albums" : GridView {
        width: 100%;
        height: 100%;
        title: "Albums";
        empty-text: "No albums indexed yet.";
    }
    if State.view == "Artists" : ArtistsView {
        width: 100%;
        height: 100%;
    }
    if State.view == "Genres" : GridView {
        width: 100%;
        height: 100%;
        title: "Genres";
        empty-text: "No genres indexed yet.";
    }
    if State.view == "Folders" : FoldersView { width: 100%; height: 100%; }
    if State.view == "Playlists" : PlaylistsView { width: 100%; height: 100%; }
    if State.view == "Playlist" : PlaylistView { width: 100%; height: 100%; }
    if State.view == "Album" : DetailView {
        width: 100%;
        height: 100%;
        eyebrow: "ALBUM";
        empty-text: "No tracks in this album.";
    }
    if State.view == "Artist" : DetailView {
        width: 100%;
        height: 100%;
        eyebrow: "ARTIST";
        empty-text: "No tracks by this artist.";
    }
    if State.view == "Genre" : DetailView {
        width: 100%;
        height: 100%;
        eyebrow: "GENRE";
        empty-text: "No tracks in this genre.";
    }
    if State.view == "Folder" : DetailView {
        width: 100%;
        height: 100%;
        eyebrow: "FOLDER";
        empty-text: "No tracks in this folder.";
    }
    if State.view == "Queue" : QueueView { width: 100%; height: 100%; }
    if State.view == "Now Playing" : NowPlayingView { width: 100%; height: 100%; }
    if State.view == "Lyrics" : LyricsView { width: 100%; height: 100%; }
    if State.view == "Audio" : AudioView { width: 100%; height: 100%; }
    if State.view == "Settings" : SettingsView { width: 100%; height: 100%; }
    if State.view == "Duplicates" : DuplicatesView { width: 100%; height: 100%; }
}
