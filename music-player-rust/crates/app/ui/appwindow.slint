// Root window: navigation rail, top bar, content area, right panel, player
// bar, global context menu, toasts and every modal.

import { State, Actions } from "state.slint";
import {
    TrackItem, GroupItem, QueueItem, PlaylistCardItem, LyricLineItem,
    TagFieldItem, ContextMenuItem, EqBandItem, DuplicateItem, DetailRowItem,
    BackupItem, LyricResultItem, GroupRowItem, PlaylistRowItem, FolderRootItem,
} from "models.slint";
import { ListView, Slider, ComboBox, LineEdit, Switch, TextEdit, CheckBox, ScrollView } from "std-widgets.slint";
import { Palette, IcBtn, TextBtn, TrackRow, EmptyState, Chip, SectionTitle } from "widgets.slint";
import { ContentArea, QueueView, AudioView } from "views.slint";

// Export globals and DTO structs to the Rust host.
export { State, Actions } from "state.slint";
export {
    TrackItem, GroupItem, QueueItem, PlaylistCardItem, LyricLineItem, TagFieldItem,
    ContextMenuItem, EqBandItem, DuplicateItem, DetailRowItem, BackupItem, LyricResultItem,
    GroupRowItem, PlaylistRowItem, FolderRootItem, ExtensionItem,
} from "models.slint";

// ---- Navigation rail entry -----------------------------------------------------
component NavEntryRow inherits Rectangle {
    in property <string> view;
    in property <string> label;
    in property <image> icon;

    height: 40px;
    border-radius: 6px;
    background: nav-area.pressed ? #1a1e1a : (nav-area.has-hover ? #ffffff0d : (State.view == root.view ? #171917 : transparent));
    animate background { duration: 120ms; }

    nav-area := TouchArea {
        clicked => { Actions.set-view(root.view, "", "", 0); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 13px;

        Image {
            source: root.icon;
            width: 18px;
            height: 18px;
            colorize: State.view == root.view ? State.accent : (nav-area.has-hover ? #f7f8f6 : #a0a79f);
            animate colorize { duration: 120ms; }
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: State.view == root.view ? #f7f8f6 : (nav-area.has-hover ? #f7f8f6 : #a0a79f);
            font-size: 13px;
            font-weight: 650;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// ---- Navigation rail ---------------------------------------------------------
component NavRail inherits Rectangle {
    width: State.navigation-width * 1px;
    background: #090a09;

    VerticalLayout {
        padding-top: 14px;
        padding-bottom: 10px;
        spacing: 4px;

        HorizontalLayout {
            padding-left: 18px;
            padding-right: 12px;
            spacing: 10px;
            height: 44px;
            Image {
                source: @image-url("../assets/icons/disc.svg");
                width: 22px;
                height: 22px;
                colorize: State.accent;
                vertical-alignment: center;
            }
            Text {
                text: "Music Player";
                color: #f7f8f6;
                font-size: 13px;
                font-weight: 800;
                vertical-alignment: center;
            }
        }

        // Back / forward history controls.
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            spacing: 6px;
            height: 34px;
            IcBtn {
                icon: @image-url("../assets/icons/chevron-left.svg");
                icon-size: 14px;
                tint: State.can-go-back ? #a0a79f : #3a403a;
                clicked => { if (State.can-go-back) { Actions.go-back(); } }
            }
            IcBtn {
                icon: @image-url("../assets/icons/chevron-right.svg");
                icon-size: 14px;
                tint: State.can-go-forward ? #a0a79f : #3a403a;
                clicked => { if (State.can-go-forward) { Actions.go-forward(); } }
            }
        }

        Rectangle { height: 6px; }

        ScrollView {
            VerticalLayout {
                spacing: 2px;
                // Navigation entries follow the default order of the original.
                NavEntryRow { view: "Home"; label: "Home"; icon: @image-url("../assets/icons/home.svg"); }
                NavEntryRow { view: "Search"; label: "Search"; icon: @image-url("../assets/icons/search.svg"); }
                NavEntryRow { view: "Songs"; label: "Songs"; icon: @image-url("../assets/icons/music.svg"); }
                NavEntryRow { view: "Favorites"; label: "Favorites"; icon: @image-url("../assets/icons/heart.svg"); }
                NavEntryRow { view: "Most Played"; label: "Most Played"; icon: @image-url("../assets/icons/spark.svg"); }
                NavEntryRow { view: "Recently Played"; label: "Recently Played"; icon: @image-url("../assets/icons/repeat.svg"); }
                NavEntryRow { view: "Recently Added"; label: "Recently Added"; icon: @image-url("../assets/icons/music.svg"); }
                NavEntryRow { view: "With Lyrics"; label: "With Lyrics"; icon: @image-url("../assets/icons/lyrics.svg"); }
                NavEntryRow { view: "Videos"; label: "Videos"; icon: @image-url("../assets/icons/expand.svg"); }
                NavEntryRow { view: "Albums"; label: "Albums"; icon: @image-url("../assets/icons/disc.svg"); }
                NavEntryRow { view: "Artists"; label: "Artists"; icon: @image-url("../assets/icons/users.svg"); }
                NavEntryRow { view: "Genres"; label: "Genres"; icon: @image-url("../assets/icons/list.svg"); }
                NavEntryRow { view: "Folders"; label: "Folders"; icon: @image-url("../assets/icons/folder.svg"); }
                NavEntryRow { view: "Playlists"; label: "Playlists"; icon: @image-url("../assets/icons/queue.svg"); }
                NavEntryRow { view: "Queue"; label: "Queue"; icon: @image-url("../assets/icons/queue.svg"); }
                NavEntryRow { view: "Audio"; label: "Audio"; icon: @image-url("../assets/icons/equalizer.svg"); }
                NavEntryRow { view: "Duplicates"; label: "Duplicates"; icon: @image-url("../assets/icons/disc.svg"); }
                NavEntryRow { view: "Settings"; label: "Settings"; icon: @image-url("../assets/icons/more.svg"); }
            }
        }
    }
}

// ---- Top bar -----------------------------------------------------------------
component TopBar inherits Rectangle {
    height: 56px;
    background: #090a09;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 14px;
        spacing: 12px;

        Rectangle {
            width: 340px;
            height: 36px;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            background: #131614;
            border-width: 1px;
            border-color: area.has-hover ? #ffffff22 : #ffffff12;
            animate border-color { duration: 120ms; }

            area := TouchArea { }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 8px;
                Image {
                    source: @image-url("../assets/icons/search.svg");
                    width: 14px;
                    height: 14px;
                    colorize: #717970;
                    vertical-alignment: center;
                }
                LineEdit {
                    placeholder-text: "Search";
                    text <=> State.view-search;
                    edited(text) => { Actions.search-input(text); }
                    accepted(text) => { Actions.save-recent-search(text); }
                }
                if State.view-search != "" : IcBtn {
                    icon: @image-url("../assets/icons/close.svg");
                    icon-size: 12px;
                    tint: #717970;
                    clicked => { Actions.search-input(""); }
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        if State.scan-active : HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                y: 14px;
                background: State.scan-paused ? #ffb04a : State.accent;
            }
            Text {
                text: State.scan-paused ? "Scan paused" : "Scanning library";
                color: #a0a79f;
                font-size: 10px;
                vertical-alignment: center;
            }
        }

        TextBtn {
            label: "Add folder";
            y: (parent.height - self.height) / 2;
            clicked => { Actions.open-modal("folders"); }
        }

        IcBtn {
            icon: @image-url("../assets/icons/panel-left.svg");
            y: (parent.height - self.height) / 2;
            active: State.right-panel-open;
            clicked => { Actions.toggle-right-panel(); }
        }
        IcBtn {
            icon: @image-url("../assets/icons/close.svg");
            y: (parent.height - self.height) / 2;
            tint: #a0a79f;
            hover-tint: #ff5b74;
            clicked => { Actions.close-window(); }
        }
    }
}

// ---- Right panel bits -----------------------------------------------------------
component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 34px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            color: #717970;
            font-size: 9px;
        }
        Text {
            text: root.value;
            color: #cdd2cc;
            font-size: 11px;
            overflow: elide;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #ffffff0d;
    }
}

component QueueRow inherits Rectangle {
    in property <QueueItem> item;
    in property <int> index: 0;
    callback play();
    callback remove();

    height: 52px;
    border-radius: 6px;
    background: row-area.has-hover ? #131613 : (root.item.is-current ? #ffffff0d : transparent);
    animate background { duration: 100ms; }

    row-area := TouchArea {
        clicked => { root.play(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                Actions.open-context-menu(root.item.id, 0, 0);
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Rectangle {
            width: 38px;
            height: 38px;
            border-radius: 4px;
            background: root.item.badge-bg;
            y: (parent.height - self.height) / 2;
            Text {
                text: root.item.initials;
                color: #f7f8f6;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.item.unavailable ? "\{root.item.title} (unavailable)" : root.item.title;
                color: root.item.is-current ? State.accent : (root.item.unavailable ? #ff5b74 : #f2f4f1);
                font-size: 11px;
                overflow: elide;
            }
            Text {
                text: root.item.artist;
                color: #a0a79f;
                font-size: 10px;
                overflow: elide;
            }
        }

        Text {
            text: root.item.duration;
            color: #a0a79f;
            font-size: 10px;
            width: 44px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        IcBtn {
            icon: @image-url("../assets/icons/close.svg");
            icon-size: 12px;
            tint: #717970;
            hover-tint: #ff5b74;
            width: 26px;
            height: 26px;
            clicked => { root.remove(); }
        }
    }
}

// ---- Right panel ---------------------------------------------------------------
component RightPanel inherits Rectangle {
    width: State.right-panel-open ? State.right-panel-width * 1px : 0px;
    background: #090a09;

    if State.right-panel-open : VerticalLayout {
        HorizontalLayout {
            height: 38px;
            padding-left: 12px;
            padding-right: 6px;
            spacing: 6px;
            Chip {
                label: "Queue";
                active: State.right-panel-tab == "queue";
                clicked => { Actions.set-right-tab("queue"); }
            }
            Chip {
                label: "Track info";
                active: State.right-panel-tab == "info";
                clicked => { Actions.set-right-tab("info"); }
            }
            Rectangle { horizontal-stretch: 1; }
            IcBtn {
                icon: @image-url("../assets/icons/close.svg");
                icon-size: 13px;
                tint: #717970;
                clicked => { Actions.toggle-right-panel(); }
            }
        }

        if State.right-panel-tab == "queue" : VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                height: 30px;
                padding-left: 12px;
                Text {
                    text: "\{State.queue-count} in queue";
                    color: #717970;
                    font-size: 10px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                TextBtn {
                    label: "Clear";
                    height: 26px;
                    clicked => { Actions.clear-queue(); }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                ListView {
                    for row[index] in State.queue-items : QueueRow {
                        item: row;
                        index: index;
                        play => { Actions.play-queue-entry(index); }
                        remove => { Actions.queue-remove(index); }
                    }
                }
            }
            if State.queue-more-count > 0 : Rectangle {
                height: 28px;
                Text {
                    text: "\{State.queue-more-count} more in Queue";
                    color: #717970;
                    font-size: 10px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        if State.right-panel-tab == "info" : ScrollView {
            VerticalLayout {
                padding: 14px;
                spacing: 12px;

                if State.has-track : Rectangle {
                    height: 280px;
                    border-radius: 6px;
                    clip: true;
                    background: #131614;
                    Image {
                        source: State.current-cover;
                        width: parent.width;
                        height: parent.height;
                        image-fit: ImageFit.cover;
                    }
                }

                if State.has-track : VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: State.current-title;
                        color: State.accent;
                        font-size: 15px;
                        font-weight: 750;
                        overflow: elide;
                    }
                    Text {
                        text: State.current-artist;
                        color: #a0a79f;
                        font-size: 10px;
                        overflow: elide;
                    }
                }

                if State.has-track : VerticalLayout {
                    spacing: 8px;
                    InfoRow { label: "Album"; value: State.info-album; }
                    InfoRow { label: "Album artist"; value: State.info-album-artist; }
                    InfoRow { label: "Year · Genre"; value: State.info-year-genre; }
                    InfoRow { label: "Audio format"; value: State.info-format; }
                    InfoRow { label: "Status"; value: State.info-status; }
                    InfoRow { label: "Audio quality"; value: State.info-quality; }
                    InfoRow { label: "Location"; value: State.info-location; }
                }
            }
        }
    }
}

// ---- Player bar ----------------------------------------------------------------
component PlayerBar inherits Rectangle {
    height: 88px;
    background: #090a09;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        // Left: now playing
        HorizontalLayout {
            width: State.browse-width * 1px;
            spacing: 11px;
            Rectangle {
                width: 56px;
                height: 56px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                clip: true;
                background: #131614;
                Image {
                    source: State.current-cover;
                    width: parent.width;
                    height: parent.height;
                    image-fit: ImageFit.cover;
                }
                TouchArea {
                    clicked => { Actions.set-view("Now Playing", "", "", ""); }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: State.current-title == "" ? "Not playing" : State.current-title;
                    color: State.current-title == "" ? #717970 : #f7f8f6;
                    font-size: 12px;
                    overflow: elide;
                }
                Text {
                    text: State.current-artist;
                    color: #a0a79f;
                    font-size: 10px;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 4px;
                    IcBtn {
                        icon: State.current-favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                        icon-size: 13px;
                        tint: State.current-favorite ? State.accent : #717970;
                        width: 26px;
                        height: 26px;
                        clicked => { if (State.current-id != "") { Actions.toggle-favorite(State.current-id); } }
                    }
                    IcBtn {
                        icon: @image-url("../assets/icons/more.svg");
                        icon-size: 13px;
                        tint: #717970;
                        width: 26px;
                        height: 26px;
                        clicked => { Actions.open-context-menu(State.current-id, 0, 0); }
                    }
                }
            }
        }

        // Center: controls + timeline
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 7px;

            HorizontalLayout {
                alignment: center;
                spacing: 11px;

                IcBtn {
                    icon: @image-url("../assets/icons/shuffle.svg");
                    icon-size: 15px;
                    tint: #939a93;
                    active: State.shuffle;
                    clicked => { Actions.toggle-shuffle(); }
                }
                IcBtn {
                    icon: @image-url("../assets/icons/skip-back.svg");
                    icon-size: 15px;
                    tint: #939a93;
                    clicked => { Actions.previous(); }
                }
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: #f4f6f3;
                    Image {
                        source: State.is-playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg");
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: #0a0b0a;
                    }
                    TouchArea {
                        clicked => { Actions.toggle-play(); }
                    }
                }
                IcBtn {
                    icon: @image-url("../assets/icons/skip-forward.svg");
                    icon-size: 15px;
                    tint: #939a93;
                    clicked => { Actions.next(); }
                }
                IcBtn {
                    icon: @image-url("../assets/icons/repeat.svg");
                    icon-size: 15px;
                    tint: State.repeat-mode == "Off" ? #939a93 : State.accent;
                    clicked => { Actions.cycle-repeat(); }
                }
                IcBtn {
                    icon: @image-url("../assets/icons/lyrics.svg");
                    icon-size: 15px;
                    tint: State.has-lyrics ? State.accent : #939a93;
                    clicked => { Actions.set-view("Lyrics", "", "", ""); }
                }
            }

            HorizontalLayout {
                width: 520px;
                alignment: center;
                spacing: 8px;
                Text {
                    text: State.current-time;
                    color: #747b74;
                    font-size: 9px;
                    width: 40px;
                    vertical-alignment: center;
                }
                Slider {
                    horizontal-stretch: 1;
                    minimum: 0.0;
                    maximum: 1.0;
                    value: State.progress;
                    changed value => { Actions.seek-fraction(self.value); }
                }
                Text {
                    text: State.total-time;
                    color: #747b74;
                    font-size: 9px;
                    width: 40px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        // Right: volume + extras
        HorizontalLayout {
            width: 240px;
            spacing: 8px;
            alignment: end;

            if State.repeat-a != "" || State.repeat-b != "" : Chip {
                label: State.repeat-a != "" && State.repeat-b != ""
                    ? "A-B \{State.repeat-a}–\{State.repeat-b}"
                    : (State.repeat-a != "" ? "A \{State.repeat-a}" : "B \{State.repeat-b}");
                active: true;
                clicked => { Actions.toggle-ab(); }
            }

            IcBtn {
                icon: @image-url("../assets/icons/queue.svg");
                icon-size: 15px;
                tint: #939a93;
                clicked => { Actions.set-view("Queue", "", "", ""); }
            }
            IcBtn {
                icon: @image-url("../assets/icons/equalizer.svg");
                icon-size: 15px;
                tint: #939a93;
                clicked => { Actions.set-view("Audio", "", "", ""); }
            }
            IcBtn {
                icon: @image-url("../assets/icons/volume.svg");
                icon-size: 15px;
                tint: #939a93;
                clicked => { Actions.set-volume-muted(); }
            }
            Slider {
                width: 88px;
                minimum: 0;
                maximum: 100;
                value: State.volume;
                changed value => { Actions.volume-changed(round(self.value)); }
            }
        }
    }
}

// ---- Context menu ----------------------------------------------------------------
component ContextMenuOverlay inherits Rectangle {
    background: #00000000;

    // Dismiss on outside click; Escape closes first.
    TouchArea {
        clicked => { Actions.close-context-menu(); }
    }

    Rectangle {
        x: min(max(8px, State.context-x), parent.width - 240px);
        y: min(max(8px, State.context-y), parent.height - self.height - 8px);
        width: 230px;
        height: State.context-items.length * 30px + 16px;
        border-radius: 8px;
        background: #171917;
        border-width: 1px;
        border-color: #ffffff14;
        clip: true;

        ListView {
            y: 8px;
            height: parent.height - 16px;
            for item[index] in State.context-items : Rectangle {
                height: 30px;
                if item.separator : Rectangle {
                    height: 1px;
                    y: 14px;
                    background: #ffffff14;
                }
                if !item.separator : TouchArea {
                    clicked => { Actions.context-action(index); }
                }
                if !item.separator : Text {
                    text: item.label;
                    color: item.danger ? #ff5b74 : (item.enabled ? #f2f4f1 : #565b55);
                    font-size: 12px;
                    x: 14px;
                    width: parent.width - 28px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

// ---- Toast (notice) ----------------------------------------------------------------
component NoticeOverlay inherits Rectangle {
    background: #00000000;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 118px;
        width: min(parent.width - 40px, 560px);
        height: 46px;
        border-radius: 8px;
        background: #171917;
        border-width: 1px;
        border-color: State.notice-severity == "Error" ? #ff5b7466
            : (State.notice-severity == "Warning" ? #ffb04a55
            : (State.notice-severity == "Success" ? State.accent : #ffffff14));

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 10px;
            spacing: 10px;
            Text {
                text: State.notice-message;
                color: #f2f4f1;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            IcBtn {
                icon: @image-url("../assets/icons/close.svg");
                icon-size: 12px;
                tint: #717970;
                width: 26px;
                height: 26px;
                y: 10px;
                clicked => { Actions.close-notice(); }
            }
        }
    }
}



// ---- Modal shared bits ------------------------------------------------------------
component ModalField inherits Rectangle {
    in property <string> label;
    in property <string> text;
    in property <length> field-width: 0px;
    callback changed(string);
    height: 52px;
    width: root.field-width;

    VerticalLayout {
        spacing: 4px;
        Text {
            text: root.label;
            color: #717970;
            font-size: 9px;
            font-weight: 700;
        }
        LineEdit {
            height: 30px;
            text: root.text;
            edited(value) => { root.changed(value); }
        }
    }
}

component ModalFooter inherits Rectangle {
    in property <string> note: "";
    height: 52px;

    // The note fills the row; action buttons are added by the using modal.
    Text {
        text: root.note;
        color: #717970;
        font-size: 9px;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
        x: 18px;
        width: parent.width - 36px;
        y: 0px;
        height: parent.height;
    }
}

// 1. Tag editor
component TagsModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 10px;
            ModalField { horizontal-stretch: 1; label: "Title"; text: State.tags-title; changed(v) => { State.tags-title = v; } }
            ModalField { horizontal-stretch: 1; label: "Artist"; text: State.tags-artist; changed(v) => { State.tags-artist = v; } }
        }
        HorizontalLayout {
            spacing: 10px;
            ModalField { horizontal-stretch: 1; label: "Album"; text: State.tags-album; changed(v) => { State.tags-album = v; } }
            ModalField { horizontal-stretch: 1; label: "Album artist"; text: State.tags-album-artist; changed(v) => { State.tags-album-artist = v; } }
        }
        HorizontalLayout {
            spacing: 10px;
            ModalField { horizontal-stretch: 1; label: "Genre"; text: State.tags-genre; changed(v) => { State.tags-genre = v; } }
            ModalField { horizontal-stretch: 1; label: "Year"; text: State.tags-year; changed(v) => { State.tags-year = v; } }
            ModalField { horizontal-stretch: 1; label: "Track number"; text: State.tags-track; changed(v) => { State.tags-track = v; } }
        }

        HorizontalLayout {
            spacing: 10px;
            TextBtn {
                label: State.tags-has-artwork ? "Replace artwork…" : "Add artwork…";
                clicked => { Actions.pick-artwork(); }
            }
            Text {
                text: State.tags-artwork-name;
                color: #a0a79f;
                font-size: 10px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        SectionTitle { text: "Additional format-specific fields"; }
        ScrollView {
            height: 110px;
            VerticalLayout {
                spacing: 6px;
                for field[index] in State.tags-custom : HorizontalLayout {
                    spacing: 8px;
                    height: 30px;
                    LineEdit {
                        width: 140px;
                        height: 26px;
                        text: field.key;
                        edited(v) => { Actions.tags-custom-key-changed(index, v); }
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        height: 26px;
                        text: field.value;
                        edited(v) => { Actions.tags-custom-value-changed(index, v); }
                    }
                    IcBtn {
                        icon: @image-url("../assets/icons/close.svg");
                        icon-size: 11px;
                        width: 24px;
                        height: 24px;
                        tint: #717970;
                        hover-tint: #ff5b74;
                        clicked => { Actions.tags-remove-custom(index); }
                    }
                }
                TextBtn {
                    label: "Add field…";
                    width: 120px;
                    height: 28px;
                    clicked => { Actions.tags-add-custom-field("FIELD", ""); }
                }
            }
        }

        SectionTitle { text: "Additional standard fields"; }
        ScrollView {
            height: 100px;
            VerticalLayout {
                spacing: 6px;
                for field[index] in State.tags-additional : HorizontalLayout {
                    spacing: 8px;
                    height: 30px;
                    Text {
                        text: field.key;
                        color: #a0a79f;
                        font-size: 10px;
                        width: 140px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        height: 26px;
                        text: field.value;
                        edited(v) => { Actions.tags-field-changed(index, v); }
                    }
                }
            }
        }

        ModalFooter {
            note: State.tags-format-note;
            // The footer doubles as the action row: swap Cancel for Save.
            TextBtn {
                label: "Cancel";
                y: 9px;
                x: parent.width - self.width - 140px;
                clicked => { Actions.close-modal(); }
            }
            TextBtn {
                label: "Save tags";
                primary: true;
                width: 110px;
                y: 9px;
                x: parent.width - self.width - 18px;
                clicked => { Actions.save-tags(); }
            }
        }
    }
}

// 2. Track details
component DetailsModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 12px;
                SectionTitle { text: "File details"; }
                for row in State.detail-rows : HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: row.label;
                        color: #717970;
                        font-size: 11px;
                        width: 120px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.value;
                        color: #cdd2cc;
                        font-size: 11px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                if State.detail-additional.length > 0 : SectionTitle { text: "Additional standard tags"; }
                for row in State.detail-additional : HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: row.label;
                        color: #717970;
                        font-size: 11px;
                        width: 120px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.value;
                        color: #cdd2cc;
                        font-size: 11px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                if State.detail-custom.length > 0 : SectionTitle { text: "Custom tags"; }
                for row in State.detail-custom : HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: row.label;
                        color: #717970;
                        font-size: 11px;
                        width: 120px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.value;
                        color: #cdd2cc;
                        font-size: 11px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                if State.detail-backups.length > 0 : SectionTitle { text: "Recent tag backups"; }
                for backup in State.detail-backups : HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: backup.label;
                        color: #a0a79f;
                        font-size: 10px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TextBtn {
                        label: "Restore";
                        height: 26px;
                        clicked => { Actions.confirm-restore-backup(backup.label); }
                    }
                }
            }
        }
    }
}

// 3. Find lyrics
component FindLyricsModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;

        ModalField { label: "Title"; text: State.find-lyrics-title; changed(v) => { State.find-lyrics-title = v; } }
        ModalField { label: "Artist"; text: State.find-lyrics-artist; changed(v) => { State.find-lyrics-artist = v; } }

        HorizontalLayout {
            spacing: 10px;
            TextBtn {
                label: "Search";
                primary: true;
                clicked => { Actions.find-lyrics(); }
            }
            if State.lyrics-searching : Text {
                text: "Searching LRCLIB…";
                color: #a0a79f;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        if State.lyrics-search-status != "" : Text {
            text: State.lyrics-search-status;
            color: State.lyrics-searching ? #a0a79f : #ffb04a;
            font-size: 11px;
            overflow: elide;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                for result in State.lyrics-results : Rectangle {
                    height: 54px;
                    border-radius: 6px;
                    background: result-area.has-hover ? #131614 : transparent;
                    result-area := TouchArea {
                        clicked => { Actions.use-lyric-result(result.timed ? result.synced-id : result.plain-id, result.timed); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            Text {
                                text: result.title;
                                color: #f2f4f1;
                                font-size: 12px;
                                overflow: elide;
                            }
                            Text {
                                text: result.artist;
                                color: #a0a79f;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }
                        Rectangle {
                            width: 70px;
                            height: 22px;
                            border-radius: 11px;
                            background: result.timed ? #ffffff14 : #ffffff08;
                            Text {
                                text: result.badge;
                                color: result.timed ? State.accent : #a0a79f;
                                font-size: 9px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

