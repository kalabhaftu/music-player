import { ListView } from "std-widgets.slint";

export struct TrackItem {
    id: int,
    title: string,
    artist: string,
    album: string,
    duration: string,
    initials: string,
    badge_bg: color,
    is_favorite: bool,
    accent: color,
}

export struct LyricLineItem {
    text: string,
    is_active: bool,
}

component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <image> icon_source;
    in property <bool> active: false;
    in property <string> badge: "";
    callback clicked();

    height: 44px;
    border-radius: 6px;
    background: area.pressed ? #1a1e1a : (area.has-hover ? #ffffff0d : (root.active ? #171917 : transparent));

    animate background { duration: 120ms; }

    area := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 13px;

        Image {
            source: root.icon_source;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            colorize: root.active ? #f7f8f6 : (area.has-hover ? #f7f8f6 : #a0a79f);
            animate colorize { duration: 120ms; }
        }

        Text {
            text: root.label;
            color: root.active ? #f7f8f6 : (area.has-hover ? #f7f8f6 : #a0a79f);
            font-size: 13px;
            font-weight: 650;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.badge != "" : Text {
            text: root.badge;
            color: #717970;
            font-size: 9px;
            vertical-alignment: center;
        }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon_source;
    in property <color> icon_color: #a0a79f;
    in property <color> hover_color: #f7f8f6;
    in property <length> icon_size: 16px;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: area.pressed ? #ffffff18 : (area.has-hover ? #ffffff12 : transparent);

    animate background { duration: 100ms; }

    area := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        source: root.icon_source;
        width: root.icon_size;
        height: root.icon_size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: area.has-hover ? root.hover_color : root.icon_color;
        animate colorize { duration: 100ms; }
    }
}

component TrackRow inherits Rectangle {
    in property <TrackItem> track;
    in property <int> index: 1;
    in property <bool> is_playing: false;
    in property <color> accent: #b7ff2d;
    callback play_requested();
    callback toggle_favorite();

    height: 58px;
    background: area.pressed ? #191c19 : (area.has-hover ? #131613 : (root.is_playing ? #151a15 : transparent));

    animate background { duration: 120ms; }

    // Bottom border line matching table td border-bottom
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #ffffff13;
    }

    area := TouchArea {
        clicked => { root.play_requested(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        // Index / Play Icon
        Rectangle {
            width: 44px;
            if area.has-hover : Image {
                source: @image-url("../assets/icons/play.svg");
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
                x: (parent.width - self.width) / 2;
                colorize: #f7f8f6;
            }
            if !area.has-hover && root.is_playing : Image {
                source: @image-url("../assets/icons/music.svg");
                width: 15px;
                height: 15px;
                y: (parent.height - self.height) / 2;
                x: (parent.width - self.width) / 2;
                colorize: root.accent;
            }
            if !area.has-hover && !root.is_playing : Text {
                text: "\{root.index}";
                color: #717970;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Song Artwork Thumbnail (38px x 38px, border-radius 6px) with initials badge
        Rectangle {
            width: 38px;
            height: 38px;
            border-radius: 6px;
            clip: true;
            y: (parent.height - self.height) / 2;
            background: root.track.badge_bg;

            Text {
                text: root.track.initials;
                color: #f7f8f6;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Title and Artist
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 3;

            Text {
                text: root.track.title;
                color: root.is_playing ? root.accent : #f2f4f1;
                font-size: 12px;
                font-weight: 650;
                overflow: elide;
                animate color { duration: 150ms; }
            }

            Text {
                text: root.track.artist;
                color: #a0a79f;
                font-size: 10px;
                overflow: elide;
            }
        }

        // Album
        Text {
            text: root.track.album;
            color: #cdd2cc;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 2;
            overflow: elide;
        }

        // Duration (width 64px, right aligned)
        Text {
            width: 64px;
            text: root.track.duration;
            color: #a0a79f;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        // Favorite Heart Button
        Rectangle {
            width: 40px;
            fav_area := TouchArea {
                clicked => { root.toggle_favorite(); }
            }

            if root.track.is_favorite : Image {
                source: @image-url("../assets/icons/heart-filled.svg");
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                x: (parent.width - self.width) / 2;
                colorize: root.accent;
                animate colorize { duration: 150ms; }
            }

            if !root.track.is_favorite && (area.has-hover || fav_area.has-hover) : Image {
                source: @image-url("../assets/icons/heart.svg");
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                x: (parent.width - self.width) / 2;
                colorize: fav_area.has-hover ? #f7f8f6 : #717970;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Music Player";
    icon: @image-url("../assets/icons/music.svg");
    min-width: 980px;
    min-height: 640px;
    preferred-width: 1180px;
    preferred-height: 760px;
    background: #070807;

    in-out property <[TrackItem]> tracks: [];
    in-out property <[LyricLineItem]> lyrics_items: [];
    in-out property <bool> immersive_open: false;
    in-out property <bool> queue_drawer_open: false;
    in-out property <string> search_query: "";
    in-out property <int> current_track_id: 1;
    in-out property <string> current_title: "No Role Modelz";
    in-out property <string> current_artist: "J. Cole";
    in-out property <image> current_cover;
    in-out property <color> theme_accent: #38bdf8;
    in-out property <bool> is_playing: true;
    in-out property <float> progress: 0.35;
    in-out property <string> current_time: "1:42";
    in-out property <string> total_time: "4:53";
    in-out property <float> volume: 0.75;
    in-out property <string> active_nav: "Songs";

    callback track_selected(int);
    callback play_pause_clicked();
    callback next_clicked();
    callback previous_clicked();
    callback volume_changed(float);
    callback favorite_toggled(int);
    callback seek_requested(float);
    callback nav_clicked(string);
    callback search_query_changed(string);
    callback queue_toggle_clicked();
    callback lyrics_toggle_clicked();
    callback immersive_toggle_clicked();
    callback immersive_close_clicked();

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Top Area (Sidebar + Main Content)
        HorizontalLayout {
            horizontal-stretch: 1;

            // ================= SIDEBAR (232px) =================
            Rectangle {
                width: 232px;
                background: #090a09;

                // Right Border Line
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: #ffffff13;
                }

                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;

                    // Brand (height: 48px, padding: 0 11px, margin-bottom: 8px)
                    Rectangle {
                        height: 48px;

                        VerticalLayout {
                            padding-left: 11px;
                            padding-right: 11px;
                            alignment: center;
                            spacing: 1px;

                            Text {
                                text: "Music Player";
                                color: #f7f8f6;
                                font-size: 18px;
                                font-weight: 700;
                                letter-spacing: -0.4px;
                            }

                            Text {
                                text: "LOCAL LIBRARY";
                                color: #717970;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 0.5px;
                            }
                        }
                    }

                    // Navigation Viewport
                    VerticalLayout {
                        spacing: 2px;

                        // Section: Discover
                        HorizontalLayout {
                            padding-top: 9px;
                            padding-bottom: 7px;
                            padding-left: 12px;
                            Text {
                                text: "DISCOVER";
                                color: #717970;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 1.1px;
                            }
                        }
                        NavItem {
                            label: "Home";
                            icon_source: @image-url("../assets/icons/home.svg");
                            active: root.active_nav == "Home";
                            clicked => { root.active_nav = "Home"; root.nav_clicked("Home"); }
                        }
                        NavItem {
                            label: "Search";
                            icon_source: @image-url("../assets/icons/search.svg");
                            badge: "Ctrl K";
                            active: root.active_nav == "Search";
                            clicked => { root.active_nav = "Search"; root.nav_clicked("Search"); }
                        }
                        NavItem {
                            label: "Favorites";
                            icon_source: @image-url("../assets/icons/heart.svg");
                            active: root.active_nav == "Favorites";
                            clicked => { root.active_nav = "Favorites"; root.nav_clicked("Favorites"); }
                        }

                        // Section: Your Library
                        HorizontalLayout {
                            padding-top: 14px;
                            padding-bottom: 7px;
                            padding-left: 12px;
                            Text {
                                text: "YOUR LIBRARY";
                                color: #717970;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 1.1px;
                            }
                        }
                        NavItem {
                            label: "Songs";
                            icon_source: @image-url("../assets/icons/music.svg");
                            active: root.active_nav == "Songs";
                            clicked => { root.active_nav = "Songs"; root.nav_clicked("Songs"); }
                        }
                        NavItem {
                            label: "Albums";
                            icon_source: @image-url("../assets/icons/disc.svg");
                            active: root.active_nav == "Albums";
                            clicked => { root.active_nav = "Albums"; root.nav_clicked("Albums"); }
                        }
                        NavItem {
                            label: "Artists";
                            icon_source: @image-url("../assets/icons/users.svg");
                            active: root.active_nav == "Artists";
                            clicked => { root.active_nav = "Artists"; root.nav_clicked("Artists"); }
                        }
                        NavItem {
                            label: "Genres";
                            icon_source: @image-url("../assets/icons/tag.svg");
                            active: root.active_nav == "Genres";
                            clicked => { root.active_nav = "Genres"; root.nav_clicked("Genres"); }
                        }
                        NavItem {
                            label: "Recently Added";
                            icon_source: @image-url("../assets/icons/spark.svg");
                            active: root.active_nav == "Recently Added";
                            clicked => { root.active_nav = "Recently Added"; root.nav_clicked("Recently Added"); }
                        }

                        // Section: Manage
                        HorizontalLayout {
                            padding-top: 14px;
                            padding-bottom: 7px;
                            padding-left: 12px;
                            Text {
                                text: "MANAGE";
                                color: #717970;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 1.1px;
                            }
                        }
                        NavItem {
                            label: "Playlists";
                            icon_source: @image-url("../assets/icons/list.svg");
                            active: root.active_nav == "Playlists";
                            clicked => { root.active_nav = "Playlists"; root.nav_clicked("Playlists"); }
                        }
                        NavItem {
                            label: "Folders";
                            icon_source: @image-url("../assets/icons/folder.svg");
                            active: root.active_nav == "Folders";
                            clicked => { root.active_nav = "Folders"; root.nav_clicked("Folders"); }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            // ================= MAIN VIEW =================
            Rectangle {
                horizontal-stretch: 1;
                background: #070807;

                VerticalLayout {
                    padding: 0;
                    spacing: 0;

                    // Topbar (height: 56px, background: #090a09, border-bottom: 1px)
                    Rectangle {
                        height: 56px;
                        background: #090a09;

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: #ffffff13;
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 9px;
                            alignment: center;

                            IconButton {
                                icon_source: @image-url("../assets/icons/panel-left.svg");
                            }
                            IconButton {
                                icon_source: @image-url("../assets/icons/chevron-left.svg");
                            }
                            IconButton {
                                icon_source: @image-url("../assets/icons/chevron-right.svg");
                            }

                            // Search Box (max-width: 520px, height: 38px, border-radius: 999px, background: #242724)
                            Rectangle {
                                width: 440px;
                                height: 38px;
                                border-radius: 19px;
                                background: #242724;

                                HorizontalLayout {
                                    padding-left: 13px;
                                    padding-right: 13px;
                                    spacing: 9px;

                                    Image {
                                        source: @image-url("../assets/icons/search.svg");
                                        width: 16px;
                                        height: 16px;
                                        y: (parent.height - self.height) / 2;
                                        colorize: #a0a79f;
                                    }

                                    search_input := TextInput {
                                        text <=> root.search_query;
                                        color: #f7f8f6;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        edited => { root.search_query_changed(self.text); }
                                    }

                                    if root.search_query == "" : Text {
                                        text: "Ctrl K";
                                        color: #717970;
                                        font-size: 9px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Top Spacer
                            Rectangle { horizontal-stretch: 1; }

                            IconButton {
                                icon_source: @image-url("../assets/icons/queue.svg");
                                icon_color: root.queue_drawer_open ? root.theme_accent : #a0a79f;
                                clicked => { root.queue_drawer_open = !root.queue_drawer_open; root.queue_toggle_clicked(); }
                            }
                            IconButton {
                                icon_source: @image-url("../assets/icons/more.svg");
                            }
                        }
                    }

                    // Content Area (padding: 20px 24px 32px)
                    VerticalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 20px;
                        padding-bottom: 12px;
                        spacing: 16px;
                        vertical-stretch: 1;

                        // Page Head
                        HorizontalLayout {
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 5px;
                                Text {
                                    text: "Songs";
                                    color: #f7f8f6;
                                    font-size: 30px;
                                    font-weight: 700;
                                    letter-spacing: -0.65px;
                                }
                                Text {
                                    text: "2,480 tracks · 142 hours";
                                    color: #a0a79f;
                                    font-size: 12px;
                                }
                            }

                            // Action buttons: Play All (primary) & Shuffle
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;

                                // Play All (action.primary: background #f4f6f3, color #0a0b0a)
                                Rectangle {
                                    width: 104px;
                                    height: 34px;
                                    border-radius: 17px;
                                    background: play_all_touch.pressed ? #e0e3df : (play_all_touch.has-hover ? #ffffff : #f4f6f3);

                                    play_all_touch := TouchArea {
                                        clicked => { root.play_pause_clicked(); }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        Image {
                                            source: @image-url("../assets/icons/play.svg");
                                            width: 14px;
                                            height: 14px;
                                            y: (parent.height - self.height) / 2;
                                            colorize: #0a0b0a;
                                        }

                                        Text {
                                            text: "Play All";
                                            color: #0a0b0a;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Shuffle (action: background #242724, color #ffffff)
                                Rectangle {
                                    width: 96px;
                                    height: 34px;
                                    border-radius: 17px;
                                    background: shuf_touch.pressed ? #3a3f3a : (shuf_touch.has-hover ? #303430 : #242724);

                                    shuf_touch := TouchArea {}

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        Image {
                                            source: @image-url("../assets/icons/shuffle.svg");
                                            width: 14px;
                                            height: 14px;
                                            y: (parent.height - self.height) / 2;
                                            colorize: #ffffff;
                                        }

                                        Text {
                                            text: "Shuffle";
                                            color: #ffffff;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Table Column Headers (height: 37px)
                        Rectangle {
                            height: 37px;

                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: #ffffff13;
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;

                                Text {
                                    width: 44px;
                                    text: "#";
                                    color: #717970;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.8px;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }

                                Rectangle { width: 38px; }

                                Text {
                                    text: "TITLE";
                                    color: #717970;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.8px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 3;
                                }

                                Text {
                                    text: "ALBUM";
                                    color: #717970;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.8px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 2;
                                }

                                Text {
                                    width: 64px;
                                    text: "TIME";
                                    color: #717970;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.8px;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }

                                Rectangle { width: 40px; }
                            }
                        }

                        // Virtualized Track List
                        ListView {
                            vertical-stretch: 1;

                            for track[i] in root.tracks: TrackRow {
                                track: track;
                                index: i + 1;
                                is_playing: track.id == root.current_track_id;
                                accent: root.theme_accent;
                                play_requested => {
                                    root.track_selected(track.id);
                                }
                                toggle_favorite => {
                                    root.favorite_toggled(track.id);
                                }
                            }
                        }
                    }
                }
            }

            // ================= RIGHT DRAWER (Now Playing / Queue) =================
            if root.queue_drawer_open : Rectangle {
                width: 280px;
                background: #090a09;

                // Left Border Line
                Rectangle {
                    x: 0px;
                    width: 1px;
                    height: parent.height;
                    background: #ffffff13;
                }

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // Header
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Playback Queue";
                            color: #f7f8f6;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        IconButton {
                            icon_source: @image-url("../assets/icons/close.svg");
                            icon_size: 14px;
                            clicked => { root.queue_drawer_open = false; }
                        }
                    }

                    // Now Playing Card
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: #141714;

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 10px;
                            alignment: center;

                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: 6px;
                                clip: true;
                                background: #111411;

                                Image {
                                    source: root.current_cover;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: cover;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                Text {
                                    text: root.current_title;
                                    color: #f7f8f6;
                                    font-size: 12px;
                                    font-weight: 650;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.current_artist;
                                    color: #a0a79f;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // Up Next Section Header
                    Text {
                        text: "UP NEXT";
                        color: #717970;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 1.0px;
                    }

                    // Queue List
                    ListView {
                        vertical-stretch: 1;
                        for track in root.tracks: Rectangle {
                            height: 44px;
                            border-radius: 6px;
                            background: q_area.has-hover ? #ffffff0d : transparent;
                            q_area := TouchArea {
                                clicked => { root.track_selected(track.id); }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                alignment: center;

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 4px;
                                    clip: true;
                                    background: track.badge_bg;

                                    Text {
                                        text: track.initials;
                                        color: #f7f8f6;
                                        font-size: 10px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: track.title;
                                        color: track.id == root.current_track_id ? root.theme_accent : #f2f4f1;
                                        font-size: 11px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: track.artist;
                                        color: #717970;
                                        font-size: 9px;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    text: track.duration;
                                    color: #717970;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ================= BOTTOM PLAYER (88px) =================
        Rectangle {
            height: 88px;
            background: #090a09;

            // Top Border Line
            Rectangle {
                y: 0px;
                width: parent.width;
                height: 1px;
                background: #ffffff13;
            }

            HorizontalLayout {
                padding-left: 15px;
                padding-right: 15px;
                spacing: 12px;

                // Left: Now Playing Info (minmax 220px, 1fr)
                HorizontalLayout {
                    width: 260px;
                    spacing: 11px;
                    alignment: start;

                    // Real Cover Art (56px x 56px, border-radius 6px)
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 6px;
                        clip: true;
                        y: (parent.height - self.height) / 2;
                        background: #111411;

                        Image {
                            source: root.current_cover;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: root.current_title;
                            color: #f7f8f6;
                            font-size: 12px;
                            font-weight: 650;
                            overflow: elide;
                        }

                        Text {
                            text: root.current_artist;
                            color: #a0a79f;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }

                    // Heart Button (30px x 30px)
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        y: (parent.height - self.height) / 2;
                        now_fav_area := TouchArea {
                            clicked => { root.favorite_toggled(root.current_track_id); }
                        }
                        background: now_fav_area.has-hover ? #ffffff0f : transparent;

                        Image {
                            source: @image-url("../assets/icons/heart-filled.svg");
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                            x: (parent.width - self.width) / 2;
                            colorize: root.theme_accent;
                            animate colorize { duration: 150ms; }
                        }
                    }
                }

                // Center: Transport Controls & Scrubber (minmax 360px, 1.35fr)
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 7px;

                    // Transport Buttons
                    HorizontalLayout {
                        spacing: 11px;
                        alignment: center;

                        IconButton {
                            icon_source: @image-url("../assets/icons/shuffle.svg");
                            icon_color: #939a93;
                        }
                        IconButton {
                            icon_source: @image-url("../assets/icons/skip-back.svg");
                            icon_color: #939a93;
                            clicked => { root.previous_clicked(); }
                        }

                        // Play/Pause Main Button (.play-main: 36px, background #f4f6f3, icon #0a0b0a)
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            background: play_main_touch.pressed ? #e2e5e1 : (play_main_touch.has-hover ? #ffffff : #f4f6f3);

                            animate background { duration: 80ms; }

                            play_main_touch := TouchArea {
                                clicked => { root.play_pause_clicked(); }
                            }

                            if root.is_playing : Image {
                                source: @image-url("../assets/icons/pause.svg");
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                x: (parent.width - self.width) / 2;
                                colorize: #0a0b0a;
                            }

                            if !root.is_playing : Image {
                                source: @image-url("../assets/icons/play.svg");
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                x: (parent.width - self.width) / 2;
                                colorize: #0a0b0a;
                            }
                        }

                        IconButton {
                            icon_source: @image-url("../assets/icons/skip-forward.svg");
                            icon_color: #939a93;
                            clicked => { root.next_clicked(); }
                        }
                        IconButton {
                            icon_source: @image-url("../assets/icons/repeat.svg");
                            icon_color: #939a93;
                        }
                    }

                    // Scrubber Timeline
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Text {
                            width: 28px;
                            text: root.current_time;
                            color: #747b74;
                            font-size: 9px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }

                        // Scrubber Range Track (height: 4px, background: #2e332f)
                        Rectangle {
                            height: 12px;
                            horizontal-stretch: 1;

                            timeline_touch := TouchArea {
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) {
                                        root.seek_requested(clamp(self.mouse-x / self.width, 0.0, 1.0));
                                    }
                                }
                            }

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 4px;
                                border-radius: 2px;
                                background: #2e332f;

                                // Progress fill (default #e2e6e1, hover fills with theme_accent!)
                                Rectangle {
                                    x: 0;
                                    width: parent.width * root.progress;
                                    height: parent.height;
                                    border-radius: 2px;
                                    background: timeline_touch.has-hover ? root.theme_accent : #e2e6e1;

                                    animate background { duration: 100ms; }
                                }
                            }

                            // 8px white circle thumb (visible on hover)
                            if timeline_touch.has-hover : Rectangle {
                                x: (parent.width * root.progress) - (self.width / 2);
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #ffffff;
                            }
                        }

                        Text {
                            width: 28px;
                            text: root.total_time;
                            color: #747b74;
                            font-size: 9px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Right: Utilities & Volume (minmax 220px, 1fr)
                HorizontalLayout {
                    width: 240px;
                    spacing: 7px;
                    alignment: end;

                    IconButton {
                        icon_source: @image-url("../assets/icons/lyrics.svg");
                        icon_color: root.immersive_open ? root.theme_accent : #939a93;
                        clicked => { root.immersive_open = !root.immersive_open; root.lyrics_toggle_clicked(); }
                    }
                    IconButton {
                        icon_source: @image-url("../assets/icons/queue.svg");
                        icon_color: root.queue_drawer_open ? root.theme_accent : #939a93;
                        clicked => { root.queue_drawer_open = !root.queue_drawer_open; root.queue_toggle_clicked(); }
                    }
                    IconButton {
                        icon_source: @image-url("../assets/icons/equalizer.svg");
                        icon_color: #939a93;
                    }
                    IconButton {
                        icon_source: @image-url("../assets/icons/expand.svg");
                        icon_color: #939a93;
                        clicked => { root.immersive_open = !root.immersive_open; root.immersive_toggle_clicked(); }
                    }

                    // Volume
                    IconButton {
                        icon_source: @image-url("../assets/icons/volume.svg");
                        icon_color: #939a93;
                    }

                    // Volume Range Slider (width: 88px, height: 4px)
                    Rectangle {
                        width: 88px;
                        height: 12px;
                        y: (parent.height - self.height) / 2;

                        vol_area := TouchArea {
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    root.volume = clamp(self.mouse-x / self.width, 0.0, 1.0);
                                    root.volume_changed(root.volume);
                                }
                            }
                        }

                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 4px;
                            border-radius: 2px;
                            background: #2e332f;

                            Rectangle {
                                x: 0;
                                width: parent.width * root.volume;
                                height: parent.height;
                                border-radius: 2px;
                                background: vol_area.has-hover ? root.theme_accent : #e2e6e1;
                                animate background { duration: 100ms; }
                            }
                        }

                        if vol_area.has-hover : Rectangle {
                            x: (parent.width * root.volume) - (self.width / 2);
                            y: (parent.height - self.height) / 2;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: #ffffff;
                        }
                    }
                }
            }
        }
    }

    // ================= FULLSCREEN IMMERSIVE PLAYER =================
    if root.immersive_open : Rectangle {
        width: 100%;
        height: 100%;
        background: #070807;

        VerticalLayout {
            padding: 32px;
            spacing: 24px;

            // Topbar
            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: "NOW PLAYING";
                    color: #717970;
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 1.5px;
                    vertical-alignment: center;
                }

                IconButton {
                    icon_source: @image-url("../assets/icons/close.svg");
                    icon_size: 18px;
                    clicked => { root.immersive_open = false; root.immersive_close_clicked(); }
                }
            }

            // Main Stage (Artwork on left, Synced Lyrics on right)
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 48px;

                // Left Column: Big Album Art + Metadata
                VerticalLayout {
                    width: 380px;
                    alignment: center;
                    spacing: 20px;

                    // Large 340px cover art
                    Rectangle {
                        width: 340px;
                        height: 340px;
                        border-radius: 16px;
                        clip: true;
                        background: #111411;

                        Image {
                            source: root.current_cover;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }
                    }

                    // Metadata
                    HorizontalLayout {
                        width: 340px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;

                            Text {
                                text: root.current_title;
                                color: #f7f8f6;
                                font-size: 22px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: root.current_artist;
                                color: #a0a79f;
                                font-size: 14px;
                                overflow: elide;
                            }
                        }

                        IconButton {
                            icon_source: @image-url("../assets/icons/heart-filled.svg");
                            icon_color: root.theme_accent;
                            icon_size: 20px;
                            clicked => { root.favorite_toggled(root.current_track_id); }
                        }
                    }
                }

                // Right Column: Synced Lyrics View
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;

                    Text {
                        text: "LYRICS";
                        color: #717970;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1.2px;
                    }

                    if root.lyrics_items.length == 0 : Rectangle {
                        vertical-stretch: 1;
                        Text {
                            text: "No synchronized lyrics available for this song.";
                            color: #717970;
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    if root.lyrics_items.length > 0 : ListView {
                        vertical-stretch: 1;

                        for lyric in root.lyrics_items: Rectangle {
                            height: lyric.is_active ? 48px : 36px;
                            animate height { duration: 150ms; }

                            Text {
                                text: lyric.text;
                                color: lyric.is_active ? root.theme_accent : #565d55;
                                font-size: lyric.is_active ? 20px : 15px;
                                font-weight: lyric.is_active ? 700 : 500;
                                vertical-alignment: center;
                                overflow: elide;
                                animate color { duration: 150ms; }
                                animate font-size { duration: 150ms; }
                            }
                        }
                    }
                }
            }

            // Bottom Fullscreen Scrubber & Transport Controls
            VerticalLayout {
                spacing: 14px;
                alignment: center;

                // Scrubber
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Text {
                        width: 36px;
                        text: root.current_time;
                        color: #717970;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }

                    Rectangle {
                        height: 16px;
                        horizontal-stretch: 1;

                        imm_scrub_touch := TouchArea {
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    root.seek_requested(clamp(self.mouse-x / self.width, 0.0, 1.0));
                                }
                            }
                        }

                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 6px;
                            border-radius: 3px;
                            background: #242724;

                            Rectangle {
                                x: 0;
                                width: parent.width * root.progress;
                                height: parent.height;
                                border-radius: 3px;
                                background: root.theme_accent;
                            }
                        }
                    }

                    Text {
                        width: 36px;
                        text: root.total_time;
                        color: #717970;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                // Controls
                HorizontalLayout {
                    spacing: 24px;
                    alignment: center;

                    IconButton {
                        icon_source: @image-url("../assets/icons/skip-back.svg");
                        icon_size: 22px;
                        icon_color: #f7f8f6;
                        clicked => { root.previous_clicked(); }
                    }

                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: 24px;
                        background: #f4f6f3;

                        imm_play_touch := TouchArea {
                            clicked => { root.play_pause_clicked(); }
                        }

                        if root.is_playing : Image {
                            source: @image-url("../assets/icons/pause.svg");
                            width: 20px;
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            x: (parent.width - self.width) / 2;
                            colorize: #0a0b0a;
                        }

                        if !root.is_playing : Image {
                            source: @image-url("../assets/icons/play.svg");
                            width: 20px;
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            x: (parent.width - self.width) / 2;
                            colorize: #0a0b0a;
                        }
                    }

                    IconButton {
                        icon_source: @image-url("../assets/icons/skip-forward.svg");
                        icon_size: 22px;
                        icon_color: #f7f8f6;
                        clicked => { root.next_clicked(); }
                    }
                }
            }
        }
    }
}
