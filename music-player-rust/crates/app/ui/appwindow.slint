// Root window: navigation rail, top bar, content area, right panel, player
// bar, global context menu, toasts and every modal.

import { State, Actions } from "state.slint";
import {
    TrackItem, GroupItem, QueueItem, PlaylistCardItem, HomeCardItem, HomeCardRow, HomeTrackRow, LyricLineItem,
    TagFieldItem, ContextMenuItem, EqBandItem, DuplicateItem, DetailRowItem,
    BackupItem, LyricResultItem, GroupRowItem, PlaylistRowItem, FolderRootItem, NavEntry, NavSettingItem,
} from "models.slint";
import { ListView, Slider, ComboBox, LineEdit, Switch, TextEdit, CheckBox, ScrollView } from "std-widgets.slint";
import { Palette, IcBtn, TextBtn, TrackRow, EmptyState, Chip, SectionTitle, PlayerSlider } from "widgets.slint";
import { ContentArea, QueueView, AudioView } from "views.slint";

// Export globals and DTO structs to the Rust host.
export { State, Actions } from "state.slint";
export {
    TrackItem, GroupItem, QueueItem, PlaylistCardItem, HomeCardItem, HomeCardRow, HomeTrackRow, LyricLineItem, TagFieldItem,
    ContextMenuItem, EqBandItem, DuplicateItem, DetailRowItem, BackupItem, LyricResultItem,
    GroupRowItem, PlaylistRowItem, FolderRootItem, ExtensionItem, NavEntry, NavSettingItem,
} from "models.slint";

// ---- Navigation rail entry -----------------------------------------------------
component NavEntryRow inherits Rectangle {
    in property <string> view;
    in property <string> label;
    in property <string> section-title;

    height: root.section-title == "" ? 44px : 79px;

    VerticalLayout {
        spacing: 0px;
        if root.section-title != "" : HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 9px;
            padding-bottom: 7px;
            height: 35px;
            alignment: start;
            Text {
                text: root.section-title;
                color: Palette.muted-2;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.1px;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 44px;
            border-radius: 6px;
            background: nav-area.pressed ? Palette.hover : (nav-area.has-hover ? #ffffff0d : (State.view == root.view ? Palette.raised : transparent));
            animate background { duration: 120ms; }

            nav-area := TouchArea {
                clicked => { Actions.set-view(root.view, "", "", ""); }
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 13px;

                Rectangle {
                    width: 20px;
                    height: 20px;
                    y: (parent.height - self.height) / 2;

                    Image {
                        source: root.view == "Home" ? @image-url("../assets/icons/home.svg")
                            : root.view == "Search" ? @image-url("../assets/icons/search.svg")
                            : root.view == "Favorites" ? @image-url("../assets/icons/heart.svg")
                            : root.view == "Albums" ? @image-url("../assets/icons/disc.svg")
                            : root.view == "Artists" ? @image-url("../assets/icons/users.svg")
                            : root.view == "Genres" ? @image-url("../assets/icons/tag.svg")
                            : root.view == "Playlists" ? @image-url("../assets/icons/list.svg")
                            : root.view == "Folders" ? @image-url("../assets/icons/folder.svg")
                            : root.view == "Recently Added" ? @image-url("../assets/icons/spark.svg")
                            : @image-url("../assets/icons/music.svg");
                        width: 20px;
                        height: 20px;
                        colorize: State.view == root.view ? Palette.text : (nav-area.has-hover ? Palette.text : Palette.muted);
                        animate colorize { duration: 120ms; }
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.label;
                    color: State.view == root.view ? Palette.text : (nav-area.has-hover ? Palette.text : Palette.muted);
                    font-size: 13px;
                    font-weight: 650;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.view == "Search" : Text {
                    text: "Ctrl K";
                    color: Palette.muted-2;
                    font-size: 9px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// ---- Navigation rail ---------------------------------------------------------
component NavRail inherits Rectangle {
    width: State.navigation-collapsed ? 0px : State.navigation-width * 1px;
    background: Palette.surface;
    clip: true;

    // 1px right border matching original CSS
    Rectangle {
        x: parent.width - 1px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: Palette.border;
    }

    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 2px;

        VerticalLayout {
            padding-left: 11px;
            height: 48px;
            spacing: 1px;
            Text {
                text: "Music Player";
                color: Palette.text;
                font-size: 18px;
                font-weight: 800;
                letter-spacing: -0.4px;
                vertical-alignment: center;
            }
            Text {
                text: "LOCAL LIBRARY";
                color: Palette.muted-2;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 0.5px;
                vertical-alignment: center;
            }
        }
        Rectangle { height: 8px; }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 2px;
                for item in State.navigation-items : NavEntryRow {
                    view: item.view;
                    label: item.label;
                    section-title: item.section-title;
                }
            }
        }
    }
}

// Persisted, draggable column dividers mirror the release's sidebar and
// Now Playing panel resize handles.
component PanelResizeHandle inherits Rectangle {
    in property <bool> right-side: false;
    in property <length> available-width;
    in property <length> available-height;
    in-out property <bool> drag-active: false;
    in-out property <int> drag-start-x: 0;
    in-out property <int> drag-start-width: 0;

    x: root.right-side
        ? root.available-width - State.right-panel-width * 1px - 4px
        : State.navigation-width * 1px - 4px;
    y: 0px;
    width: 8px;
    height: root.available-height;
    visible: !State.immersive-player-open && (root.right-side ? State.right-panel-open : !State.navigation-collapsed);
    background: root.drag-active || divider.has-hover ? State.accent.with-alpha(0.28) : #00000000;

    divider := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag-active = true;
                root.drag-start-x = round((root.absolute-position.x + divider.mouse-x) / 1px);
                root.drag-start-width = root.right-side ? State.right-panel-width : State.navigation-width;
            }
            if (event.kind == PointerEventKind.move && root.drag-active) {
                if (root.right-side) {
                    State.right-panel-width = clamp(root.drag-start-width - (round((root.absolute-position.x + divider.mouse-x) / 1px) - root.drag-start-x), 240, 460);
                } else {
                    State.navigation-width = clamp(root.drag-start-width + (round((root.absolute-position.x + divider.mouse-x) / 1px) - root.drag-start-x), 180, 360);
                }
            }
            if ((event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) && root.drag-active) {
                root.drag-active = false;
                if (root.right-side) { Actions.set-setting("right-panel-width", "\{State.right-panel-width}"); }
                else { Actions.set-setting("navigation-width", "\{State.navigation-width}"); }
            }
        }
    }
}

// ---- Top bar -----------------------------------------------------------------
component TopBar inherits Rectangle {
    out property <bool> search-has-focus: search-input.has-focus;
    public function focus-search() {
        search-input.focus();
    }

    height: 56px;
    background: Palette.surface;

    // 1px bottom border matching original CSS
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: parent.width;
        background: Palette.border;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 9px;

        IcBtn {
            icon: @image-url("../assets/icons/panel-left.svg");
            icon-size: 16px;
            tint: Palette.muted;
            clicked => { Actions.toggle-sidebar(); }
        }
        IcBtn {
            icon: @image-url("../assets/icons/chevron-left.svg");
            icon-size: 16px;
            tint: State.can-go-back ? Palette.muted : Palette.disabled;
            clicked => { if (State.can-go-back) { Actions.go-back(); } }
        }
        IcBtn {
            icon: @image-url("../assets/icons/chevron-right.svg");
            icon-size: 16px;
            tint: State.can-go-forward ? Palette.muted : Palette.disabled;
            clicked => { if (State.can-go-forward) { Actions.go-forward(); } }
        }

        // Pill Search Box
        Rectangle {
            horizontal-stretch: 10;
            min-width: 0px;
            max-width: 520px;
            height: 38px;
            border-radius: 19px;
            background: search-input.has-focus ? Palette.hover : #242724;
            animate background { duration: 100ms; }
            clip: true;

            HorizontalLayout {
                padding-left: 13px;
                padding-right: 13px;
                spacing: 9px;
                alignment: center;

                Image {
                    source: @image-url("../assets/icons/search.svg");
                    width: 16px;
                    height: 16px;
                    colorize: #a0a79f;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    height: 38px;
                    clip: true;

                    if State.view-search == "" : Text {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: parent.height;
                        text: State.view == "Settings" ? "Search settings…" : "Search songs, artists, albums, playlists…";
                        color: #717970;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    search-input := TextInput {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: parent.height;
                        text <=> State.view-search;
                        color: #f7f8f6;
                        font-size: 13px;
                        single-line: true;
                        vertical-alignment: center;
                        edited => { Actions.search-input(self.text); }
                        accepted => { if (State.view != "Settings") { Actions.save-recent-search(self.text); } }
                    }
                }

                if State.view-search == "" : Rectangle {
                    width: 38px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: #ffffff0a;
                    border-width: 1px;
                    border-color: #ffffff14;
                    Text {
                        text: "Ctrl K";
                        color: #717970;
                        font-size: 9px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                if State.view-search != "" : IcBtn {
                    icon: @image-url("../assets/icons/close.svg");
                    icon-size: 12px;
                    tint: Palette.muted-2;
                    width: 22px;
                    height: 22px;
                    clicked => { Actions.search-input(""); }
                }
            }
        }

        // Spacer to push right actions to the edge
        Rectangle { horizontal-stretch: 1; }

        if State.scan-active || State.scan-outcome != "" : HorizontalLayout {
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: scan-area.has-hover ? Palette.overlay : transparent;
                border-width: 2px;
                border-color: State.scan-paused ? #ffb04a : (State.scan-cancelling ? #ff5b74 : State.accent);
                Text {
                    text: State.scan-paused ? "Ⅱ" : (State.scan-cancelling ? "×" : "•");
                    color: State.scan-paused ? #ffb04a : (State.scan-cancelling ? #ff5b74 : State.accent);
                    font-size: State.scan-paused ? 10px : 16px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                scan-area := TouchArea { clicked => { Actions.toggle-scan-details(); } }
            }
        }

        IcBtn {
            icon: @image-url("../assets/icons/queue.svg");
            icon-size: 16px;
            tint: State.right-panel-open ? State.accent : Palette.muted;
            clicked => { Actions.toggle-right-panel(); }
        }
        IcBtn {
            icon: @image-url("../assets/icons/more.svg");
            icon-size: 16px;
            tint: State.tools-menu-open ? Palette.text : Palette.muted;
            clicked => { Actions.toggle-tools-menu(); }
        }
    }

    if State.scan-details-open : Rectangle {
        x: parent.width - 320px;
        y: 64px;
        width: 300px;
        height: 128px;
        border-radius: 8px;
        background: Palette.panel;
        border-width: 1px;
        border-color: Palette.border;
        VerticalLayout {
            padding: 12px;
            spacing: 7px;
            Text {
                text: State.scan-cancelling ? "Cancelling scan"
                    : State.scan-paused ? "Library scan paused"
                    : State.scan-outcome != "" ? "Library scan complete"
                    : "Scanning library";
                color: Palette.text;
                font-size: 13px;
                font-weight: 700;
            }
            Text {
                text: State.scan-outcome != "" ? State.scan-outcome
                    : (State.scan-scanned > 0 ? "\{State.scan-scanned} files scanned" + (State.scan-path != "" ? " · \{State.scan-path}" : "")
                    : (State.scan-path != "" ? State.scan-path : "Scanning library files…"));
                color: Palette.muted;
                font-size: 11px;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 8px;
                if State.scan-active : TextBtn {
                    label: State.scan-paused ? "Resume" : "Pause";
                    clicked => { Actions.pause-scan(); }
                }
                if State.scan-active : TextBtn {
                    label: "Cancel";
                    danger: true;
                    clicked => { Actions.cancel-scan(); State.scan-details-open = false; }
                }
                Rectangle { horizontal-stretch: 1; }
                IcBtn {
                    icon: @image-url("../assets/icons/close.svg");
                    icon-size: 12px;
                    clicked => { State.scan-details-open = false; }
                }
            }
        }
    }
}

component ToolMenuRow inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <string> view;
    callback clicked();
    height: 38px;
    border-radius: 5px;
    background: area.has-hover ? Palette.hover : transparent;
    area := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        alignment: center;
        Image { source: root.icon; width: 17px; height: 17px; colorize: Palette.muted; }
        Text {
            text: root.label;
            color: Palette.text-strong;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

component ToolsMenuOverlay inherits Rectangle {
    background: #00000000;
    TouchArea { clicked => { State.tools-menu-open = false; } }
    Rectangle {
        x: parent.width - 204px;
        y: 64px;
        width: 190px;
        height: 86px;
        border-radius: 8px;
        background: Palette.panel;
        border-width: 1px;
        border-color: Palette.border;
        VerticalLayout {
            padding: 5px;
            spacing: 2px;
            ToolMenuRow { label: "Settings"; icon: @image-url("../assets/icons/settings.svg"); clicked => { Actions.open-settings(); State.tools-menu-open = false; } }
            ToolMenuRow { label: "Scan library"; icon: @image-url("../assets/icons/refresh.svg"); clicked => { Actions.scan-library(); State.tools-menu-open = false; } }
        }
    }
}

// ---- Right panel bits -----------------------------------------------------------
component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 34px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            color: Palette.muted-2;
            font-size: 9px;
        }
        Text {
            text: root.value;
            color: Palette.text-subtle;
            font-size: 11px;
            overflow: elide;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.border-soft;
    }
}

component QueueRow inherits Rectangle {
    in property <QueueItem> item;
    in property <int> index: 0;
    callback play();
    callback remove();

    height: 52px;
    border-radius: 6px;
    background: row-area.has-hover ? Palette.hover : (root.item.is-current ? Palette.raised : transparent);
    animate background { duration: 100ms; }

    row-area := TouchArea {
        clicked => { root.play(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                Actions.open-context-menu(root.item.id, round((root.absolute-position.x + row-area.mouse-x) / 1px), round((root.absolute-position.y + row-area.mouse-y) / 1px));
            }
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 9px;

        Rectangle {
            width: 38px;
            height: 38px;
            border-radius: 4px;
            clip: true;
            background: root.item.badge-bg;
            y: (parent.height - self.height) / 2;
            if root.item.has-cover : Image {
                source: root.item.cover;
                width: parent.width;
                height: parent.height;
                image-fit: ImageFit.cover;
            }
            if !root.item.has-cover : Text {
                text: root.item.initials;
                color: #ffffffd0;
                font-size: 13px;
                font-weight: 800;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                text: root.item.unavailable ? "\{root.item.title} (unavailable)" : root.item.title;
                color: root.item.is-current ? State.accent : (root.item.unavailable ? #ff5b74 : Palette.text-strong);
                font-size: 11px;
                font-weight: 650;
                overflow: elide;
            }
            if root.item.artist != "" : Text {
                text: root.item.artist;
                color: Palette.muted;
                font-size: 10px;
                overflow: elide;
            }
        }

        Rectangle {
            width: 30px;
            if row-area.has-hover : IcBtn {
                icon: @image-url("../assets/icons/close.svg");
                icon-size: 12px;
                tint: Palette.muted-2;
                hover-tint: #ff5b74;
                width: 26px;
                height: 26px;
                clicked => { root.remove(); }
            }
        }
    }
}

component PanelTab inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();
    width: root.label == "Queue" ? 48px : 72px;
    height: 30px;
    Text {
        text: root.label;
        color: root.active ? Palette.text : Palette.muted;
        font-size: 10px;
        x: 2px;
        width: parent.width - 4px;
        vertical-alignment: center;
        horizontal-alignment: left;
    }
    Rectangle {
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: root.active ? State.accent : transparent;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// ---- Right panel ---------------------------------------------------------------
component RightPanel inherits Rectangle {
    width: State.right-panel-open ? State.right-panel-width * 1px : 0px;
    background: Palette.surface;
    clip: true;

    // 1px left border matching original CSS
    Rectangle {
        x: 0px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: Palette.border;
    }

    if State.right-panel-open : VerticalLayout {
        padding-top: 16px;
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 8px;
        spacing: 0px;

        HorizontalLayout {
            height: 38px;
            Text {
                text: "Now playing";
                color: Palette.text;
                font-size: 13px;
                font-weight: 750;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IcBtn {
                icon: @image-url("../assets/icons/close.svg");
                icon-size: 12px;
                clicked => { Actions.toggle-right-panel(); }
            }
        }

        if State.has-track : Rectangle {
            height: 18px;
        }
        if State.has-track : Rectangle {
            width: State.right-panel-width * 1px - 24px;
            height: self.width;
            border-radius: 7px;
            clip: true;
            background: Palette.panel-2;
            if State.current-has-cover : Image {
                source: State.current-cover;
                width: parent.width;
                height: parent.height;
                image-fit: ImageFit.cover;
            }
            if !State.current-has-cover : Text {
                text: State.current-initials;
                color: #ffffffcc;
                font-size: 42px;
                font-weight: 900;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        if State.has-track : Rectangle {
            height: 14px;
        }
        if State.has-track : HorizontalLayout {
            height: 48px;
            padding-left: 2px;
            padding-right: 2px;
            spacing: 8px;
            VerticalLayout {
                spacing: 4px;
                alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                Text {
                    text: State.current-title;
                    color: Palette.text;
                    font-size: 15px;
                    font-weight: 750;
                    letter-spacing: -0.25px;
                    overflow: elide;
                }
                Text {
                    text: State.current-album == "" ? State.current-artist : "\{State.current-artist} • \{State.current-album}";
                    color: Palette.muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }
            IcBtn {
                icon: State.current-favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                icon-size: 15px;
                tint: State.current-favorite ? State.accent : Palette.muted-2;
                clicked => { Actions.toggle-favorite(State.current-id); }
            }
        }
        if !State.has-track : VerticalLayout {
            padding-top: 60px;
            padding-bottom: 60px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 6px;
            alignment: center;
            Text {
                text: "Nothing playing";
                color: Palette.text;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "Choose a track to see details here.";
                color: Palette.muted;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
        Rectangle { height: 1px; background: Palette.border; }

        HorizontalLayout {
            height: 30px;
            Rectangle { width: 2px; background: transparent; }
            PanelTab {
                label: "Queue";
                active: State.right-panel-tab == "queue";
                clicked => { Actions.set-right-tab("queue"); }
            }
            PanelTab {
                label: "Track info";
                active: State.right-panel-tab == "info";
                clicked => { Actions.set-right-tab("info"); }
            }
        }
        Rectangle { height: 1px; background: Palette.border; }

        if State.right-panel-tab == "queue" : VerticalLayout {
            HorizontalLayout {
                height: 34px;
                Text {
                    text: "Next in queue (\{State.queue-count})";
                    color: #d8ddd8;
                    font-size: 11px;
                    font-weight: 800;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if State.queue-count > 0 : Rectangle {
                    width: 38px;
                    height: 22px;
                    border-radius: 4px;
                    background: clear-area.has-hover ? Palette.border-soft : transparent;
                    animate background { duration: 100ms; }
                    Text {
                        text: "Clear";
                        color: clear-area.has-hover ? Palette.text : Palette.muted;
                        font-size: 10px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    clear-area := TouchArea {
                        clicked => { Actions.clear-queue(); }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                ListView {
                    for row[index] in State.panel-queue-items : QueueRow {
                        item: row;
                        index: index;
                        play => { Actions.play-queue-entry(row.queue-index); }
                        remove => { Actions.queue-remove(row.queue-index); }
                    }
                }
            }
            if State.queue-count <= 0 : Rectangle {
                vertical-stretch: 1;
                Text {
                    text: "No upcoming tracks.";
                    color: Palette.muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                    y: 24px;
                }
            }
            if State.queue-panel-more-count > 0 : Rectangle {
                height: 30px;
                TextBtn {
                    label: "\{State.queue-panel-more-count} more in Queue";
                    clicked => { Actions.set-view("Queue", "", "", ""); }
                }
            }
        }

        if State.right-panel-tab == "info" : ScrollView {
            VerticalLayout {
                if State.has-track : VerticalLayout {
                    padding-top: 10px;
                    spacing: 0px;
                    Text {
                        text: "Track information";
                        color: Palette.text-subtle;
                        font-size: 11px;
                        font-weight: 800;
                    }
                    InfoRow { label: "Album"; value: State.info-album; }
                    InfoRow { label: "Album artist"; value: State.info-album-artist; }
                    InfoRow { label: "Year · Genre"; value: State.info-year-genre; }
                    InfoRow { label: "Audio format"; value: State.info-format; }
                    InfoRow { label: "Status"; value: State.info-status; }
                    InfoRow { label: "Audio quality"; value: State.info-quality; }
                    InfoRow { label: "Location"; value: State.info-location; }
                }
            }
        }
    }
}

// ---- Player bar ----------------------------------------------------------------
component PlayerBar inherits Rectangle {
    height: 88px;
    background: Palette.surface;

    // 1px top border matching original CSS
    Rectangle {
        y: 0px;
        height: 1px;
        width: parent.width;
        background: Palette.border;
    }

    HorizontalLayout {
        padding-left: 15px;
        padding-right: 15px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        alignment: center;

        HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 200px;
            spacing: 11px;
            alignment: start;

            Rectangle {
                width: 56px;
                height: 56px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                clip: true;
                background: State.has-track && State.current-has-cover
                    ? Palette.panel-2
                    : (!State.has-track || State.current-id == ""
                        ? @linear-gradient(150deg, #172019 0%, #243328 58%, #364a3b 100%)
                        : State.current-badge-bg);
                if State.has-track && State.current-has-cover : Image {
                    source: State.current-cover;
                    width: parent.width;
                    height: parent.height;
                    image-fit: ImageFit.cover;
                }
                if !State.has-track || !State.current-has-cover : Text {
                    text: !State.has-track || State.current-initials == "" ? "MP" : State.current-initials;
                    color: #ffffffcc;
                    font-size: 20px;
                    font-weight: 900;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                min-width: 0px;
                Text {
                    text: State.current-title == "" ? "Nothing playing" : State.current-title;
                    color: State.current-title == "" ? Palette.muted-2 : Palette.text;
                    font-size: 12px;
                    font-weight: 650;
                    overflow: elide;
                }
                Text {
                    text: State.current-title == "" ? "Choose a song from your library" : (State.current-album == "" ? State.current-artist : "\{State.current-artist} • \{State.current-album}");
                    color: Palette.muted;
                    font-size: 10px;
                    overflow: elide;
                }
            }
            IcBtn {
                icon: State.current-favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                icon-size: 16px;
                tint: State.current-favorite ? State.accent : Palette.icon-muted;
                y: (parent.height - self.height) / 2;
                clicked => { if (State.current-id != "") { Actions.toggle-favorite(State.current-id); } }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1.35;
            min-width: 340px;
            alignment: center;
            spacing: 7px;

            HorizontalLayout {
                alignment: center;
                spacing: 11px;

                IcBtn {
                    icon: @image-url("../assets/icons/shuffle.svg");
                    icon-size: 16px;
                    tint: Palette.icon-muted;
                    active: State.shuffle;
                    clicked => { Actions.toggle-shuffle(); }
                }
                IcBtn {
                    icon: @image-url("../assets/icons/skip-back.svg");
                    icon-size: 16px;
                    tint: Palette.icon-muted;
                    clicked => { Actions.previous(); }
                }
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: #f4f6f3;
                    animate background { duration: 100ms; }
                    TouchArea {
                        clicked => { Actions.toggle-play(); }
                    }
                    Image {
                        source: State.is-playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg");
                        width: 17px;
                        height: 17px;
                        x: (parent.width - self.width) / 2 + (State.is-playing ? 0px : 1px);
                        y: (parent.height - self.height) / 2;
                        colorize: #0a0b0a;
                    }
                }
                IcBtn {
                    icon: @image-url("../assets/icons/skip-forward.svg");
                    icon-size: 16px;
                    tint: Palette.icon-muted;
                    clicked => { Actions.next(); }
                }
                IcBtn {
                    icon: @image-url("../assets/icons/repeat.svg");
                    icon-size: 16px;
                    tint: State.repeat-mode == "Off" ? Palette.icon-muted : State.accent;
                    clicked => { Actions.cycle-repeat(); }
                }
                Rectangle {
                    width: 30px;
                    height: 30px;
                    visible: State.window-width > 1100;
                    border-radius: 15px;
                    background: ab-area.has-hover ? Palette.overlay : transparent;
                    Text {
                        text: "A–B";
                        color: State.repeat-a != "" || State.repeat-b != "" ? State.accent : Palette.icon-muted;
                        font-size: 10px;
                        font-weight: 650;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    ab-area := TouchArea { clicked => { Actions.toggle-ab(); } }
                }
            }

            HorizontalLayout {
                horizontal-stretch: 1;
                max-width: 520px;
                spacing: 8px;

                Text {
                    text: State.current-time;
                    color: #747b74;
                    font-size: 9px;
                    width: 32px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
                PlayerSlider {
                    horizontal-stretch: 1;
                    minimum: 0.0;
                    maximum: 1.0;
                    value: State.progress;
                    changed(val) => { Actions.seek-fraction(val); }
                    scrolled(event) => {
                        let delta = event.delta-y > 0px ? 5 : (event.delta-y < 0px ? -5 : 0);
                        if (delta != 0) {
                            Actions.seek-relative(delta);
                            return accept;
                        }
                        reject
                    }
                }
                Text {
                    text: State.total-time;
                    color: #747b74;
                    font-size: 9px;
                    width: 32px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 220px;
            spacing: 7px;
            alignment: end;

            IcBtn {
                icon: @image-url("../assets/icons/lyrics.svg");
                icon-size: 16px;
                tint: Palette.icon-muted;
                active: State.view == "Lyrics";
                y: (parent.height - self.height) / 2;
                clicked => { Actions.set-view("Lyrics", "", "", ""); }
            }
            IcBtn {
                icon: @image-url("../assets/icons/queue.svg");
                icon-size: 16px;
                tint: Palette.icon-muted;
                active: State.view == "Queue";
                y: (parent.height - self.height) / 2;
                clicked => { Actions.set-view("Queue", "", "", ""); }
            }
            IcBtn {
                icon: @image-url("../assets/icons/equalizer.svg");
                icon-size: 16px;
                tint: Palette.icon-muted;
                active: State.view == "Audio";
                y: (parent.height - self.height) / 2;
                clicked => { Actions.set-view("Audio", "", "", ""); }
            }
            IcBtn {
                icon: State.immersive-fullscreen ? @image-url("../assets/icons/compress.svg") : @image-url("../assets/icons/expand.svg");
                icon-size: 16px;
                tint: Palette.icon-muted;
                y: (parent.height - self.height) / 2;
                clicked => { Actions.open-immersive-player(); }
            }
            IcBtn {
                icon: State.volume == 0 ? @image-url("../assets/icons/mute.svg") : @image-url("../assets/icons/volume.svg");
                icon-size: 16px;
                tint: State.volume == 0 ? State.accent : Palette.icon-muted;
                y: (parent.height - self.height) / 2;
                clicked => { Actions.set-volume-muted(); }
                scrolled(event) => {
                    let delta = event.delta-y > 0px ? 4 : (event.delta-y < 0px ? -4 : 0);
                    if (delta != 0) {
                        Actions.volume-changed(clamp(State.volume + delta, 0, 100));
                        return accept;
                    }
                    reject
                }
            }
            PlayerSlider {
                width: 88px;
                minimum: 0.0;
                maximum: 100.0;
                value: State.volume;
                scroll-step: 4.0;
                y: (parent.height - self.height) / 2;
                changed(val) => { Actions.volume-changed(round(val)); }
            }
        }
    }
}

component ContextMenuItemRow inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> separator: false;
    callback clicked();

    height: 34px;
    border-radius: 5px;
    background: area.has-hover && !root.separator ? #202420 : transparent;

    area := TouchArea {
        enabled: !root.separator && root.enabled;
        clicked => { root.clicked(); }
    }

    if root.separator : Rectangle {
        height: 1px;
        y: 16px;
        background: Palette.border;
    }
    if !root.separator : Text {
        text: root.label;
        color: root.danger ? #ff5b74 : (root.enabled ? Palette.text-strong : Palette.disabled);
        font-size: 11px;
        x: 12px;
        width: parent.width - 24px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ---- Context menu ----------------------------------------------------------------
component ContextMenuOverlay inherits Rectangle {
    background: #00000000;

    // Dismiss on outside click; Escape closes first.
    TouchArea {
        clicked => { Actions.close-context-menu(); }
    }

    Rectangle {
        x: min(max(8px, State.context-x), parent.width - 240px);
        y: min(max(8px, State.context-y), parent.height - self.height - 8px);
        width: 220px;
        height: State.context-items.length * 34px + 14px;
        border-radius: 7px;
        background: #181b19;
        border-width: 1px;
        border-color: Palette.border;
        clip: true;

        ListView {
            y: 7px;
            height: parent.height - 14px;
            for item[index] in State.context-items : ContextMenuItemRow {
                label: item.label;
                enabled: item.enabled;
                danger: item.danger;
                separator: item.separator;
                clicked => { Actions.context-action(index); }
            }
        }
    }
}

// ---- Toast (notice) ----------------------------------------------------------------
component NoticeOverlay inherits Rectangle {
    background: #00000000;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 118px;
        width: min(parent.width - 40px, 560px);
        height: 46px;
        border-radius: 8px;
        background: Palette.raised;
        border-width: 1px;
        border-color: State.notice-severity == "Error" ? #ff5b7466
            : (State.notice-severity == "Warning" ? #ffb04a55
            : (State.notice-severity == "Success" ? State.accent : Palette.border));

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 10px;
            spacing: 10px;
            Text {
                text: State.notice-message;
                color: Palette.text-strong;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            IcBtn {
                icon: @image-url("../assets/icons/close.svg");
                icon-size: 12px;
                tint: Palette.muted-2;
                width: 26px;
                height: 26px;
                y: 10px;
                clicked => { Actions.close-notice(); }
            }
        }
    }
}



// ---- Modal shared bits ------------------------------------------------------------
component ModalField inherits Rectangle {
    in property <string> label;
    in property <string> text;
    in property <length> field-width: 0px;
    callback changed(string);
    height: 52px;
    width: root.field-width;

    VerticalLayout {
        spacing: 4px;
        Text {
            text: root.label;
            color: Palette.muted-2;
            font-size: 9px;
            font-weight: 700;
        }
        LineEdit {
            height: 30px;
            text: root.text;
            edited(value) => { root.changed(value); }
        }
    }
}

component ModalFooter inherits Rectangle {
    in property <string> note: "";
    height: 52px;

    // The note fills the row; action buttons are added by the using modal.
    Text {
        text: root.note;
        color: Palette.muted-2;
        font-size: 9px;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
        x: 18px;
        width: parent.width - 36px;
        y: 0px;
        height: parent.height;
    }
}

// 1. Tag editor
component TagsModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 10px;
            ModalField { horizontal-stretch: 1; label: "Title"; text: State.tags-title; changed(v) => { State.tags-title = v; } }
            ModalField { horizontal-stretch: 1; label: "Artist"; text: State.tags-artist; changed(v) => { State.tags-artist = v; } }
        }
        HorizontalLayout {
            spacing: 10px;
            ModalField { horizontal-stretch: 1; label: "Album"; text: State.tags-album; changed(v) => { State.tags-album = v; } }
            ModalField { horizontal-stretch: 1; label: "Album artist"; text: State.tags-album-artist; changed(v) => { State.tags-album-artist = v; } }
        }
        HorizontalLayout {
            spacing: 10px;
            ModalField { horizontal-stretch: 1; label: "Genre"; text: State.tags-genre; changed(v) => { State.tags-genre = v; } }
            ModalField { horizontal-stretch: 1; label: "Year"; text: State.tags-year; changed(v) => { State.tags-year = v; } }
            ModalField { horizontal-stretch: 1; label: "Track number"; text: State.tags-track; changed(v) => { State.tags-track = v; } }
        }

        HorizontalLayout {
            spacing: 10px;
            TextBtn {
                label: State.tags-has-artwork ? "Replace artwork…" : "Add artwork…";
                clicked => { Actions.pick-artwork(); }
            }
            Text {
                text: State.tags-artwork-name;
                color: Palette.muted;
                font-size: 10px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        SectionTitle { text: "Additional format-specific fields"; }
        ScrollView {
            height: 110px;
            VerticalLayout {
                spacing: 6px;
                for field[index] in State.tags-custom : HorizontalLayout {
                    spacing: 8px;
                    height: 30px;
                    LineEdit {
                        width: 140px;
                        height: 26px;
                        text: field.key;
                        edited(v) => { Actions.tags-custom-key-changed(index, v); }
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        height: 26px;
                        text: field.value;
                        edited(v) => { Actions.tags-custom-value-changed(index, v); }
                    }
                    IcBtn {
                        icon: @image-url("../assets/icons/close.svg");
                        icon-size: 11px;
                        width: 24px;
                        height: 24px;
                        tint: Palette.muted-2;
                        hover-tint: #ff5b74;
                        clicked => { Actions.tags-remove-custom(index); }
                    }
                }
                TextBtn {
                    label: "Add field…";
                    width: 120px;
                    height: 28px;
                    clicked => { Actions.tags-add-custom-field("FIELD", ""); }
                }
            }
        }

        SectionTitle { text: "Additional standard fields"; }
        ScrollView {
            height: 100px;
            VerticalLayout {
                spacing: 6px;
                for field[index] in State.tags-additional : HorizontalLayout {
                    spacing: 8px;
                    height: 30px;
                    Text {
                        text: field.key;
                        color: Palette.muted;
                        font-size: 10px;
                        width: 140px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        height: 26px;
                        text: field.value;
                        edited(v) => { Actions.tags-field-changed(index, v); }
                    }
                }
            }
        }

        ModalFooter {
            note: State.tags-format-note;
            // The footer doubles as the action row: swap Cancel for Save.
            TextBtn {
                label: "Cancel";
                y: 9px;
                x: parent.width - self.width - 140px;
                clicked => { Actions.close-modal(); }
            }
            TextBtn {
                label: "Save tags";
                primary: true;
                width: 110px;
                y: 9px;
                x: parent.width - self.width - 18px;
                clicked => { Actions.save-tags(); }
            }
        }
    }
}

// 2. Track details
component DetailsModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 12px;
                SectionTitle { text: "File details"; }
                for row in State.detail-rows : HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: row.label;
                        color: Palette.muted-2;
                        font-size: 11px;
                        width: 120px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.value;
                        color: Palette.text-subtle;
                        font-size: 11px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                if State.detail-additional.length > 0 : SectionTitle { text: "Additional standard tags"; }
                for row in State.detail-additional : HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: row.label;
                        color: Palette.muted-2;
                        font-size: 11px;
                        width: 120px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.value;
                        color: Palette.text-subtle;
                        font-size: 11px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                if State.detail-custom.length > 0 : SectionTitle { text: "Custom tags"; }
                for row in State.detail-custom : HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: row.label;
                        color: Palette.muted-2;
                        font-size: 11px;
                        width: 120px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.value;
                        color: Palette.text-subtle;
                        font-size: 11px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                if State.detail-backups.length > 0 : SectionTitle { text: "Recent tag backups"; }
                for backup in State.detail-backups : HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: backup.label;
                        color: Palette.muted;
                        font-size: 10px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TextBtn {
                        label: "Restore";
                        height: 26px;
                        clicked => { Actions.confirm-restore-backup(backup.label); }
                    }
                }
            }
        }
    }
}

// 3. Find lyrics
component FindLyricsModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;

        ModalField { label: "Title"; text: State.find-lyrics-title; changed(v) => { State.find-lyrics-title = v; } }
        ModalField { label: "Artist"; text: State.find-lyrics-artist; changed(v) => { State.find-lyrics-artist = v; } }

        HorizontalLayout {
            spacing: 10px;
            TextBtn {
                label: "Search";
                primary: true;
                clicked => { Actions.find-lyrics(); }
            }
            if State.lyrics-searching : Text {
                text: "Searching LRCLIB…";
                color: Palette.muted;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        if State.lyrics-search-status != "" : Text {
            text: State.lyrics-search-status;
            color: State.lyrics-searching ? Palette.muted : #ffb04a;
            font-size: 11px;
            overflow: elide;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                for result in State.lyrics-results : Rectangle {
                    height: 54px;
                    border-radius: 6px;
                    background: result-area.has-hover ? Palette.panel-2 : transparent;
                    result-area := TouchArea {
                        clicked => { Actions.use-lyric-result(result.timed ? result.synced-id : result.plain-id, result.timed); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            Text {
                                text: result.title;
                                color: Palette.text-strong;
                                font-size: 12px;
                                overflow: elide;
                            }
                            Text {
                                text: result.artist;
                                color: Palette.muted;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }
                        Rectangle {
                            width: 70px;
                            height: 22px;
                            border-radius: 11px;
                            background: result.timed ? Palette.border : Palette.border-soft;
                            Text {
                                text: result.badge;
                                color: result.timed ? State.accent : Palette.muted;
                                font-size: 9px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// 4. Edit lyrics
component EditLyricsModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;

        Text {
            text: State.edit-lyrics-source-label;
            color: Palette.muted-2;
            font-size: 10px;
        }

        HorizontalLayout {
            spacing: 10px;
            TextBtn {
                label: "Stamp position";
                clicked => { Actions.stamp-lyric-position(); }
            }
            ModalField {
                label: "Offset (ms)";
                text: State.edit-lyrics-offset;
                changed(v) => { State.edit-lyrics-offset = v; }
                field-width: 120px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Switch {
                    checked: State.edit-lyrics-sidecar;
                    toggled => { State.edit-lyrics-sidecar = self.checked; }
                }
                Text {
                    text: "Sidecar file";
                    color: Palette.muted-2;
                    font-size: 9px;
                }
            }
        }

        Rectangle {
            height: 240px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            background: Palette.panel-2;
            TextEdit {
                width: parent.width;
                height: parent.height;
                text <=> State.edit-lyrics-text;
                font-size: 12px;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            TextBtn {
                label: "Remove";
                danger: true;
                clicked => { Actions.remove-lyrics(); }
            }
            Rectangle { horizontal-stretch: 1; }
            TextBtn {
                label: "Save";
                primary: true;
                clicked => { Actions.save-lyrics-modal(); }
            }
        }
    }
}

// 6. Library folders
component FoldersModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                for rootEntry in State.folder-roots : Rectangle {
                    height: 52px;
                    border-radius: 6px;
                    background: Palette.panel-2;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        Image {
                            source: @image-url("../assets/icons/folder.svg");
                            width: 16px;
                            height: 16px;
                            colorize: State.accent;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: rootEntry.path;
                                color: Palette.text-strong;
                                font-size: 11px;
                                overflow: elide;
                            }
                            Text {
                                text: rootEntry.is-available ? "Available" : "Unavailable — reconnect this drive.";
                                color: rootEntry.is-available ? Palette.muted-2 : #ffb04a;
                                font-size: 9px;
                            }
                        }
                        TextBtn {
                            label: "Remove";
                            danger: true;
                            height: 28px;
                            clicked => { Actions.confirm-remove-root(rootEntry.path); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            TextBtn {
                label: "Add folder…";
                clicked => { Actions.pick-library-root(); }
            }
            TextBtn {
                label: "Rescan library";
                primary: true;
                clicked => { Actions.scan-library(); }
            }
        }
    }
}

// 7. Scan exclusions
component ExclusionsModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;

        Text {
            text: "Audio files are indexed for playback. Video files are opened in their own window when supported.";
            color: Palette.muted;
            font-size: 10px;
            wrap: word-wrap;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 4px;
                for ext in State.exclusion-extensions : Rectangle {
                    height: 36px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: ext.extension;
                            color: Palette.text-strong;
                            font-size: 11px;
                            width: 70px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: ext.enabled ? "· included in scans" : "· excluded from scans";
                            color: ext.enabled ? State.accent : Palette.muted-2;
                            font-size: 10px;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Switch {
                            checked: ext.enabled;
                            toggled => { Actions.set-extension-enabled(ext.extension, self.checked); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            LineEdit {
                width: 130px;
                height: 30px;
                placeholder-text: ".mkv";
                text <=> State.exclusion-new-extension;
            }
            ComboBox {
                width: 110px;
                model: ["Audio", "Video"];
                current-value: State.exclusion-new-kind;
                selected(value) => { State.exclusion-new-kind = value; }
            }
            TextBtn {
                label: "Add and enable";
                clicked => { Actions.add-extension(); }
            }
        }

        SectionTitle { text: "Ignored folders"; }
        ScrollView {
            height: 110px;
            VerticalLayout {
                spacing: 6px;
                for dir in State.ignored-directories : HorizontalLayout {
                    spacing: 10px;
                    height: 28px;
                    Text {
                        text: dir;
                        color: Palette.muted;
                        font-size: 10px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    IcBtn {
                        icon: @image-url("../assets/icons/close.svg");
                        icon-size: 11px;
                        width: 24px;
                        height: 24px;
                        tint: Palette.muted-2;
                        hover-tint: #ff5b74;
                        clicked => { Actions.remove-ignored-directory(dir); }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            TextBtn {
                label: "Add ignored folder…";
                clicked => { Actions.pick-ignored-directory(); }
            }
        }
    }
}

// 8. Playlist dialogs
component AddToPlaylistModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                for name in State.playlist-names : TouchArea {
                    height: 34px;
                    clicked => { Actions.add-track-to-playlist(State.add-to-playlist-id, name); }
                    Text {
                        text: name;
                        color: Palette.text-strong;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            TextBtn {
                label: "New playlist…";
                clicked => { Actions.open-modal("new-playlist"); }
            }
        }
    }
}

component NameModal inherits Rectangle {
    in property <string> placeholder: "";
    in property <string> action: "OK";
    callback submit(string);

    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;

        LineEdit {
            height: 34px;
            placeholder-text: root.placeholder;
            text <=> State.modal-text;
            accepted(text) => { root.submit(text); }
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            TextBtn {
                label: root.action;
                primary: true;
                clicked => { root.submit(State.modal-text); }
            }
        }
    }
}

// 10. Confirmations
component ConfirmModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;

        Text {
            text: State.confirm-message;
            color: Palette.text-strong;
            font-size: 12px;
            wrap: word-wrap;
        }

        if State.confirm-has-choices : ComboBox {
            width: 100%;
            model: State.confirm-choices;
            current-value: State.confirm-choice;
            selected(value) => { State.confirm-choice = value; }
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            TextBtn {
                label: "Cancel";
                clicked => { Actions.close-modal(); }
            }
            TextBtn {
                label: "Confirm";
                danger: State.confirm-danger;
                clicked => { Actions.confirm-action(); }
            }
        }
    }
}

// 9. Rating
component RatingModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Chip {
                label: "Unrated";
                active: State.rate-value == 0;
                clicked => { Actions.rate-track(0); }
            }
            Chip {
                label: "1 ★";
                active: State.rate-value >= 1;
                clicked => { Actions.rate-track(1); }
            }
            Chip {
                label: "2 ★";
                active: State.rate-value >= 2;
                clicked => { Actions.rate-track(2); }
            }
            Chip {
                label: "3 ★";
                active: State.rate-value >= 3;
                clicked => { Actions.rate-track(3); }
            }
            Chip {
                label: "4 ★";
                active: State.rate-value >= 4;
                clicked => { Actions.rate-track(4); }
            }
            Chip {
                label: "5 ★";
                active: State.rate-value >= 5;
                clicked => { Actions.rate-track(5); }
            }
        }
    }
}

// 12. Duplicate locations
component LocationsModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                for location in State.duplicate-locations : HorizontalLayout {
                    spacing: 10px;
                    height: 32px;
                    Text {
                        text: location;
                        color: Palette.text-subtle;
                        font-size: 10px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    TextBtn {
                        label: "Show in folder";
                        height: 26px;
                        clicked => { Actions.open-file-location-at(location); }
                    }
                }
            }
        }
    }
}

// Reset dialog with three checkbox groups.
component ResetModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;

        CheckBox {
            text: "Reset view and appearance settings";
            checked <=> State.reset-appearance;
        }
        CheckBox {
            text: "Reset panels and navigation settings";
            checked <=> State.reset-playback;
        }
        CheckBox {
            text: "Reset library display settings";
            checked <=> State.reset-library;
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            TextBtn {
                label: "Reset";
                danger: true;
                clicked => {
                    Actions.reset-settings(
                        (State.reset-appearance ? "appearance," : "")
                        + (State.reset-playback ? "layout," : "")
                        + (State.reset-library ? "libraryDisplay" : "")
                    );
                }
            }
        }
    }
}

// 11. Update available
component UpdateModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;

        Text {
            text: "Music Player \{State.update-tag} is available";
            color: Palette.text;
            font-size: 14px;
            font-weight: 750;
        }
        Text {
            text: "You can view the release notes on GitHub. The download always opens in your browser.";
            color: Palette.muted;
            font-size: 11px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            TextBtn {
                label: "Later";
                clicked => { Actions.close-modal(); }
            }
            TextBtn {
                label: "View release";
                primary: true;
                clicked => { Actions.open-release(); }
            }
        }
    }
}

// ---- Modal host -----------------------------------------------------------------------
component ImmersivePlayerOverlay inherits Rectangle {
    background: #10110f;
    clip: true;

    if State.current-has-cover : Image {
        source: State.current-cover;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width * 1.15;
        height: parent.height * 1.15;
        image-fit: ImageFit.cover;
        opacity: 0.22;
    }
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, #10110f40 0%, #10110fe0 100%);
    }
    Rectangle {
        width: 100%;
        height: 100%;
        background: State.accent.with-alpha(0.04);
    }

    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-top: 14px;
        padding-bottom: 22px;
        spacing: 12px;

        HorizontalLayout {
            height: 48px;
            spacing: 12px;
            alignment: center;
            Text {
                text: "NOW PLAYING";
                color: #ffffffb0;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1.5px;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: fs-ta.has-hover ? #ffffff2a : #00000052;
                animate background { duration: 150ms; }
                fs-ta := TouchArea { clicked => { Actions.toggle-immersive-fullscreen(); } }
                Image {
                    source: State.immersive-fullscreen ? @image-url("../assets/icons/compress.svg") : @image-url("../assets/icons/expand.svg");
                    width: 16px;
                    height: 16px;
                    colorize: #ffffff;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            Rectangle {
                height: 36px;
                border-radius: 18px;
                background: close-ta.has-hover ? #ffffff2a : #00000052;
                animate background { duration: 150ms; }
                close-ta := TouchArea { clicked => { Actions.close-immersive-player(); } }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 14px;
                    spacing: 8px;
                    alignment: center;
                    Image {
                        source: @image-url("../assets/icons/close.svg");
                        width: 14px;
                        height: 14px;
                        colorize: #ffffff;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Close";
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding-left: 20px;
            padding-right: 20px;
            spacing: State.immersive-lyrics-open ? 44px : 0px;

            VerticalLayout {
                alignment: center;
                spacing: 16px;
                horizontal-stretch: State.immersive-lyrics-open ? 0.85 : 1;

                Rectangle {
                    width: max(320px, min(State.window-width * 1px * (State.immersive-lyrics-open ? 0.30 : 0.40), State.immersive-lyrics-open ? 380px : 480px));
                    height: self.width;
                    border-radius: 16px;
                    clip: true;
                    background: State.current-badge-bg;
                    border-width: 1px;
                    border-color: #ffffff1c;
                    if State.current-has-cover : Image {
                        source: State.current-cover;
                        width: parent.width;
                        height: parent.height;
                        image-fit: ImageFit.cover;
                    }
                    if !State.current-has-cover : Text {
                        text: State.current-initials;
                        color: #ffffffcc;
                        font-size: 64px;
                        font-weight: 900;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                HorizontalLayout {
                    width: max(320px, min(State.window-width * 1px * (State.immersive-lyrics-open ? 0.30 : 0.40), State.immersive-lyrics-open ? 380px : 480px));
                    spacing: 12px;
                    alignment: center;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text {
                            text: State.has-track ? State.current-title : "Nothing playing";
                            color: #ffffff;
                            font-size: 26px;
                            font-weight: 800;
                            letter-spacing: -0.5px;
                            overflow: elide;
                        }
                        Text {
                            text: State.has-track ? State.current-artist : "Choose a song from your library";
                            color: #ffffffb3;
                            font-size: 14px;
                            overflow: elide;
                        }
                    }

                    if State.has-track : IcBtn {
                        icon: State.current-favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                        tint: State.current-favorite ? State.accent : #ffffffb3;
                        icon-size: 20px;
                        width: 40px;
                        height: 40px;
                        clicked => { Actions.toggle-favorite(State.current-id); }
                    }
                }
            }

            if State.immersive-lyrics-open : VerticalLayout {
                horizontal-stretch: 1;
                height: 100%;
                spacing: 8px;
                HorizontalLayout {
                    height: 38px;
                    alignment: center;
                    Text {
                        text: State.lyrics-source == "sidecar" ? "Lyrics · Sidecar" : (State.lyrics-source == "embedded" ? "Lyrics · Embedded" : "Lyrics");
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 750;
                        letter-spacing: 0.1px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if State.lyrics-scroll-paused : TextBtn {
                        label: "Resume";
                        clicked => { Actions.lyrics-scroll-changed(false); }
                    }
                    IcBtn {
                        icon: @image-url("../assets/icons/close.svg");
                        icon-size: 14px;
                        width: 32px;
                        height: 32px;
                        tint: #d0d2ce;
                        clicked => { Actions.toggle-immersive-lyrics(); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    Flickable {
                        content-y: min(0px, - State.lyrics-active-line * 44px + parent.height * 0.38);
                        animate content-y { duration: 250ms; easing: ease-out; }
                        VerticalLayout {
                            for line[index] in State.lyrics-lines : TouchArea {
                                height: 44px;
                                clicked => { if (State.lyrics-timed && State.seek-from-lyrics) { Actions.seek-to-lyric(index); } }
                                Text {
                                    text: line.text;
                                    color: line.is-active ? #ffffff : (line.is-past ? #a4a8a18c : #e3e4df8c);
                                    font-size: line.is-active ? 24px : 18px;
                                    font-weight: line.is-active ? 800 : 550;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                            if State.lyrics-lines.length == 0 : Text {
                                text: "No lyrics loaded. Use the Lyrics view to search or edit this track.";
                                color: #d0d2ce;
                                font-size: 13px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 10px;
            alignment: center;

            HorizontalLayout {
                width: min(parent.width, 920px);
                alignment: center;
                Text { text: State.current-time; color: #d0d2ce; width: 44px; font-size: 12px; vertical-alignment: center; }
                PlayerSlider {
                    horizontal-stretch: 1;
                    minimum: 0.0;
                    maximum: 1.0;
                    value: State.progress;
                    changed(val) => { Actions.seek-fraction(val); }
                    scrolled(event) => {
                        let delta = event.delta-y > 0px ? 5 : (event.delta-y < 0px ? -5 : 0);
                        if (delta != 0) {
                            Actions.seek-relative(delta);
                            return accept;
                        }
                        reject
                    }
                }
                Text { text: State.total-time; color: #d0d2ce; width: 44px; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
            }

            HorizontalLayout {
                height: 70px;
                spacing: 36px;
                alignment: center;
                IcBtn {
                    icon: @image-url("../assets/icons/skip-back.svg");
                    icon-size: 24px;
                    width: 48px;
                    height: 48px;
                    tint: #f3f4f0;
                    clicked => { Actions.previous(); }
                }
                Rectangle {
                    width: 70px;
                    height: 70px;
                    border-radius: 35px;
                    background: play-ta.has-hover ? #f0f0f0 : #ffffff;
                    animate background { duration: 120ms; }
                    Image {
                        source: State.is-playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg");
                        width: 28px;
                        height: 28px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: #161714;
                    }
                    play-ta := TouchArea { clicked => { Actions.toggle-play(); } }
                }
                IcBtn {
                    icon: @image-url("../assets/icons/skip-forward.svg");
                    icon-size: 24px;
                    width: 48px;
                    height: 48px;
                    tint: #f3f4f0;
                    clicked => { Actions.next(); }
                }
            }

            HorizontalLayout {
                height: 44px;
                spacing: 30px;
                alignment: center;
                IcBtn {
                    icon: @image-url("../assets/icons/equalizer.svg");
                    icon-size: 20px;
                    width: 44px;
                    height: 44px;
                    tint: #d0d2ce;
                    clicked => { Actions.toggle-immersive("Audio"); }
                }
                IcBtn {
                    icon: @image-url("../assets/icons/lyrics.svg");
                    icon-size: 20px;
                    width: 44px;
                    height: 44px;
                    active: State.immersive-lyrics-open;
                    tint: State.immersive-lyrics-open ? #ffffff : #d0d2ce;
                    clicked => { Actions.toggle-immersive-lyrics(); }
                }
                IcBtn {
                    icon: @image-url("../assets/icons/queue.svg");
                    icon-size: 20px;
                    width: 44px;
                    height: 44px;
                    tint: #d0d2ce;
                    clicked => { Actions.toggle-immersive("Queue"); }
                }
            }
        }
    }
}

component ModalHost inherits Rectangle {
    background: #00000094;

    // Body per modal kind, sized by the header.
    in property <length> modal-width: 460px;
    in property <length> modal-height: 420px;

    TouchArea {
        clicked => { Actions.close-modal(); }
    }

    Rectangle {
        width: root.modal-width;
        height: root.modal-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 13px;
        background: Palette.panel;
        border-width: 1px;
        border-color: Palette.border;
        clip: true;

        VerticalLayout {
            // Header
            HorizontalLayout {
                height: 48px;
                padding-left: 18px;
                padding-right: 12px;
                Text {
                    text: State.modal-title;
                    color: Palette.text;
                    font-size: 14px;
                    font-weight: 750;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                IcBtn {
                    icon: @image-url("../assets/icons/close.svg");
                    icon-size: 13px;
                    tint: Palette.muted-2;
                    clicked => { Actions.close-modal(); }
                }
            }
            Rectangle { height: 1px; background: Palette.border; }

            // Body
            Rectangle {
                vertical-stretch: 1;
                if State.modal == "tags" : TagsModal { }
                if State.modal == "details" : DetailsModal { }
                if State.modal == "find-lyrics" : FindLyricsModal { }
                if State.modal == "edit-lyrics" : EditLyricsModal { }
                if State.modal == "folders" : FoldersModal { }
                if State.modal == "exclusions" : ExclusionsModal { }
                if State.modal == "add-to-playlist" : AddToPlaylistModal { }
                if State.modal == "new-playlist" : NameModal { placeholder: "Playlist name"; action: "Create"; submit(text) => { Actions.create-playlist(text); } }
                if State.modal == "rename-playlist" : NameModal { placeholder: "New name"; action: "Rename"; submit(text) => { Actions.rename-playlist(State.view-playlist-id, text); } }
                if State.modal == "save-preset" : NameModal { placeholder: "Preset name"; action: "Save"; submit(text) => { Actions.save-eq-preset(text); } }
                if State.modal == "confirm" : ConfirmModal { }
                if State.modal == "rating" : RatingModal { }
                if State.modal == "duplicate-locations" : LocationsModal { }
                if State.modal == "reset" : ResetModal { }
                if State.modal == "update" : UpdateModal { }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: State.current-title == "" ? "Music Player" : "\{State.current-title} — \{State.current-artist} | Music Player";
    min-width: 980px;
    min-height: 640px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Palette.canvas;

    changed width => { State.window-width = round(self.width / 1px); }

    init => { Actions.ui-ready(); }

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (State.context-visible) {
                    Actions.close-context-menu();
                    return accept;
                }
                if (State.modal != "") {
                    Actions.close-modal();
                    return accept;
                }
                if (State.immersive-open) {
                    Actions.close-immersive();
                    return accept;
                }
                if (State.immersive-player-open) {
                    Actions.close-immersive-player();
                    return accept;
                }
                if (State.immersive-fullscreen) {
                    Actions.toggle-immersive-fullscreen();
                    return accept;
                }
                if (State.scan-details-open) {
                    State.scan-details-open = false;
                    return accept;
                }
            }

            // Global Ctrl+K: focus global search (navigates to Search view if not in Search/Settings)
            if (event.modifiers.control && (event.text == "k" || event.text == "K")) {
                if (State.view != "Search" && State.view != "Settings") {
                    Actions.set-view("Search", State.view-search, "", "");
                }
                topbar.focus-search();
                return accept;
            }

            // Global F11: toggle fullscreen
            if (event.text == Key.F11) {
                Actions.toggle-immersive-fullscreen();
                return accept;
            }

            if (State.modal == "" && !State.context-visible && !topbar.search-has-focus) {
                // Space: toggle play/pause
                if (event.text == " ") {
                    Actions.toggle-play();
                    return accept;
                }
                // Left / Right arrows: seek backward/forward (5s; 10s if shift)
                // Ctrl+Left / Ctrl+Right: previous / next track
                if (event.text == Key.LeftArrow) {
                    if (event.modifiers.control) {
                        Actions.previous();
                    } else {
                        Actions.seek-relative(event.modifiers.shift ? -10 : -5);
                    }
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    if (event.modifiers.control) {
                        Actions.next();
                    } else {
                        Actions.seek-relative(event.modifiers.shift ? 10 : 5);
                    }
                    return accept;
                }
                // Up / Down arrows: volume up / down (5%; 10% if shift)
                if (event.text == Key.UpArrow) {
                    Actions.volume-changed(min(100, State.volume + (event.modifiers.shift ? 10 : 5)));
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    Actions.volume-changed(max(0, State.volume - (event.modifiers.shift ? 10 : 5)));
                    return accept;
                }
                // M: toggle mute
                if (event.text == "m" || event.text == "M") {
                    Actions.set-volume-muted();
                    return accept;
                }
                // L: toggle lyrics view (navigates to Lyrics in normal view; toggles lyrics in immersive player)
                if (event.text == "l" || event.text == "L") {
                    if (State.immersive-player-open) {
                        Actions.toggle-immersive-lyrics();
                    } else if (State.view == "Lyrics") {
                        Actions.go-back();
                    } else {
                        Actions.set-view("Lyrics", "", "", "");
                    }
                    return accept;
                }
                // F11 or I: toggle immersive player / fullscreen
                if (event.text == "i" || event.text == "I") {
                    if (State.immersive-player-open) {
                        Actions.close-immersive-player();
                    } else {
                        Actions.open-immersive-player();
                    }
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    Actions.toggle-shuffle();
                    return accept;
                }
                if (event.text == "r" || event.text == "R") {
                    Actions.cycle-repeat();
                    return accept;
                }
            }
            reject
        }
    }

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;
            NavRail { }
            VerticalLayout {
                vertical-stretch: 1;
                topbar := TopBar { }
                HorizontalLayout {
                    vertical-stretch: 1;
                    Rectangle {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        clip: true;
                        background: Palette.surface;
                        ContentArea { width: 100%; height: 100%; }
                    }
                    RightPanel { }
                }
            }
        }
        PlayerBar { }
    }

    PanelResizeHandle { available-width: parent.width; available-height: parent.height - 88px; }
    PanelResizeHandle { right-side: true; available-width: parent.width; available-height: parent.height - 88px; }

    if State.immersive-player-open : ImmersivePlayerOverlay { width: 100%; height: 100%; }

    // Immersive drawer overlay: re-parents the content area with Queue/Audio.
    if State.immersive-open && State.immersive-player-open : Rectangle {
        x: parent.width - self.width - 20px;
        y: 68px;
        width: min(State.immersive-kind == "Queue" ? 480px : 780px, parent.width - 40px);
        height: max(180px, parent.height - 68px - 170px);
        border-radius: 18px;
        border-width: 1px;
        border-color: #ffffff24;
        background: #171917f2;
        clip: true;
        VerticalLayout {
            HorizontalLayout {
                height: 54px;
                padding-left: 18px;
                padding-right: 14px;
                Text {
                    text: State.immersive-kind;
                    color: #f7f8f6;
                    font-size: 16px;
                    font-weight: 750;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IcBtn {
                    icon: @image-url("../assets/icons/close.svg");
                    icon-size: 13px;
                    tint: Palette.muted-2;
                    clicked => { Actions.close-immersive(); }
                }
            }
            Rectangle { height: 1px; background: #ffffff1c; }
            Rectangle {
                vertical-stretch: 1;
                if State.immersive-kind == "Queue" : QueueView { }
                if State.immersive-kind == "Audio" : AudioView { }
            }
        }
    }

    if State.tools-menu-open : ToolsMenuOverlay { width: 100%; height: 100%; }
    if State.context-visible : ContextMenuOverlay { width: 100%; height: 100%; }
    if State.notice-visible : NoticeOverlay { width: 100%; height: 100%; }
    if State.modal != "" : ModalHost { width: 100%; height: 100%; }
}
