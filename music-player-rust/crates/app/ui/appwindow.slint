// 7. Scan exclusions
component ExclusionsModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;

        Text {
            text: "Audio files are indexed for playback. Video files are opened in their own window when supported.";
            color: #a0a79f;
            font-size: 10px;
            wrap: word-wrap;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 4px;
                for ext in State.exclusion-extensions : Rectangle {
                    height: 36px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: ext.extension;
                            color: #f2f4f1;
                            font-size: 11px;
                            width: 70px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: ext.enabled ? "· included in scans" : "· excluded from scans";
                            color: ext.enabled ? State.accent : #717970;
                            font-size: 10px;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Switch {
                            checked: ext.enabled;
                            toggled => { Actions.set-extension-enabled(ext.extension, self.checked); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            LineEdit {
                width: 130px;
                height: 30px;
                placeholder-text: ".mkv";
                text <=> State.exclusion-new-extension;
            }
            ComboBox {
                width: 110px;
                model: ["Audio", "Video"];
                current-value: State.exclusion-new-kind;
                selected(value) => { State.exclusion-new-kind = value; }
            }
            TextBtn {
                label: "Add and enable";
                clicked => { Actions.add-extension(); }
            }
        }

        SectionTitle { text: "Ignored folders"; }
        ScrollView {
            height: 110px;
            VerticalLayout {
                spacing: 6px;
                for dir in State.ignored-directories : HorizontalLayout {
                    spacing: 10px;
                    height: 28px;
                    Text {
                        text: dir;
                        color: #a0a79f;
                        font-size: 10px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    IcBtn {
                        icon: @image-url("../assets/icons/close.svg");
                        icon-size: 11px;
                        width: 24px;
                        height: 24px;
                        tint: #717970;
                        hover-tint: #ff5b74;
                        clicked => { Actions.remove-ignored-directory(dir); }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            TextBtn {
                label: "Add ignored folder…";
                clicked => { Actions.pick-ignored-directory(); }
            }
        }
    }
}

