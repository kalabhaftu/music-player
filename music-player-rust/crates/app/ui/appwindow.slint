            text <=> State.modal-text;
            accepted(text) => { root.submit(text); }
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            TextBtn {
                label: root.action;
                primary: true;
                clicked => { root.submit(State.modal-text); }
            }
        }
