import { State, Actions } from "../state.slint";
import { Palette, TextBtn, ActionBtn, Chip } from "../widgets.slint";
import { ComboBox } from "std-widgets.slint";

component CustomCheckBox inherits Rectangle {
    in property <bool> checked: false;
    callback toggled(bool);

    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.checked ? State.accent : Palette.border;
    background: root.checked ? State.accent : transparent;
    animate background { duration: 100ms; }

    TouchArea {
        clicked => { root.toggled(!root.checked); }
    }

    if root.checked : Text {
        text: "✓";
        color: #0a0b0a;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ResetChoiceRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in-out property <bool> checked: true;

    height: 48px;

    TouchArea {
        clicked => { root.checked = !root.checked; }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 11px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            CustomCheckBox {
                checked: root.checked;
                toggled(v) => { root.checked = v; }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Palette.text;
                font-size: 11px;
                font-weight: 700;
            }
            Text {
                text: root.description;
                color: Palette.muted;
                font-size: 10px;
                wrap: word-wrap;
            }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
}

export component ConfirmModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;

        Text {
            text: State.confirm-message;
            color: Palette.text-strong;
            font-size: 12px;
            wrap: word-wrap;
        }

        if State.confirm-has-choices : ComboBox {
            width: 100%;
            model: State.confirm-choices;
            current-value: State.confirm-choice;
            selected(value) => { State.confirm-choice = value; }
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            TextBtn {
                label: "Cancel";
                clicked => { Actions.close-modal(); }
            }
            TextBtn {
                label: "Confirm";
                danger: State.confirm-danger;
                clicked => { Actions.confirm-action(); }
            }
        }
    }
}

export component RatingModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Chip {
                label: "Unrated";
                active: State.rate-value == 0;
                clicked => { Actions.rate-track(0); }
            }
            Chip {
                label: "1 ★";
                active: State.rate-value >= 1;
                clicked => { Actions.rate-track(1); }
            }
            Chip {
                label: "2 ★";
                active: State.rate-value >= 2;
                clicked => { Actions.rate-track(2); }
            }
            Chip {
                label: "3 ★";
                active: State.rate-value >= 3;
                clicked => { Actions.rate-track(3); }
            }
            Chip {
                label: "4 ★";
                active: State.rate-value >= 4;
                clicked => { Actions.rate-track(4); }
            }
            Chip {
                label: "5 ★";
                active: State.rate-value >= 5;
                clicked => { Actions.rate-track(5); }
            }
        }
    }
}

export component ResetModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;

        Text {
            text: "Choose which interface preferences to restore. Every group is selected by default.";
            color: Palette.muted;
            font-size: 11px;
            wrap: word-wrap;
        }

        ResetChoiceRow {
            title: "Colors and appearance";
            description: "Theme, artwork palette, selection color, transparency, and motion";
            checked <=> State.reset-appearance;
        }
        ResetChoiceRow {
            title: "Panels and navigation";
            description: "Sidebar and Now Playing widths, collapse state, navigation order, and browse spacing";
            checked <=> State.reset-playback;
        }
        ResetChoiceRow {
            title: "Library display";
            description: "Visible song columns, resized column widths, and duplicate handling";
            checked <=> State.reset-library;
        }

        Rectangle { height: 4px; }

        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            ActionBtn {
                label: "Cancel";
                clicked => { Actions.close-modal(); }
            }
            ActionBtn {
                primary: true;
                label: "Reset selected settings";
                clicked => {
                    Actions.reset-settings(
                        (State.reset-appearance ? "appearance," : "")
                        + (State.reset-playback ? "layout," : "")
                        + (State.reset-library ? "libraryDisplay" : "")
                    );
                }
            }
        }
    }
}

export component UpdateModal inherits Rectangle {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;

        Text {
            text: "Music Player \{State.update-tag} is available";
            color: Palette.text;
            font-size: 14px;
            font-weight: 750;
        }
        Text {
            text: "You can view the release notes on GitHub. The download always opens in your browser.";
            color: Palette.muted;
            font-size: 11px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            TextBtn {
                label: "Later";
                clicked => { Actions.close-modal(); }
            }
            TextBtn {
                label: "View release";
                primary: true;
                clicked => { Actions.open-release(); }
            }
        }
    }
}
