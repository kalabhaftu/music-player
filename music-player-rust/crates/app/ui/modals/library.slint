import { State, Actions } from "../state.slint";
import { Palette, ActionBtn, CustomSelect, CustomToggle } from "../widgets.slint";
import { ScrollView } from "std-widgets.slint";
import { ModalInput, ModalFooterBar } from "common.slint";

export component FoldersModal inherits Rectangle {
    VerticalLayout {
        spacing: 0px;

        // Body
        VerticalLayout {
            vertical-stretch: 1;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 12px;

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 0px;
                    for rootEntry in State.folder-roots : Rectangle {
                        min-height: 54px;
                        background: transparent;

                        HorizontalLayout {
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 14px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                Text {
                                    text: rootEntry.is-available
                                        ? "\{rootEntry.name} · Available"
                                        : "\{rootEntry.name} · Unavailable";
                                    color: rootEntry.is-available ? Palette.text : Palette.muted;
                                    font-size: 12px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: rootEntry.is-available
                                        ? "\{rootEntry.path} · \{rootEntry.track-count} tracks"
                                        : "\{rootEntry.path} · \{rootEntry.track-count} tracks · Reconnect this drive, then rescan the library.";
                                    color: rootEntry.is-available ? Palette.muted : #ff5b74;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                ActionBtn {
                                    label: "Remove";
                                    clicked => { Actions.confirm-remove-root(rootEntry.path); }
                                }
                            }
                        }

                        Rectangle {
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: Palette.border;
                        }
                    }

                    if State.folder-roots.length == 0 : Rectangle {
                        height: 80px;
                        Text {
                            text: "No music folders added yet.";
                            color: Palette.muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // `.toolbar.modal-action-row`
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                ActionBtn {
                    label: "Add folder…";
                    clicked => { Actions.pick-library-root(); }
                }
                ActionBtn {
                    label: "Rescan library";
                    clicked => { Actions.scan-library(); }
                }
            }
        }

        ModalFooterBar {
            Rectangle { horizontal-stretch: 1; }
            ActionBtn {
                label: "Close";
                clicked => { Actions.close-modal(); }
            }
        }
    }
}

export component ExclusionsModal inherits Rectangle {
    VerticalLayout {
        spacing: 0px;

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 10px;

                Text {
                    text: "File extensions";
                    color: Palette.text;
                    font-size: 12px;
                    font-weight: 700;
                }
                Text {
                    text: "Audio types are included by default. Video types are off until enabled. Enabled video files open in a separate Music Player window and use the media engine already included with the app; playback still depends on the file’s codec.";
                    color: Palette.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    spacing: 0px;
                    for ext in State.exclusion-extensions : Rectangle {
                        min-height: 46px;
                        HorizontalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 12px;
                            alignment: center;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                alignment: center;
                                Text {
                                    text: ext.extension;
                                    color: Palette.text;
                                    font-size: 12px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: ext.enabled ? "\{ext.kind} file · included in scans" : "\{ext.kind} file · excluded from scans";
                                    color: Palette.muted;
                                    font-size: 10px;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                CustomToggle {
                                    checked: ext.enabled;
                                    toggled(v) => { Actions.set-extension-enabled(ext.extension, v); }
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: Palette.border;
                        }
                    }
                }

                // Inline add-extension control row matching WebUI `.field` + `.select` + `.action`
                HorizontalLayout {
                    padding-top: 4px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    alignment: start;

                    ModalInput {
                        width: 130px;
                        height: 34px;
                        placeholder: ".mkv";
                        text <=> State.exclusion-new-extension;
                        accepted(_) => { Actions.add-extension(); }
                    }
                    CustomSelect {
                        width: 110px;
                        height: 34px;
                        options: ["Audio", "Video"];
                        current-value: State.exclusion-new-kind;
                        selected(value) => { State.exclusion-new-kind = value; }
                    }
                    ActionBtn {
                        label: "Add and enable";
                        clicked => { Actions.add-extension(); }
                    }
                }

                Rectangle { height: 4px; }

                Text {
                    text: "Folders";
                    color: Palette.text;
                    font-size: 12px;
                    font-weight: 700;
                }
                Text {
                    text: "Windows and common app/cache locations are skipped automatically. Excluding a folder also excludes its subfolders.";
                    color: Palette.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    spacing: 0px;
                    for dir in State.ignored-directories : Rectangle {
                        min-height: 46px;
                        HorizontalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 12px;
                            alignment: center;
                            Text {
                                text: dir;
                                color: Palette.muted;
                                font-size: 11px;
                                horizontal-stretch: 1;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                ActionBtn {
                                    label: "Remove";
                                    clicked => { Actions.remove-ignored-directory(dir); }
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: Palette.border;
                        }
                    }
                }

                HorizontalLayout {
                    padding-top: 4px;
                    alignment: start;
                    ActionBtn {
                        label: "Add ignored folder…";
                        clicked => { Actions.pick-ignored-directory(); }
                    }
                }
            }
        }

        ModalFooterBar {
            Rectangle { horizontal-stretch: 1; }
            ActionBtn {
                label: "Close";
                clicked => { Actions.close-modal(); }
            }
        }
    }
}

export component LocationsModal inherits Rectangle {
    VerticalLayout {
        spacing: 0px;

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 0px;

                for location in State.duplicate-locations : Rectangle {
                    min-height: 48px;
                    HorizontalLayout {
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 12px;
                        alignment: center;
                        Text {
                            text: location;
                            color: Palette.text-subtle;
                            font-size: 11px;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            ActionBtn {
                                label: "Show in folder";
                                clicked => { Actions.open-file-location-at(location); }
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Palette.border;
                    }
                }
            }
        }

        ModalFooterBar {
            Rectangle { horizontal-stretch: 1; }
            ActionBtn {
                label: "Close";
                clicked => { Actions.close-modal(); }
            }
        }
    }
}
