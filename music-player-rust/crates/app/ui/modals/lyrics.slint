import { State, Actions } from "../state.slint";
import { Palette, TextBtn, CustomSelect } from "../widgets.slint";
import { LineEdit, TextEdit, ScrollView } from "std-widgets.slint";
import { ModalField } from "common.slint";

export component FindLyricsModal inherits Rectangle {
    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 14px;
        padding-bottom: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            ModalField {
                label: "Title";
                text: State.find-lyrics-title;
                changed(v) => { State.find-lyrics-title = v; }
                horizontal-stretch: 1;
            }
            ModalField {
                label: "Artist";
                text: State.find-lyrics-artist;
                changed(v) => { State.find-lyrics-artist = v; }
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            TextBtn {
                label: "Search LRCLIB";
                primary: true;
                height: 32px;
                clicked => { Actions.find-lyrics(); }
            }
            if State.lyrics-searching : HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Text {
                    text: "Searching LRCLIB…";
                    color: Palette.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
            if !State.lyrics-searching && State.lyrics-search-status != "" : Text {
                text: State.lyrics-search-status;
                color: #ffb04a;
                font-size: 11px;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                width: parent.width;
                spacing: 8px;
                if !State.lyrics-searching && State.lyrics-results.length == 0 && State.lyrics-search-status == "" : VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    padding-top: 40px;
                    padding-bottom: 40px;
                    Text {
                        text: "Enter a song title or artist and click Search LRCLIB.";
                        color: Palette.muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }
                for result in State.lyrics-results : Rectangle {
                    height: 52px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: result-area.has-hover ? State.accent : Palette.border;
                    background: result-area.has-hover ? #ffffff1a : #ffffff0d;
                    animate background { duration: 120ms; }
                    animate border-color { duration: 120ms; }
                    result-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Actions.use-lyric-result(result.timed ? result.synced-id : result.plain-id, result.timed); }
                    }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            Text {
                                text: result.title;
                                color: Palette.text;
                                font-size: 13px;
                                font-weight: 650;
                                overflow: elide;
                                min-width: 0px;
                            }
                            Text {
                                text: result.artist;
                                color: Palette.muted;
                                font-size: 11px;
                                font-weight: 500;
                                overflow: elide;
                                min-width: 0px;
                            }
                        }
                        Rectangle {
                            height: 22px;
                            border-radius: 999px;
                            border-width: 1px;
                            border-color: result.timed ? State.accent.with-alpha(0.35) : #ffffff1f;
                            background: result.timed ? State.accent.with-alpha(0.18) : #ffffff14;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                Text {
                                    text: result.badge;
                                    color: result.timed ? State.accent : Palette.muted;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 36px;
            alignment: end;
            TextBtn {
                label: "Close";
                height: 32px;
                clicked => { Actions.close-modal(); }
            }
        }
    }
}

export component EditLyricsModal inherits Rectangle {
    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 14px;
        padding-bottom: 16px;
        spacing: 10px;

        if State.current-title != "" : Text {
            text: "\{State.current-title} · \{State.current-artist}";
            color: Palette.text;
            font-size: 12px;
            font-weight: 650;
            overflow: elide;
        }

        Text {
            text: State.edit-lyrics-source-label;
            color: Palette.muted;
            font-size: 11px;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            TextBtn {
                label: "⏱ Stamp position";
                height: 32px;
                clicked => { Actions.stamp-lyric-position(); }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                Text {
                    text: "Offset (ms):";
                    color: Palette.muted;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                LineEdit {
                    width: 76px;
                    height: 32px;
                    text: State.edit-lyrics-offset;
                    edited(v) => { State.edit-lyrics-offset = v; }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                Text {
                    text: "Save to:";
                    color: Palette.muted;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                CustomSelect {
                    width: 175px;
                    options: ["Embed in audio file", "Save beside audio file"];
                    current-value: State.edit-lyrics-sidecar ? "Save beside audio file" : "Embed in audio file";
                    selected(v) => { State.edit-lyrics-sidecar = v == "Save beside audio file"; }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: 260px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            background: Palette.panel-2;
            clip: true;
            TextEdit {
                width: 100%;
                height: 100%;
                text <=> State.edit-lyrics-text;
                font-size: 12px;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            height: 36px;
            alignment: center;
            TextBtn {
                label: "Remove lyrics";
                danger: true;
                height: 32px;
                clicked => { Actions.remove-lyrics(); }
            }
            Rectangle { horizontal-stretch: 1; }
            TextBtn {
                label: "Cancel";
                height: 32px;
                clicked => { Actions.close-modal(); }
            }
            TextBtn {
                label: "Save lyrics";
                primary: true;
                height: 32px;
                clicked => { Actions.save-lyrics-modal(); }
            }
        }
    }
}
