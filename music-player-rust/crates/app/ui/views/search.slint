import { State, Actions } from "../state.slint";
import { TrackItem, GroupItem } from "../models.slint";
import { Palette, ActionBtn, EmptyState, TrackRow, TrackHeader, TrackTable, GroupGrid, CardTile, Chip } from "../widgets.slint";
import { PlaylistsList } from "playlists.slint";
import { ScrollView, ListView } from "std-widgets.slint";

// ---- Search -----------------------------------------------------------------
component SearchSectionHeader inherits Rectangle {
    in property <string> title;
    in property <int> count: 0;
    in property <bool> show-see-all: true;
    callback see-all();

    height: 26px;
    HorizontalLayout {
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: Palette.text-strong;
                font-size: 19px;
                font-weight: 750;
                letter-spacing: -0.65px;
                vertical-alignment: center;
            }
            if root.count > 0 : Text {
                text: "\{root.count}";
                color: Palette.muted;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        if root.show-see-all : Rectangle {
            width: 56px;
            height: 26px;
            Text {
                text: "See all";
                color: see-all-area.has-hover ? Palette.text : Palette.muted;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
                animate color { duration: 100ms; }
            }
            see-all-area := TouchArea { clicked => { root.see-all(); } }
        }
    }
}

export component SearchView inherits Rectangle {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 32px;
        spacing: 16px;

        // View Header: Title and subtitle matching WebUI
        VerticalLayout {
            spacing: 5px;
            Text {
                text: "Search";
                color: Palette.text;
                font-size: 30px;
                font-weight: 800;
                letter-spacing: -0.65px;
            }
            Text {
                text: State.view-search != ""
                    ? "Results in your local library for “\{State.view-search}”"
                    : "Find songs, artists, albums, and playlists.";
                color: Palette.muted;
                font-size: 12px;
            }
        }

        // Filter chips: All, Songs, Albums, Artists, Playlists (height 28px, border-radius 99px)
        if State.view-search != "" : HorizontalLayout {
            spacing: 6px;
            Chip {
                label: "All";
                active: State.search-filter == "all";
                clicked => { Actions.search(State.view-search, "all"); }
            }
            Chip {
                label: "Songs";
                active: State.search-filter == "song";
                clicked => { Actions.search(State.view-search, "song"); }
            }
            Chip {
                label: "Albums";
                active: State.search-filter == "album";
                clicked => { Actions.search(State.view-search, "album"); }
            }
            Chip {
                label: "Artists";
                active: State.search-filter == "artist";
                clicked => { Actions.search(State.view-search, "artist"); }
            }
            Chip {
                label: "Playlists";
                active: State.search-filter == "playlist";
                clicked => { Actions.search(State.view-search, "playlist"); }
            }
        }

        // Recent searches when query is empty
        if State.view-search == "" && State.recent-searches.length > 0 : VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                Text {
                    text: "Recent searches";
                    color: Palette.text-strong;
                    font-size: 19px;
                    font-weight: 750;
                    letter-spacing: -0.65px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                ActionBtn {
                    label: "Clear all";
                    clicked => { Actions.clear-recent-searches(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                for term in State.recent-searches : Rectangle {
                    height: 28px;
                    border-radius: 99px;
                    background: Palette.panel-2;
                    border-width: 1px;
                    border-color: Palette.border-soft;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        spacing: 6px;
                        alignment: center;

                        TouchArea {
                            clicked => { Actions.search(term, "all"); }
                            HorizontalLayout {
                                spacing: 4px;
                                Image {
                                    source: @image-url("../../assets/icons/search.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: Palette.muted;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: term;
                                    color: Palette.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            close-area := TouchArea {
                                clicked => { Actions.remove-recent-search(term); }
                            }
                            Text {
                                text: "×";
                                color: close-area.has-hover ? #ff5b74 : Palette.muted;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Empty state when search query is empty
        if State.view-search == "" : EmptyState {
            vertical-stretch: 1;
            text: "Search your library";
            subtitle: "Type in the search field above to find songs, albums, and artists.";
        }

        // All results: sections with section headers and "See all" buttons
        if State.view-search != "" && State.search-filter == "all" : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 24px;

                // Songs table for matched songs
                if State.search-song-count > 0 : VerticalLayout {
                    spacing: 12px;
                    SearchSectionHeader {
                        title: "Songs";
                        count: State.search-song-count;
                        see-all => { Actions.search(State.view-search, "song"); }
                    }
                    TrackTable {
                        scrollable: false;
                        show-added: false;
                        first-column: "Title";
                        sort(column) => { Actions.sort-view(column); }
                        empty-text: "No matching songs.";
                    }
                }

                // Card grid for matched albums
                if State.search-album-count > 0 : VerticalLayout {
                    spacing: 12px;
                    SearchSectionHeader {
                        title: "Albums";
                        count: State.search-album-count;
                        see-all => { Actions.search(State.view-search, "album"); }
                    }
                    GroupGrid {
                        scrollable: false;
                        kind: "album";
                        items: State.search-albums;
                        show-load-more: false;
                        empty-text: "No matching albums.";
                    }
                }

                // Round avatar grid for matched artists
                if State.search-artist-count > 0 : VerticalLayout {
                    spacing: 12px;
                    SearchSectionHeader {
                        title: "Artists";
                        count: State.search-artist-count;
                        see-all => { Actions.search(State.view-search, "artist"); }
                    }
                    GroupGrid {
                        scrollable: false;
                        round: true;
                        kind: "artist";
                        items: State.search-artists;
                        show-load-more: false;
                        empty-text: "No matching artists.";
                    }
                }

                // Playlists grid
                if State.search-playlist-count > 0 : VerticalLayout {
                    spacing: 12px;
                    SearchSectionHeader {
                        title: "Playlists";
                        count: State.search-playlist-count;
                        see-all => { Actions.search(State.view-search, "playlist"); }
                    }
                    PlaylistsList { }
                }

                if State.search-song-count + State.search-album-count + State.search-artist-count + State.search-playlist-count == 0 : EmptyState {
                    text: "No results for “\{State.view-search}”";
                    subtitle: "Try another song, artist, album, or playlist name.";
                }
            }
        }

        // Filtered views
        if State.view-search != "" && State.search-filter == "song" : VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            SearchSectionHeader {
                title: "Songs";
                count: State.search-song-count;
                show-see-all: false;
            }
            TrackTable {
                vertical-stretch: 1;
                show-added: false;
                first-column: "Title";
                sort(column) => { Actions.sort-view(column); }
                empty-text: "No matching songs.";
            }
        }

        if State.view-search != "" && State.search-filter == "album" : VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            SearchSectionHeader {
                title: "Albums";
                count: State.search-album-count;
                show-see-all: false;
            }
            GroupGrid {
                vertical-stretch: 1;
                kind: "album";
                items: State.search-albums;
                empty-text: "No matching albums.";
            }
        }

        if State.view-search != "" && State.search-filter == "artist" : VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            SearchSectionHeader {
                title: "Artists";
                count: State.search-artist-count;
                show-see-all: false;
            }
            GroupGrid {
                vertical-stretch: 1;
                round: true;
                kind: "artist";
                items: State.search-artists;
                empty-text: "No matching artists.";
            }
        }

        if State.view-search != "" && State.search-filter == "playlist" : VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            SearchSectionHeader {
                title: "Playlists";
                count: State.search-playlist-count;
                show-see-all: false;
            }
            PlaylistsList {
                vertical-stretch: 1;
            }
        }
    }
}


