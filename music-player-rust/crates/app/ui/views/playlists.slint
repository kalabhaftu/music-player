import { State, Actions } from "../state.slint";
import { PlaylistCardItem, PlaylistRowItem } from "../models.slint";
import { Palette, ActionBtn, EmptyState, TrackTable, HeroDetail, SectionTitle } from "../widgets.slint";
import { ScrollView, ListView } from "std-widgets.slint";

// ---- Playlists ---------------------------------------------------------------

component SmartPlaylistTile inherits Rectangle {
    in property <PlaylistCardItem> card;

    vertical-stretch: 0;
    horizontal-stretch: 0;
    width: State.card-width;
    border-radius: 8px;
    background: area.has-hover ? Palette.hover : Palette.raised;
    animate background { duration: 140ms; }

    area := TouchArea {
        clicked => { Actions.set-view(root.card.id, "", "", ""); }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        smart-cover := Rectangle {
            width: 100%;
            height: self.width;
            vertical-stretch: 0;
            horizontal-stretch: 0;
            border-radius: 6px;
            clip: true;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 14px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000040;
            background: root.card.id == "Most Played" ? @linear-gradient(135deg, #ff5e36 0%, #f32759 60%, #890b50 100%)
                : root.card.id == "With Lyrics" ? @linear-gradient(135deg, #8b5cf6 0%, #6366f1 60%, #1e1b4b 100%)
                : root.card.id == "Videos" ? @linear-gradient(135deg, #3b82f6 0%, #1d4ed8 60%, #0f172a 100%)
                : @linear-gradient(135deg, #10b981 0%, #06b6d4 60%, #134e4a 100%);

            Image {
                source: root.card.id == "Most Played" ? @image-url("../../assets/icons/trending.svg")
                    : root.card.id == "With Lyrics" ? @image-url("../../assets/icons/lyrics.svg")
                    : root.card.id == "Videos" ? @image-url("../../assets/icons/film.svg")
                    : @image-url("../../assets/icons/clock.svg");
                width: 36px;
                height: 36px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: #ffffff;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(180deg, transparent 45%, #00000047 100%);
            }

            Rectangle {
                width: 38px;
                height: 38px;
                x: parent.width - self.width - 10px;
                y: parent.height - self.height - 10px;
                border-radius: 19px;
                background: State.accent;
                opacity: area.has-hover ? 1.0 : 0.0;
                animate opacity { duration: 150ms; }

                Image {
                    source: @image-url("../../assets/icons/play.svg");
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2 + 1px;
                    y: (parent.height - self.height) / 2;
                    colorize: Palette.accent-ink;
                }

                TouchArea {
                    width: 44px;
                    height: 44px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    mouse-cursor: pointer;
                    clicked => { Actions.play-view(root.card.id); }
                }
            }
        }

        VerticalLayout {
            spacing: 4px;
            min-width: 0px;
            Text {
                text: root.card.name;
                color: Palette.text;
                font-size: 13px;
                font-weight: 750;
                overflow: elide;
            }
            if root.card.description != "" : Text {
                text: root.card.description;
                color: Palette.muted;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}

component PlaylistTile inherits Rectangle {
    in property <PlaylistCardItem> card;

    vertical-stretch: 0;
    horizontal-stretch: 0;
    width: State.card-width;
    border-radius: 8px;
    background: tile-area.has-hover ? Palette.hover : Palette.raised;
    animate background { duration: 140ms; }

    tile-area := TouchArea {
        clicked => {
            if (root.card.is-smart) { Actions.set-view(root.card.id, "", "", ""); }
            else { Actions.set-view("Playlist", "", "", root.card.id); }
        }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        tile := Rectangle {
            width: 100%;
            height: self.width;
            vertical-stretch: 0;
            horizontal-stretch: 0;
            border-radius: 6px;
            clip: true;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 14px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000040;
            background: root.card.is-smart
                ? (root.card.id == "Most Played" ? @linear-gradient(135deg, #ff5e36 0%, #f32759 60%, #890b50 100%)
                    : root.card.id == "With Lyrics" ? @linear-gradient(135deg, #8b5cf6 0%, #6366f1 60%, #1e1b4b 100%)
                    : root.card.id == "Videos" ? @linear-gradient(135deg, #3b82f6 0%, #1d4ed8 60%, #0f172a 100%)
                    : @linear-gradient(135deg, #10b981 0%, #06b6d4 60%, #134e4a 100%))
                : @linear-gradient(150deg, Palette.ga(root.card.gradient) 0%, Palette.badge(root.card.gradient) 58%, Palette.gb(root.card.gradient) 100%);

            if !root.card.is-smart : Text {
                text: root.card.initials;
                color: #ffffffe0;
                font-size: clamp(State.window-width * 0.02px, 16px, 26px);
                font-weight: 900;
                letter-spacing: -1px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            if root.card.is-smart : Image {
                source: root.card.id == "Most Played" ? @image-url("../../assets/icons/trending.svg")
                    : root.card.id == "With Lyrics" ? @image-url("../../assets/icons/lyrics.svg")
                    : root.card.id == "Videos" ? @image-url("../../assets/icons/film.svg")
                    : @image-url("../../assets/icons/clock.svg");
                width: 36px;
                height: 36px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: #ffffff;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(180deg, transparent 45%, #00000047 100%);
            }

            Rectangle {
                width: 38px;
                height: 38px;
                x: parent.width - self.width - 10px;
                y: parent.height - self.height - 10px;
                border-radius: 19px;
                background: State.accent;
                opacity: tile-area.has-hover ? 1.0 : 0.0;
                animate opacity { duration: 150ms; }

                Image {
                    source: @image-url("../../assets/icons/play.svg");
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2 + 1px;
                    y: (parent.height - self.height) / 2;
                    colorize: Palette.accent-ink;
                }

                TouchArea {
                    width: 44px;
                    height: 44px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.card.is-smart) { Actions.play-view(root.card.id); }
                        else { Actions.play-playlist(root.card.id); }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 4px;
            min-width: 0px;
            Text {
                text: root.card.name;
                color: Palette.text;
                font-size: 13px;
                font-weight: 750;
                overflow: elide;
            }
            if root.card.track-count > 0 : Text {
                text: root.card.track-count == 1 ? "1 song" : "\{root.card.track-count} songs";
                color: Palette.muted;
                font-size: 11px;
            }
            if root.card.is-smart : Text {
                text: root.card.description;
                color: Palette.muted-2;
                font-size: 10px;
                overflow: elide;
            }
        }
    }
}

export component PlaylistsList inherits Rectangle {
    if State.search-playlists.length == 0 : EmptyState { text: "No matching playlists."; }
    if State.search-playlists.length > 0 : GridLayout {
        width: 100%;
        spacing: Palette.card-gap(State.browse-width);
        for card[index] in State.search-playlists : PlaylistTile {
            card: card;
            col: Math.mod(index, State.card-columns);
            row: index / State.card-columns;
        }
    }
}

export component PlaylistsView inherits Rectangle {
    pls-sv := ScrollView {
        content-width: self.visible-width;
        VerticalLayout {
            width: pls-sv.visible-width;
            padding-left: State.window-width <= 650 ? 14px : 24px;
            padding-right: State.window-width <= 650 ? 14px : 24px;
            padding-top: 20px;
            padding-bottom: 32px;
            spacing: 0px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 5px;
                Text {
                    text: "Playlists";
                    color: Palette.text;
                    font-size: 30px;
                    font-weight: 700;
                    letter-spacing: -0.65px;
                }
                Text {
                    text: "Your playlists are stored on this PC.";
                    color: Palette.muted;
                    font-size: 12px;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            ActionBtn {
                label: "Import M3U / M3U8";
                clicked => { Actions.import-m3u(); }
            }
            ActionBtn {
                label: "＋ New playlist";
                primary: true;
                clicked => { Actions.open-modal("new-playlist"); }
            }
        }

        Rectangle { height: 24px; }

        VerticalLayout {
                spacing: 24px;
                if State.smart-playlists.length > 0 : VerticalLayout {
                    spacing: 13px;
                    SectionTitle { text: "Smart playlists"; }
                    GridLayout {
                        width: 100%;
                        spacing: Palette.card-gap(State.browse-width);
                        for card[index] in State.smart-playlists : SmartPlaylistTile {
                            card: card;
                            col: Math.mod(index, State.card-columns);
                            row: index / State.card-columns;
                        }
                    }
                }
                VerticalLayout {
                    spacing: 13px;
                    SectionTitle { text: "Your playlists"; }
                    if State.playlists.length == 0 : EmptyState {
                        text: "No playlists yet. Create one from any track's menu.";
                    }
                    if State.playlists.length > 0 : GridLayout {
                        width: 100%;
                        spacing: Palette.card-gap(State.browse-width);
                        for card[index] in State.playlists : PlaylistTile {
                            card: card;
                            col: Math.mod(index, State.card-columns);
                            row: index / State.card-columns;
                        }
                    }
                }
        }
      }
    }
}


// ---- Playlist detail ---------------------------------------------------------
export component PlaylistView inherits Rectangle {
    pl-sv := ScrollView {
        content-width: self.visible-width;
        VerticalLayout {
            width: pl-sv.visible-width;
            padding-left: State.window-width <= 650 ? 14px : 24px;
            padding-right: State.window-width <= 650 ? 14px : 24px;
            padding-top: 20px;
            padding-bottom: 32px;
            spacing: 0px;

        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 5px;
                horizontal-stretch: 1;
                Text {
                    text: State.playlist-name;
                    color: Palette.text;
                    font-size: 30px;
                    font-weight: 700;
                    letter-spacing: -0.65px;
                    overflow: elide;
                }
                if State.view-search == "" : Text {
                    text: "\{State.playlist-track-total} tracks";
                    color: Palette.muted;
                    font-size: 12px;
                }
                if State.view-search != "" : Text {
                    text: "\{State.playlist-track-total} matching tracks";
                    color: Palette.muted;
                    font-size: 12px;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                ActionBtn {
                    label: "Play";
                    primary: true;
                    clicked => { Actions.play-playlist(State.view-playlist-id); }
                }
                ActionBtn {
                    label: "Shuffle";
                    clicked => { Actions.play-playlist-shuffle(State.view-playlist-id); }
                }
                ActionBtn {
                    label: "Rename";
                    clicked => { Actions.open-modal("rename-playlist"); }
                }
                ActionBtn {
                    label: "Export";
                    clicked => { Actions.export-m3u(State.view-playlist-id); }
                }
                ActionBtn {
                    label: "Delete";
                    danger: true;
                    clicked => { Actions.delete-playlist(State.view-playlist-id); }
                }
            }
        }

        Rectangle { height: 22px; }

        if State.tracks.length == 0 && !State.page-loading : EmptyState {
            text: State.view-search == "" ? "This playlist is empty" : "No tracks match this search";
            subtitle: State.view-search == "" ? "Add tracks from your library to get started." : "Try another title, artist, or album.";
        }
        if State.tracks.length > 0 || State.page-loading : TrackTable {
            scrollable: false;
            show-added: false;
            show-year: false;
            first-column: "TITLE";
            show-remove: true;
            sort(column) => { Actions.sort-view(column); }
            empty-text: "";
        }
      }
    }
}

