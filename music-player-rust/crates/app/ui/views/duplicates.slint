import { State, Actions } from "../state.slint";
import { ListView } from "std-widgets.slint";
import { Palette, ActionBtn, TrackHeader, TrackTable, IcBtn } from "../widgets.slint";

// ---- Duplicates --------------------------------------------------------------
export component DuplicatesView inherits Rectangle {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 32px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 5px;
                horizontal-stretch: 1;
                Text {
                    text: "Duplicates";
                    color: Palette.text;
                    font-size: 30px;
                    font-weight: 800;
                    letter-spacing: -0.65px;
                }
                Text {
                    text: "Find and manage duplicate tracks across your collection.";
                    color: Palette.muted;
                    font-size: 12px;
                }
            }
            ActionBtn {
                label: "Rescan duplicates";
                primary: true;
                clicked => { Actions.prepare-duplicates(); }
            }
        }

        if State.duplicate-files.length == 0 : VerticalLayout {
            spacing: 12px;

            TrackHeader {
                first-column: "Title";
                show-added: false;
                show-year: false;
                show-album: true;
                sort(s) => { Actions.load-duplicates(s, State.duplicates-descending, 0); }
            }

            Rectangle {
                vertical-stretch: 1;
                ListView {
                    for row[index] in State.duplicates : Rectangle {
                        height: 48px;
                        background: dup-area.has-hover ? Palette.panel-2 : transparent;
                        dup-area := TouchArea {
                            clicked => { Actions.open-duplicate-files(row.first-id); }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            Text {
                                text: row.title;
                                color: Palette.text-strong;
                                font-size: 12px;
                                overflow: elide;
                                horizontal-stretch: 3;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.artist;
                                color: Palette.muted;
                                font-size: 11px;
                                overflow: elide;
                                horizontal-stretch: 3;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "\{row.copies}";
                                color: Palette.text-subtle;
                                font-size: 11px;
                                width: 60px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.locations;
                                color: Palette.muted-2;
                                font-size: 10px;
                                overflow: elide;
                                width: 220px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                alignment: center;
                ActionBtn {
                    label: "Previous";
                    clicked => { Actions.load-duplicates(State.duplicates-sort, State.duplicates-descending, State.duplicates-page - 1); }
                }
                Text {
                    text: "Page \{State.duplicates-page + 1} of \{State.duplicates-pages}";
                    color: Palette.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                ActionBtn {
                    label: "Next";
                    clicked => { Actions.load-duplicates(State.duplicates-sort, State.duplicates-descending, State.duplicates-page + 1); }
                }
            }
        }

        if State.duplicate-files.length > 0 : VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                IcBtn {
                    icon: @image-url("../../assets/icons/chevron-left.svg");
                    clicked => { Actions.close-duplicate-files(); }
                }
                Text {
                    text: State.duplicate-group-title;
                    color: Palette.text;
                    font-size: 16px;
                    font-weight: 750;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            TrackTable {
                vertical-stretch: 1;
                show-added: false;
                show-year: false;
                empty-text: "No duplicate files.";
            }
        }
    }
}
