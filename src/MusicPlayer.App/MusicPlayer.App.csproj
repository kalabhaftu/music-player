<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SatelliteResourceLanguages>en;en-US</SatelliteResourceLanguages>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MusicPlayer.ico</ApplicationIcon>
    <RootNamespace>MusicPlayer.App</RootNamespace>
    <AssemblyName>MusicPlayer</AssemblyName>
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x64|ARM64</AppxBundlePlatforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" />
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MusicPlayer.Core/MusicPlayer.Core.csproj" />
    <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="WebUI/**">
      <LogicalName>MusicPlayerWebUI/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../ThirdPartyNotices.md" Link="ThirdPartyNotices.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../third-party-licenses/**">
      <Link>ThirdPartyLicenses/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="RemoveLegacyLooseWebUI" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(OutDir)WebUI')">
    <RemoveDir Directories="$(OutDir)WebUI" />
  </Target>
  <Target Name="SignFirstPartyOutput" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(SignFirstParty)' == 'true'">
    <Exec Command="pwsh -NoLogo -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../packaging/windows/Sign-FirstPartyFiles.ps1&quot; -Directory &quot;$(TargetDir.Replace('\', '/'))&quot;" />
    <!-- MSIX gathers both the intermediate and output assembly. Keep their
         signed bytes identical so payload de-duplication selects one file. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="@(IntermediateAssembly)" />
  </Target>
</Project>
